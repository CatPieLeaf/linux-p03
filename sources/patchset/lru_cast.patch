diff --git a/mm/lru_cast/Makefile b/mm/lru_cast/Makefile
new file mode 100644
index 0000000000..c16ca14562
--- /dev/null
+++ b/mm/lru_cast/Makefile
@@ -0,0 +1,31 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# CAST. Reached from mm/Makefile via obj-$(CONFIG_LRU_CAST) += lru_cast/.
+# The rest of the kernel sees include/linux/lru_cast.h; everything here is
+# private. Host differences live in compat/ and nowhere else, so these files
+# are byte-identical on every kernel version.
+#
+# Components, each behind one header, each using only those below it
+# (check-layers.sh):
+#
+#	core/	core.h		state words, the eviction clock, keys, prefetch
+#		inl.h		its inline forms, for policy/'s hot loops
+#	policy/	policy.h	the main cache inside reclaim, its parameters
+#	walk/	walk.h		young bits of mapped pages
+#	tune/	tune.h		the controllers that set the parameters
+#	.	control.h	switching on and off, sysfs, and hooks.c --
+#				the only files that see every component
+
+ccflags-y += -I$(src) -I$(srctree)/mm
+
+obj-y	+= core/store.o core/state.o core/clock.o core/key.o core/prefetch.o
+obj-y	+= policy/params.o policy/ring.o policy/reclaim.o policy/ghost.o policy/balance.o
+obj-y	+= walk/walk.o walk/bloom.o walk/lookaround.o
+ifdef CONFIG_X86_64
+obj-y	+= walk/simd_x86.o walk/simd_x86_sse2.o walk/simd_x86_avx2.o walk/simd_x86_avx512.o
+else
+obj-y	+= walk/simd_generic.o
+endif
+obj-y	+= tune/tune.o tune/sim.o tune/world.o tune/sample.o tune/readahead.o
+obj-y	+= tune/evidence.o tune/decay.o tune/wshare.o tune/share.o tune/cost.o tune/protect.o
+obj-y	+= hooks.o control.o sysfs.o
diff --git a/mm/lru_cast/check-layers.sh b/mm/lru_cast/check-layers.sh
new file mode 100755
index 0000000000..81214251cd
--- /dev/null
+++ b/mm/lru_cast/check-layers.sh
@@ -0,0 +1,58 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+#
+# CAST: check that each component includes only what it may.
+#
+#	core/	nothing of CAST's but compat/
+#	policy/	core/core.h, core/inl.h (core's inline forms for its hot loops)
+#	walk/	core/core.h
+#	tune/	core/core.h, policy/policy.h
+#	.	every component's public header, nothing inside a component
+#
+# compat/ alone may reach the host's mm-private headers (../../).
+#
+# Inside its own directory a component includes what it likes. And the
+# main cache's operating point, read inline everywhere, is written by
+# policy/params.c alone: lru_cast_params is named there and in policy.h only.
+# Run from anywhere; prints each offence and exits 1 if there is one.
+
+cd "$(dirname "$0")" || exit 2
+public="core/core.h policy/policy.h walk/walk.h tune/tune.h control.h version.h"
+bad=0
+
+allowed() {	# $1 the including file, $2 the included path
+	case "$2" in
+	compat/*|version.h) return 0 ;;
+	esac
+	case "$1" in
+	compat/*)	return 1 ;;
+	core/*)		deps="" ;;
+	policy/*)	deps="core/core.h core/inl.h" ;;
+	walk/*)		deps="core/core.h" ;;
+	tune/*)		deps="core/core.h policy/policy.h" ;;
+	*)		deps="$public" ;;
+	esac
+	dir=${1%/*}
+	[ "$dir" != "$1" ] && [ "${2%/*}" = "$dir" ] && return 0
+	for d in $deps; do
+		[ "$2" = "$d" ] && return 0
+	done
+	return 1
+}
+
+for f in $(find . -name '*.[chS]' | sed 's|^\./||' | sort); do
+	for inc in $(sed -n 's/^#include "\([^"]*\)".*/\1/p' "$f"); do
+		case "$f" in compat/*) case "$inc" in ../../*) continue ;; esac ;; esac
+		if ! allowed "$f" "$inc"; then
+			echo "$f: #include \"$inc\""
+			bad=1
+		fi
+	done
+done
+for f in $(grep -rl --include='*.[chS]' -w lru_cast_params . | sed 's|^\./||' | sort); do
+	case "$f" in
+	policy/params.c|policy/policy.h) ;;
+	*)	grep -n -w lru_cast_params "$f" | sed "s|^|$f:|"; bad=1 ;;
+	esac
+done
+exit $bad
diff --git a/mm/lru_cast/compat/caps.h b/mm/lru_cast/compat/caps.h
new file mode 100644
index 0000000000..4ec4b82f2b
--- /dev/null
+++ b/mm/lru_cast/compat/caps.h
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST's view of the host kernel, as capabilities.
+ *
+ * This is the only file in mm/lru_cast/ that asks which kernel version it
+ * is built for. Everything else asks for a capability by name, so a host
+ * difference is described once, here, in terms of what changed, and the
+ * adapters in compat/kernel.h pick the matching body. That keeps the rest of
+ * mm/lru_cast/ byte-identical on every kernel.
+ *
+ * Each capability is 0 or 1. Add one only when an adapter needs it, and say
+ * in its comment what differs.
+ */
+#ifndef _MM_LRU_CAST_COMPAT_CAPS_H
+#define _MM_LRU_CAST_COMPAT_CAPS_H
+
+#include <linux/version.h>
+
+/* vmap_pages_range_noflush() takes the gfp mask of its page-table allocations last (7.0). */
+#define LRU_CAST_CAP_VMAP_PAGES_GFP		(LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0))
+
+/* page->flags is a memdesc_flags_t, its word in .f (6.18). */
+#define LRU_CAST_CAP_MEMDESC_FLAGS		(LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0))
+
+/*
+ * An LRU folio's memcg_data points to its obj_cgroup, not its mem_cgroup,
+ * and a memcg taken offline hands its LRU folios to its parent's lruvec
+ * by splicing its lists, lru_reparent_memcg() (7.1).
+ */
+#define LRU_CAST_CAP_OBJCG_LRU			(LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+
+/*
+ * system_dfl_wq is the unbound system workqueue (6.18); system_unbound_wq,
+ * its old name, is warned of as deprecated from 7.2.
+ */
+#define LRU_CAST_CAP_SYSTEM_DFL_WQ		(LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0))
+
+/* lazy_mmu_mode_enable()/disable() replace arch_enter/leave_lazy_mmu_mode() (7.0). */
+#define LRU_CAST_CAP_LAZY_MMU_MODE_ENABLE	(LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0))
+
+/*
+ * ptep_clear_young_notify() and pmdp_clear_young_notify() are gone; their
+ * like are test_and_clear_young_ptes_notify() and
+ * pmdp_test_and_clear_young_notify() in mm/internal.h (7.1).
+ */
+#define LRU_CAST_CAP_YOUNG_NOTIFY_INTERNAL	(LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+
+/* unlock_page_lruvec_irq() is lruvec_unlock_irq() (7.1). */
+#define LRU_CAST_CAP_LRUVEC_UNLOCK		(LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+
+/*
+ * A swap slot's count and zero flag sit in the top SWAP_COUNT_SHIFT bits of
+ * the swap table word that holds an anon shadow (mm/swap_table.h, 7.1).
+ */
+#define LRU_CAST_CAP_SWAP_TB_FLAGS		(LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+
+/* workingset_age_nonresident() is declared in mm/internal.h, not linux/swap.h (7.3). */
+#define LRU_CAST_CAP_AGE_NONRESIDENT_INTERNAL	(LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+
+/*
+ * The anon/file scan balance reads its costs from the PGROTATE and
+ * WORKINGSET_RESTORE counters: lru_note_cost_refault() is gone (7.3).
+ */
+#define LRU_CAST_CAP_LRU_COST_FROM_STATS	(LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+
+/* vm_swappiness is declared in mm/swap.h, not linux/swap.h (7.3). */
+#define LRU_CAST_CAP_SWAPPINESS_IN_SWAP_H	(LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+
+/* vmap_pages_range_noflush() is declared in mm/vmalloc.h, not mm/internal.h (7.3). */
+#define LRU_CAST_CAP_VMAP_API_IN_VMALLOC_H	(LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0))
+
+#endif /* _MM_LRU_CAST_COMPAT_CAPS_H */
diff --git a/mm/lru_cast/compat/kernel.h b/mm/lru_cast/compat/kernel.h
new file mode 100644
index 0000000000..1445fceeae
--- /dev/null
+++ b/mm/lru_cast/compat/kernel.h
@@ -0,0 +1,213 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * The host kernel's API, as mm/lru_cast/ uses it. Each adapter picks its
+ * body by a capability from caps.h; the callers never see a version.
+ */
+#ifndef _MM_LRU_CAST_COMPAT_KERNEL_H
+#define _MM_LRU_CAST_COMPAT_KERNEL_H
+
+#include <linux/mm.h>
+#include <linux/mm_inline.h>
+#include <linux/memcontrol.h>
+#include <linux/swap.h>
+#include <linux/mmu_notifier.h>
+#include <linux/sched/sysctl.h>
+#include <linux/workqueue.h>
+#include "compat/caps.h"
+#if LRU_CAST_CAP_AGE_NONRESIDENT_INTERNAL || LRU_CAST_CAP_YOUNG_NOTIFY_INTERNAL
+#include "../../internal.h"
+#endif
+#if LRU_CAST_CAP_SWAPPINESS_IN_SWAP_H
+#include "../../swap.h"
+#endif
+#if LRU_CAST_CAP_SWAP_TB_FLAGS
+#include "../../swap_table.h"
+#endif
+
+/* the top bits of an anon shadow's xarray value, the swap table's own */
+#if LRU_CAST_CAP_SWAP_TB_FLAGS
+#define LRU_CAST_SHADOW_ANON_RESERVED	SWAP_COUNT_SHIFT
+#else
+#define LRU_CAST_SHADOW_ANON_RESERVED	0
+#endif
+
+/* the lruvec's per-list, per-zone page counts */
+static inline void lru_cast_update_lru_size(struct lruvec *lruvec, enum lru_list lru,
+					 int zid, long nr_pages)
+{
+	update_lru_size(lruvec, lru, zid, nr_pages);
+}
+
+/* the pages on one of the lruvec's lists, every zone's (vmscan.c's lruvec_lru_size()) */
+static inline unsigned long lru_cast_lru_size(struct lruvec *lruvec, enum lru_list lru)
+{
+	unsigned long size = 0;
+	int zid;
+
+	for (zid = 0; zid < MAX_NR_ZONES; zid++) {
+		struct zone *zone = &lruvec_pgdat(lruvec)->node_zones[zid];
+
+		if (!managed_zone(zone))
+			continue;
+		if (!mem_cgroup_disabled())
+			size += mem_cgroup_get_zone_lru_size(lruvec, lru, zid);
+		else
+			size += zone_page_state(zone, NR_ZONE_LRU_BASE + lru);
+	}
+	return size;
+}
+
+/* @page's flags, read without a lock */
+static inline unsigned long lru_cast_page_flags(struct page *page)
+{
+#if LRU_CAST_CAP_MEMDESC_FLAGS
+	return READ_ONCE(page->flags.f);
+#else
+	return READ_ONCE(page->flags);
+#endif
+}
+
+/*
+ * Is @page, the head of a folio on an LRU, charged to @memcg, as its
+ * memcg_data says? Read without a lock, as the page may be freed and
+ * used again meanwhile: the answer is a hint the caller confirms.
+ */
+static inline bool lru_cast_page_memcg_is(struct page *page, struct mem_cgroup *memcg)
+{
+#if LRU_CAST_CAP_OBJCG_LRU
+	unsigned long data = READ_ONCE(page->memcg_data);
+	struct obj_cgroup *objcg;
+	bool is;
+
+	if (!data)
+		return !memcg;
+	if (data & (__NR_MEMCG_DATA_FLAGS - 1))	/* a slab's, or charged kernel memory */
+		return false;
+	objcg = (struct obj_cgroup *)data;
+	rcu_read_lock();			/* an objcg is freed after a grace period */
+	is = READ_ONCE(objcg->memcg) == memcg;
+	rcu_read_unlock();
+	return is;
+#else
+	return READ_ONCE(page->memcg_data) == (unsigned long)memcg;
+#endif
+}
+
+/* the lruvec folio_lruvec_lock_irq() locked, unlocked */
+static inline void lru_cast_lruvec_unlock_irq(struct lruvec *lruvec)
+{
+#if LRU_CAST_CAP_LRUVEC_UNLOCK
+	lruvec_unlock_irq(lruvec);
+#else
+	unlock_page_lruvec_irq(lruvec);
+#endif
+}
+
+/* a refault of a folio that had been in use: the scan balance's cost, as legacy reclaim counts it */
+static inline void lru_cast_note_refault_cost(struct folio *folio)
+{
+#if !LRU_CAST_CAP_LRU_COST_FROM_STATS
+	lru_note_cost_refault(folio);
+#endif
+}
+
+/* @pte's young bit taken, and a secondary MMU's of its page; was either set */
+static inline bool lru_cast_ptep_clear_young(struct vm_area_struct *vma, unsigned long addr,
+					     pte_t *pte)
+{
+#if LRU_CAST_CAP_YOUNG_NOTIFY_INTERNAL
+	return test_and_clear_young_ptes_notify(vma, addr, pte, 1);
+#else
+	return ptep_clear_young_notify(vma, addr, pte);
+#endif
+}
+
+/* ... the same of a PMD mapping a THP */
+static inline bool lru_cast_pmdp_clear_young(struct vm_area_struct *vma, unsigned long addr,
+					     pmd_t *pmd)
+{
+#if LRU_CAST_CAP_YOUNG_NOTIFY_INTERNAL
+	return pmdp_test_and_clear_young_notify(vma, addr, pmd);
+#else
+	return pmdp_clear_young_notify(vma, addr, pmd);
+#endif
+}
+
+/* PTE updates batched until left, where the architecture can */
+static inline void lru_cast_lazy_mmu_enter(void)
+{
+#if LRU_CAST_CAP_LAZY_MMU_MODE_ENABLE
+	lazy_mmu_mode_enable();
+#else
+	arch_enter_lazy_mmu_mode();
+#endif
+}
+
+static inline void lru_cast_lazy_mmu_leave(void)
+{
+#if LRU_CAST_CAP_LAZY_MMU_MODE_ENABLE
+	lazy_mmu_mode_disable();
+#else
+	arch_leave_lazy_mmu_mode();
+#endif
+}
+
+/* @work queued on the unbound system workqueue */
+static inline bool lru_cast_queue_work(struct work_struct *work)
+{
+#if LRU_CAST_CAP_SYSTEM_DFL_WQ
+	return queue_work(system_dfl_wq, work);
+#else
+	return queue_work(system_unbound_wq, work);
+#endif
+}
+
+/* @dwork run on the unbound system workqueue in @delay jiffies, or sooner if it was to */
+static inline bool lru_cast_queue_delayed_work(struct delayed_work *dwork, unsigned long delay)
+{
+#if LRU_CAST_CAP_SYSTEM_DFL_WQ
+	return queue_delayed_work(system_dfl_wq, dwork, delay);
+#else
+	return queue_delayed_work(system_unbound_wq, dwork, delay);
+#endif
+}
+
+/* ... in @delay jiffies, whenever it was to */
+static inline bool lru_cast_mod_delayed_work(struct delayed_work *dwork, unsigned long delay)
+{
+#if LRU_CAST_CAP_SYSTEM_DFL_WQ
+	return mod_delayed_work(system_dfl_wq, dwork, delay);
+#else
+	return mod_delayed_work(system_unbound_wq, dwork, delay);
+#endif
+}
+
+/* the clock refault distances are read on: pages that left the inactive list */
+static inline void lru_cast_age_nonresident(struct lruvec *lruvec, unsigned long nr_pages)
+{
+	workingset_age_nonresident(lruvec, nr_pages);
+}
+
+/*
+ * Protection faults on sampled pages use the NUMA hinting PTE (PROT_NONE in
+ * an accessible VMA), so they need NUMA balancing built in, and may be
+ * used only while it is off: then every hinting fault is CAST's.
+ */
+static inline bool lru_cast_numa_hinting_free(void)
+{
+#ifdef CONFIG_NUMA_BALANCING
+	return READ_ONCE(sysctl_numa_balancing_mode) == NUMA_BALANCING_DISABLED;
+#else
+	return false;
+#endif
+}
+
+/* the range of PTEs of one mapping a protection change is about to touch */
+static inline void lru_cast_mmu_range_init(struct mmu_notifier_range *range,
+					struct mm_struct *mm,
+					unsigned long start, unsigned long end)
+{
+	mmu_notifier_range_init(range, MMU_NOTIFY_PROTECTION_PAGE, 0, mm, start, end);
+}
+
+#endif /* _MM_LRU_CAST_COMPAT_KERNEL_H */
diff --git a/mm/lru_cast/compat/vmap.h b/mm/lru_cast/compat/vmap.h
new file mode 100644
index 0000000000..ba34ea86e4
--- /dev/null
+++ b/mm/lru_cast/compat/vmap.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Mapping pages into a reserved range, as the state array's sections are
+ * attached (store.c). mm-private API, so this is included by store.c alone.
+ */
+#ifndef _MM_LRU_CAST_COMPAT_VMAP_H
+#define _MM_LRU_CAST_COMPAT_VMAP_H
+
+#include <linux/vmalloc.h>
+#include "compat/caps.h"
+#include "../../internal.h"
+#if LRU_CAST_CAP_VMAP_API_IN_VMALLOC_H
+#include "../../vmalloc.h"
+#endif
+
+static inline int lru_cast_vmap_pages(unsigned long addr, unsigned long end,
+				   struct page **pages)
+{
+#if LRU_CAST_CAP_VMAP_PAGES_GFP
+	return vmap_pages_range_noflush(addr, end, PAGE_KERNEL, pages, PAGE_SHIFT,
+					GFP_KERNEL);
+#else
+	return vmap_pages_range_noflush(addr, end, PAGE_KERNEL, pages, PAGE_SHIFT);
+#endif
+}
+
+#endif /* _MM_LRU_CAST_COMPAT_VMAP_H */
diff --git a/mm/lru_cast/control.c b/mm/lru_cast/control.c
new file mode 100644
index 0000000000..5c72a04d1a
--- /dev/null
+++ b/mm/lru_cast/control.c
@@ -0,0 +1,209 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- switching it on and off.
+ *
+ * CAST runs per lruvec: lruvec->lru_cast_on, read under the lru_lock by the
+ * add hook and by reclaim, says whether the lruvec's active folios are M
+ * (on) or legacy reclaim's active list (off); they are on the active list
+ * either way. Switching on walks every lruvec and gives each active folio
+ * with no reads recorded one, in batches, dropping the lock between them;
+ * the flag flips when that is done (on) or first thing (off). The static
+ * key lru_cast_enabled_key covers the hooks that have no lruvec at hand
+ * (reads, frees, migration).
+ *
+ * Boot: lru_cast=0 starts with CAST off, and the state words are not set
+ * up until it is first switched on. At run time:
+ * /sys/kernel/mm/lru_cast/enabled. While it is off the state words go
+ * stale (nothing resets them at free); they are all cleared before it comes
+ * back on, and with them goes all it had learnt: the shadows it left
+ * (lru_cast_ghosts_forget()) and the controllers (lru_cast_tune_init()).
+ *
+ * CAST and MGLRU both run on the lists legacy reclaim leaves: one is
+ * switched off to them before the other is switched on from them, and
+ * never are both on. Either's switch is made under lru_cast_switch_lock
+ * (MGLRU's, lru_gen_change_state(), takes it before its own locks), and
+ * neither comes on while the other is: -EBUSY.
+ */
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/mm_inline.h>
+#include <linux/mutex.h>
+#include "control.h"
+#include "core/core.h"
+#include "policy/policy.h"
+#include "tune/tune.h"
+#include "version.h"
+
+DEFINE_STATIC_KEY_TRUE(lru_cast_enabled_key);
+
+/* what a new lruvec starts with */
+static bool lru_cast_active __read_mostly = true;
+static DEFINE_MUTEX(lru_cast_switch_lock);
+
+#define LRU_CAST_BATCH	1024
+
+static int __init lru_cast_setup(char *str)
+{
+	int v;
+
+	if (str && !kstrtoint(str, 0, &v))
+		lru_cast_active = v;
+	return 0;
+}
+early_param("lru_cast", lru_cast_setup);
+
+void lru_cast_init_lruvec(struct lruvec *lruvec)
+{
+	lru_cast_ring_init(lruvec);
+	lru_cast_ring_reset(lruvec);
+	lruvec->lru_cast_on = lru_cast_active;
+}
+
+/* an lruvec freed (its memcg's): no folio is left on it */
+void lru_cast_exit_lruvec(struct lruvec *lruvec)
+{
+	lru_cast_ring_exit(lruvec);
+}
+
+/* CAST runs @folio's lruvec; the folio locked or isolated, so its memcg held */
+bool lru_cast_folio_on(struct folio *folio)
+{
+	bool on;
+
+	rcu_read_lock();
+	on = lru_cast_on(folio_lruvec(folio));
+	rcu_read_unlock();
+	return on;
+}
+
+/* @child's folios spliced onto @parent's lists, both lru_locks held */
+void lru_cast_reparent(struct lruvec *child, struct lruvec *parent)
+{
+	lru_cast_ring_reparent(child, parent);
+}
+
+/*
+ * The active list is M as it is; a folio with no reads recorded is given
+ * one. The list is gone through off to the side, so that the lock can be
+ * let go: a folio leaving meanwhile leaves that list as it would this one.
+ */
+static void lru_cast_fill(struct lruvec *lruvec)
+{
+	int type;
+
+	spin_lock_irq(&lruvec->lru_lock);
+	for (type = 0; type < ANON_AND_FILE; type++) {
+		struct list_head *list = &lruvec->lists[LRU_ACTIVE_ANON + type * LRU_FILE];
+		LIST_HEAD(todo);
+		int n = 0;
+
+		list_splice_init(list, &todo);
+		while (!list_empty(&todo)) {
+			struct folio *folio = lru_to_folio(&todo);
+
+			list_del(&folio->lru);
+			if (!(lru_cast_read(folio) >> 24))
+				lru_cast_access(folio);
+			lru_cast_ring_put(lruvec, folio, type);
+			if (++n % LRU_CAST_BATCH == 0) {
+				spin_unlock_irq(&lruvec->lru_lock);
+				cond_resched();
+				spin_lock_irq(&lruvec->lru_lock);
+			}
+		}
+	}
+	WRITE_ONCE(lruvec->lru_cast_on, true);
+	spin_unlock_irq(&lruvec->lru_lock);
+}
+
+/* M is the active list already */
+static void lru_cast_drain(struct lruvec *lruvec)
+{
+	spin_lock_irq(&lruvec->lru_lock);
+	WRITE_ONCE(lruvec->lru_cast_on, false);
+	lru_cast_ring_reset(lruvec);
+	spin_unlock_irq(&lruvec->lru_lock);
+}
+
+static void lru_cast_walk(void (*fn)(struct lruvec *lruvec))
+{
+	struct mem_cgroup *memcg = mem_cgroup_iter(NULL, NULL, NULL);
+
+	do {
+		int nid;
+
+		for_each_node_state(nid, N_MEMORY)
+			fn(mem_cgroup_lruvec(memcg, NODE_DATA(nid)));
+		cond_resched();
+	} while ((memcg = mem_cgroup_iter(NULL, memcg, NULL)));
+}
+
+int lru_cast_set_enabled(bool on)
+{
+	int err = 0;
+
+	mutex_lock(&lru_cast_switch_lock);
+	if (on != READ_ONCE(lru_cast_active)) {
+		if (on && lru_gen_enabled()) {
+			err = -EBUSY;
+			goto out;
+		}
+		if (on) {
+			/* all it needs, or it stays off and says so */
+			err = lru_cast_store_init();
+			if (!err)
+				err = lru_cast_tune_init();
+			if (err) {
+				pr_warn(LRU_CAST_PROGNAME ": no memory to run on, still off\n");
+				goto out;
+			}
+			lru_cast_clear_states();
+			lru_cast_ghosts_forget();
+			WRITE_ONCE(lru_cast_active, true);
+			static_branch_enable(&lru_cast_enabled_key);
+			lru_add_drain_all();
+			lru_cast_walk(lru_cast_fill);
+		} else {
+			WRITE_ONCE(lru_cast_active, false);
+			lru_add_drain_all();
+			lru_cast_walk(lru_cast_drain);
+			static_branch_disable(&lru_cast_enabled_key);
+		}
+		pr_info(LRU_CAST_PROGNAME ": %s\n", on ? "enabled" : "disabled");
+	}
+out:
+	mutex_unlock(&lru_cast_switch_lock);
+	return err;
+}
+
+bool lru_cast_is_enabled(void)
+{
+	return READ_ONCE(lru_cast_active);
+}
+
+/* MGLRU's switch: CAST stays as it is while it is made */
+void lru_cast_switch_begin(void)
+{
+	mutex_lock(&lru_cast_switch_lock);
+}
+
+void lru_cast_switch_end(void)
+{
+	mutex_unlock(&lru_cast_switch_lock);
+}
+
+static int __init lru_cast_init(void)
+{
+	lru_cast_key_init();
+	lru_cast_prefetch_init();
+	if (lru_cast_active && (lru_cast_store_init() || lru_cast_tune_init())) {
+		pr_warn(LRU_CAST_PROGNAME ": no memory to run on, off\n");
+		lru_cast_set_enabled(false);
+	}
+	if (!lru_cast_active)
+		static_branch_disable(&lru_cast_enabled_key);
+	pr_info(LRU_CAST_PROGNAME " v" LRU_CAST_VERSION " by " LRU_CAST_AUTHOR "\n");
+	pr_info(LRU_CAST_PROGNAME ": currently %s\n", lru_cast_active ? "enabled" : "disabled");
+	return lru_cast_sysfs_init();
+}
+subsys_initcall(lru_cast_init);
diff --git a/mm/lru_cast/control.h b/mm/lru_cast/control.h
new file mode 100644
index 0000000000..c9c67ed18a
--- /dev/null
+++ b/mm/lru_cast/control.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST -- switching it on and off (control.c), and its sysfs
+ * directory (sysfs.c). The composition root: these two, with hooks.c, are
+ * the only files that see every component.
+ */
+#ifndef _MM_LRU_CAST_CONTROL_H
+#define _MM_LRU_CAST_CONTROL_H
+
+#include <linux/types.h>
+
+int lru_cast_set_enabled(bool on);
+int lru_cast_sysfs_init(void);
+
+#endif /* _MM_LRU_CAST_CONTROL_H */
diff --git a/mm/lru_cast/core/clock.c b/mm/lru_cast/core/clock.c
new file mode 100644
index 0000000000..777830bb5a
--- /dev/null
+++ b/mm/lru_cast/core/clock.c
@@ -0,0 +1,224 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the clock.
+ *
+ * Time is how much has pressed into a node's memory: the clock counts the
+ * pages the node takes in -- a folio new to the cache, or one brought back
+ * with its history (policy/ghost.c) -- less those that leave it of
+ * themselves, freed by their owners; it ticks every C/4 of them, C what
+ * the node's LRUs can hold, their pages and the free. A state word stamps
+ * its reads with ticks (core/state.c), and keys decay by them (core/key.c).
+ *
+ * What comes in either fills free memory or displaces what was there, and
+ * either way competes with it; what comes into the room a page left of
+ * itself displaces nobody, and a process freeing and taking memory again
+ * and again makes no time for the rest. So with memory full the clock is
+ * the eviction clock it was -- an evicted page, freed later, is counted
+ * back in when it is evicted. Unlike that, it runs while memory fills: a
+ * set in use from before and the pages streaming in after are read in
+ * different ticks by the time reclaim first has to choose between them.
+ * And it stands still while nothing comes in, so that nothing grows old,
+ * nor its reads many, while memory is quiet.
+ *
+ * Pages taken in and freed are counted per CPU and added to the node's
+ * count a batch at a time. Whoever paces itself by the clock (the walker,
+ * re-protection) is told of each batch by lru_cast_hook_installed(); the clock
+ * does not know who. At each tick a part of the node's state words is
+ * looked over, and those read last long ago are marked stale (core.h).
+ */
+#include <linux/ktime.h>
+#include <linux/memory_hotplug.h>
+#include <linux/percpu.h>
+#include <linux/swap.h>
+#include <linux/sysfs.h>
+#include "core/core.h"
+
+#define LRU_CAST_INSTALL_BATCH	64
+
+/* every node's ticks, summed: the controllers' clock */
+static atomic_long_t lru_cast_ticks;
+
+/* words marked stale, and the time it took */
+static atomic_long_t lru_cast_stale_marked;
+static atomic64_t lru_cast_stale_ns;
+
+static void lru_cast_stale_workfn(struct work_struct *work);
+static DECLARE_WORK(lru_cast_stale_work, lru_cast_stale_workfn);
+
+/* a CPU's pages taken in less those freed, not yet added to their node's count */
+struct lru_cast_pending {
+	int nid;
+	long nr;
+};
+static DEFINE_PER_CPU(struct lru_cast_pending, lru_cast_pending) = { NUMA_NO_NODE, 0 };
+
+/* what the node's LRUs can hold: their pages, and the free they may take */
+static unsigned long lru_cast_capacity(struct pglist_data *pgdat)
+{
+	return node_page_state(pgdat, NR_INACTIVE_ANON) + node_page_state(pgdat, NR_ACTIVE_ANON) +
+	       node_page_state(pgdat, NR_INACTIVE_FILE) + node_page_state(pgdat, NR_ACTIVE_FILE) +
+	       sum_zone_node_page_state(pgdat->node_id, NR_FREE_PAGES);
+}
+
+/* @nr pages into node @nid, net: the count, and the tick when it is due */
+static void lru_cast_clock_add(int nid, long nr)
+{
+	struct pglist_data *pgdat = NODE_DATA(nid);
+	struct lru_cast_clock *c = &pgdat->lru_cast_clock;
+	unsigned long size = lru_cast_capacity(pgdat);
+	long installed = atomic_long_add_return(nr, &c->installed);
+	unsigned long next = READ_ONCE(c->next);
+
+	lru_cast_hook_installed(nr, size);
+	if (installed >= (long)next &&
+	    try_cmpxchg(&c->next, &next, installed + max(size / 4, 1UL))) {
+		int type;
+
+		for (type = 0; type < ANON_AND_FILE; type++) {
+			data_race(c->shadowed[type] -= c->shadowed[type] / 4);
+			data_race(c->returned[type] -= c->returned[type] / 4);
+		}
+		WRITE_ONCE(c->tick, c->tick + 1);
+		atomic_long_inc(&lru_cast_ticks);
+		lru_cast_queue_work(&lru_cast_stale_work);
+	}
+}
+
+/*
+ * Each node's words, a part at each tick, marked stale or deep where their
+ * last read is old (core.h): 1/LRU_CAST_STALE_PASS of the node's PFNs for
+ * each tick it has gone on since, all of them at most, so that a word is
+ * read once in LRU_CAST_STALE_PASS ticks, a tick more for the part left at
+ * the end. Marked from LRU_CAST_STALE_AGE ticks on, it is marked well
+ * before its read is 256 ticks old; deep, before its unit wraps.
+ */
+static void lru_cast_stale_workfn(struct work_struct *work)
+{
+	u64 t0 = ktime_get_ns();
+	int nid;
+
+	BUILD_BUG_ON(LRU_CAST_STALE_UNIT <= LRU_CAST_STALE_PASS + 1);	/* a word seen in each unit */
+	if (!lru_cast_enabled())
+		return;
+	get_online_mems();
+	for_each_node_state(nid, N_MEMORY) {
+		struct pglist_data *pgdat = NODE_DATA(nid);
+		struct lru_cast_clock *c = &pgdat->lru_cast_clock;
+		unsigned long tick = READ_ONCE(c->tick);
+		unsigned long start = pgdat->node_start_pfn, end = pgdat_end_pfn(pgdat);
+		unsigned long part = DIV_ROUND_UP(end - start, LRU_CAST_STALE_PASS);
+		unsigned long n = min(tick - c->stale_tick, (unsigned long)LRU_CAST_STALE_PASS);
+
+		c->stale_tick = tick;
+		if (c->stale_pfn < start || c->stale_pfn >= end)
+			c->stale_pfn = start;
+		while (n--) {
+			unsigned long stop = min(end, c->stale_pfn + part);
+
+			atomic_long_add(lru_cast_mark_stale(c->stale_pfn, stop, tick),
+					&lru_cast_stale_marked);
+			c->stale_pfn = stop < end ? stop : start;
+		}
+	}
+	put_online_mems();
+	atomic64_add(ktime_get_ns() - t0, &lru_cast_stale_ns);
+}
+
+/* @nr pages into node @nid, net, on this CPU's account */
+static void lru_cast_clock_count(int nid, long nr)
+{
+	struct lru_cast_pending *p = get_cpu_ptr(&lru_cast_pending);
+
+	if (p->nid != nid) {
+		if (p->nr && p->nid != NUMA_NO_NODE)
+			lru_cast_clock_add(p->nid, p->nr);
+		p->nid = nid;
+		p->nr = 0;
+	}
+	p->nr += nr;
+	if (abs(p->nr) >= LRU_CAST_INSTALL_BATCH) {
+		lru_cast_clock_add(nid, p->nr);
+		p->nr = 0;
+	}
+	put_cpu_ptr(&lru_cast_pending);
+}
+
+/* @nr pages of @folio's node taken in */
+void lru_cast_installed(struct folio *folio, unsigned long nr)
+{
+	lru_cast_clock_count(folio_nid(folio), nr);
+}
+
+/* @nr pages the node had taken in freed */
+void lru_cast_released(int nid, unsigned long nr)
+{
+	lru_cast_clock_count(nid, -(long)nr);
+}
+
+/*
+ * @nr pages of @type evicted from @pgdat: they will be freed, and counted
+ * out then; counted back in now, an eviction is no page leaving of itself
+ */
+void lru_cast_evicted(struct pglist_data *pgdat, int type, unsigned long nr)
+{
+	/* racy across the node's lruvecs: an approximate count is all it is for */
+	data_race(pgdat->lru_cast_clock.evict += nr);
+	lru_cast_clock_count(pgdat->node_id, nr);
+}
+
+/* @nr pages of @type evicted from @pgdat with a shadow */
+void lru_cast_shadowed(struct pglist_data *pgdat, int type, unsigned long nr)
+{
+	data_race(pgdat->lru_cast_clock.shadowed[type] += nr);
+}
+
+/* @nr pages of @type faulted back into @pgdat within the ghosts' window */
+void lru_cast_returned(struct pglist_data *pgdat, int type, unsigned long nr)
+{
+	data_race(pgdat->lru_cast_clock.returned[type] += nr);
+}
+
+/*
+ * Too many of a type's pages isolated for a direct reclaimer to take
+ * more (lru_cast.h): of the pages in flight, those that will come back,
+ * the share r of evictions faulted back within the ghosts' window, would
+ * be more than a batch; an eighth of one for a caller that may do IO and
+ * FS, as upstream gives GFP_NOIO and GFP_NOFS callers eight times the
+ * room. Isolated * r > batch, without the division.
+ */
+bool lru_cast_too_many_isolated(struct pglist_data *pgdat, int type, unsigned long isolated,
+				bool io_fs)
+{
+	struct lru_cast_clock *c = &pgdat->lru_cast_clock;
+	unsigned long out = data_race(c->shadowed[type]);
+	unsigned long back = min(data_race(c->returned[type]), out);
+	unsigned long batch = io_fs ? SWAP_CLUSTER_MAX / 8 : SWAP_CLUSTER_MAX;
+
+	return isolated * back > batch * out;
+}
+
+unsigned long lru_cast_ticks_now(void)
+{
+	return atomic_long_read(&lru_cast_ticks);
+}
+
+int lru_cast_clock_show(char *buf)
+{
+	int nid, len = 0;
+
+	for_each_node_state(nid, N_MEMORY) {
+		struct pglist_data *pgdat = NODE_DATA(nid);
+
+		struct lru_cast_clock *c = &pgdat->lru_cast_clock;
+
+		len += sysfs_emit_at(buf, len, "node%d installed %ld evicted %lu tick %lu\n", nid,
+				     atomic_long_read(&c->installed), data_race(c->evict),
+				     READ_ONCE(c->tick));
+		len += sysfs_emit_at(buf, len, "node%d returned anon %lu/%lu file %lu/%lu\n", nid,
+				     data_race(c->returned[0]), data_race(c->shadowed[0]),
+				     data_race(c->returned[1]), data_race(c->shadowed[1]));
+	}
+	return len + sysfs_emit_at(buf, len, "stale marked %ld us %llu\n",
+				   atomic_long_read(&lru_cast_stale_marked),
+				   atomic64_read(&lru_cast_stale_ns) / 1000);
+}
diff --git a/mm/lru_cast/core/core.h b/mm/lru_cast/core/core.h
new file mode 100644
index 0000000000..bf2265e01d
--- /dev/null
+++ b/mm/lru_cast/core/core.h
@@ -0,0 +1,225 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST -- the core: what a folio's reads were, and when.
+ *
+ *   store.c  a 32-bit state word per page frame
+ *   state.c  the word of a folio: its reads, recorded lock-free
+ *   clock.c  the clock the reads are stamped with: pages taken in
+ *   key.c    the key a word ranks by, at a decay
+ *
+ * The core knows nothing of what uses it. It tells of a read and of
+ * pages taken in through the two hooks below, which the composition root
+ * (hooks.c) implements; everything else in mm/lru_cast/ is built on this
+ * header and depends on nothing beneath it.
+ */
+#ifndef _MM_LRU_CAST_CORE_H
+#define _MM_LRU_CAST_CORE_H
+
+#include <linux/lru_cast.h>
+#include "compat/kernel.h"
+#include "core/prefetch.h"
+
+/* store.c */
+int lru_cast_store_init(void);
+void lru_cast_clear_states(void);
+
+/*
+ * state.c: a folio's state word. Bits 0-7, the tick of its last read;
+ * 8-10 and 11-13, the gaps back to the two reads before, a code each
+ * (lru_cast_gap_code()); 14-23, its owner tag; 24-31, its read count. What
+ * lru_cast_read() and the rest give is the word without the tag: the history.
+ * A word not read for long is marked stale (below).
+ */
+#define LRU_CAST_W_GAP		8
+#define LRU_CAST_W_OWNER		14
+#define LRU_CAST_OWNER_BITS	10
+#define LRU_CAST_OWNER_MASK	(((1U << LRU_CAST_OWNER_BITS) - 1) << LRU_CAST_W_OWNER)
+#define LRU_CAST_W_BITS		BITS_PER_TYPE(u32)	/* as lru_cast_word() holds it */
+
+/*
+ * The history packed into its LRU_CAST_W_HISTORY_BITS low bits, the tag's
+ * bits taken out, as a shadow carries it (policy/ghost.c); and back.
+ */
+#define LRU_CAST_W_HISTORY_BITS	(LRU_CAST_W_BITS - LRU_CAST_OWNER_BITS)
+
+static inline u32 lru_cast_history_pack(u32 w)
+{
+	return (w & ((1U << LRU_CAST_W_OWNER) - 1)) |
+	       (w >> (LRU_CAST_W_OWNER + LRU_CAST_OWNER_BITS)) << LRU_CAST_W_OWNER;
+}
+
+static inline u32 lru_cast_history_unpack(unsigned long h)
+{
+	h &= (1UL << LRU_CAST_W_HISTORY_BITS) - 1;
+	return (h & ((1U << LRU_CAST_W_OWNER) - 1)) |
+	       (h >> LRU_CAST_W_OWNER) << (LRU_CAST_W_OWNER + LRU_CAST_OWNER_BITS);
+}
+
+/*
+ * A gap of @d ticks between two reads, in 3 bits: max(fls(d) - 1, 0), the
+ * gaps [0, 1], [2, 3], [4, 7] ... [128, 255]. The two older reads are known
+ * to within a factor of two of their gaps, the newest exactly.
+ */
+static inline u32 lru_cast_gap_code(u8 d)
+{
+	int c = fls(d);
+
+	return c > 1 ? c - 1 : 0;
+}
+
+/*
+ * The age of a word's last read. A tick is 8 bits and wraps: the tick now
+ * less the one stamped is the age while it is under 256 ticks, and a word
+ * not read for longer would show its read as recent again. So the age has
+ * more rules, kept here and nowhere else -- lru_cast_age() and
+ * lru_cast_stale_last() are the only readings of a word's tick,
+ * lru_cast_push() and lru_cast_mark() the only writings of it:
+ *
+ *	stale	a word read last LRU_CAST_STALE_AGE ticks ago or more is
+ *		marked stale (lru_cast_mark(); clock.c looks over a part of
+ *		the words at each tick, each in LRU_CAST_STALE_PASS ticks, so
+ *		that it is marked well before 256). Its tick is then the
+ *		read's, in units of LRU_CAST_STALE_UNIT ticks and modulo
+ *		LRU_CAST_STALE_UNITS: the read is taken at the start of its
+ *		unit, as old as it is and growing older, until it is read
+ *		again; its count stays, its gaps go (the reads are taken as
+ *		all at the last).
+ *	deep	a stale word whose read is LRU_CAST_STALE_DEEP units old is
+ *		marked deep, before its unit could wrap: its read is older
+ *		than any a word tells, and only its count is kept. At the
+ *		steepest decay and the weakest alike it is then past decaying
+ *		(some 32 half-lives at the weakest).
+ *
+ * The mark is the gap codes 0 and 7 -- the read before the last within a
+ * tick of it, the one before that 128 or more ticks earlier -- which
+ * lru_cast_push() does not make: it codes that gap 6. A deep word's tick
+ * is LRU_CAST_STALE_DEEP_TICK, which no unit is.
+ */
+#define LRU_CAST_STALE_AGE	192
+#define LRU_CAST_STALE_PASS	32
+#define LRU_CAST_STALE_SHIFT	6
+#define LRU_CAST_STALE_UNIT	(1UL << LRU_CAST_STALE_SHIFT)	/* > LRU_CAST_STALE_PASS + 1 */
+#define LRU_CAST_STALE_UNITS	255
+#define LRU_CAST_STALE_DEEP	(LRU_CAST_STALE_UNITS - 2)
+#define LRU_CAST_STALE_DEEP_TICK	0xffU
+#define LRU_CAST_W_GAPS		(0x3fU << LRU_CAST_W_GAP)
+#define LRU_CAST_W_STALE	(7U << (LRU_CAST_W_GAP + 3))
+
+/* @w is marked stale, or deep */
+static inline bool lru_cast_stale(u32 w)
+{
+	return (w >> 24) && (w & LRU_CAST_W_GAPS) == LRU_CAST_W_STALE;
+}
+
+/* @w is marked deep */
+static inline bool lru_cast_deep(u32 w)
+{
+	return lru_cast_stale(w) && (w & 0xffU) == LRU_CAST_STALE_DEEP_TICK;
+}
+
+/* the ticks since @w's last read, the clock at @tick, 255 for any more; @w read at least once */
+static inline u8 lru_cast_age(u32 w, unsigned long tick)
+{
+	return lru_cast_stale(w) ? 255 : (u8)(tick - (w & 0xffU));
+}
+
+/* the units since the unit stamped in a stale word that is not deep */
+static inline unsigned long lru_cast_stale_units(u32 w, unsigned long tick)
+{
+	return ((tick >> LRU_CAST_STALE_SHIFT) % LRU_CAST_STALE_UNITS + LRU_CAST_STALE_UNITS -
+		(w & 0xffU)) % LRU_CAST_STALE_UNITS;
+}
+
+/* the tick a stale word not deep takes its read at: the start of its unit */
+static inline unsigned long lru_cast_stale_last(u32 w, unsigned long tick)
+{
+	unsigned long unit = (tick >> LRU_CAST_STALE_SHIFT) - lru_cast_stale_units(w, tick);
+
+	return unit << LRU_CAST_STALE_SHIFT;
+}
+
+/* @w marked stale, or deep, if its last read is old enough to be; else 0 */
+static inline u32 lru_cast_mark(u32 w, unsigned long tick)
+{
+	u8 age;
+
+	if (!(w >> 24) || lru_cast_deep(w))
+		return 0;
+	if (lru_cast_stale(w))
+		return lru_cast_stale_units(w, tick) >= LRU_CAST_STALE_DEEP ?
+		       w | LRU_CAST_STALE_DEEP_TICK : 0;
+	age = lru_cast_age(w, tick);
+	if (age < LRU_CAST_STALE_AGE)
+		return 0;
+	return (w & ~(LRU_CAST_W_GAPS | 0xffU)) | LRU_CAST_W_STALE |
+	       ((tick - age) >> LRU_CAST_STALE_SHIFT) % LRU_CAST_STALE_UNITS;
+}
+
+/*
+ * @old with a read at tick @t pushed in, its count @n; the tag kept. The
+ * gap back to the read before is its age; to the one before that, the gap
+ * it had -- of a stale word, as far back as a gap goes.
+ */
+static inline u32 lru_cast_push(u32 old, u8 t, u32 n)
+{
+	u32 g1 = old >> 24 ? lru_cast_gap_code(lru_cast_age(old, t)) : 0;
+	u32 g2 = lru_cast_stale(old) ? 7 : (old >> LRU_CAST_W_GAP) & 7;
+
+	if (!g1 && g2 == 7)
+		g2 = 6;			/* not the stale mark */
+	return (old & LRU_CAST_OWNER_MASK) | n << 24 | g2 << (LRU_CAST_W_GAP + 3) |
+	       g1 << LRU_CAST_W_GAP | t;
+}
+
+u32 lru_cast_read(struct folio *folio);
+u32 lru_cast_read_pfn(unsigned long pfn);
+u32 lru_cast_set_owner(struct folio *folio, u32 owner);
+unsigned long lru_cast_find_owner(unsigned long pfn, unsigned long end, u32 owner, u32 *w);
+unsigned long lru_cast_find_owners(unsigned long pfn, unsigned long end,
+				   const unsigned long *lids, u32 *owner);
+void lru_cast_write(struct folio *folio, u32 w);
+unsigned long lru_cast_mark_stale(unsigned long pfn, unsigned long end, unsigned long tick);
+
+/* clock.c */
+void lru_cast_installed(struct folio *folio, unsigned long nr);
+void lru_cast_released(int nid, unsigned long nr);
+void lru_cast_shadowed(struct pglist_data *pgdat, int type, unsigned long nr);
+void lru_cast_returned(struct pglist_data *pgdat, int type, unsigned long nr);
+unsigned long lru_cast_ticks_now(void);		/* every node's ticks, summed */
+int lru_cast_clock_show(char *buf);
+
+/* the node's tick; both types run on it (@type is for the callers' sake) */
+static inline unsigned long lru_cast_tick(struct pglist_data *pgdat, int type)
+{
+	return READ_ONCE(pgdat->lru_cast_clock.tick);
+}
+
+/* key.c */
+/*
+ * The weakest decay, H = 128 C: never none. With none a key is the read
+ * count alone, with nothing of when: folios read 255 times or more tie,
+ * and a set read often once stays however long it is not. At le 1 a
+ * folio's reads still count for 8 half-lives of recency at most (log2 255),
+ * and among those read that often the last read decides.
+ */
+#define LRU_CAST_LE_MIN	1
+#define LRU_CAST_LE_MAX	14			/* the steepest decay */
+void lru_cast_key_init(void);
+long lru_cast_key_res(u32 w, unsigned long tick, int le, int res);
+
+/* quarter half-lives */
+static inline long lru_cast_key(u32 w, unsigned long tick, int le)
+{
+	return lru_cast_key_res(w, tick, le, 2);
+}
+long lru_cast_window_lo(unsigned long tick, int le);
+
+/* implemented above the core (hooks.c) */
+enum lru_cast_read {
+	LRU_CAST_READ,		/* seen as it happened: a fault, a read(), a mark */
+	LRU_CAST_READ_YOUNG,	/* known only by a young bit, found later */
+};
+void lru_cast_hook_read(struct folio *folio, enum lru_cast_read how);
+void lru_cast_hook_installed(long nr, unsigned long size);
+
+#endif /* _MM_LRU_CAST_CORE_H */
diff --git a/mm/lru_cast/core/inl.h b/mm/lru_cast/core/inl.h
new file mode 100644
index 0000000000..14b8c41302
--- /dev/null
+++ b/mm/lru_cast/core/inl.h
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST -- the inline forms of core's functions that policy/ calls in its
+ * hot loops, for a sweep reads every word of a block. The code is core's,
+ * and so are the tables and the array it reads: policy/ includes this
+ * header and never the ones inside core/ (store.h).
+ */
+#ifndef _MM_LRU_CAST_CORE_INL_H
+#define _MM_LRU_CAST_CORE_INL_H
+
+#include "core/core.h"
+
+/*
+ * The tables of lru_cast_key_res() (core/key.c), for its inline form below:
+ * a sweep calls it for every word it reads. The weights of a word's reads at
+ * each decay, its gap codes read as an index: [0] the newest's, 1, [1 + g1]
+ * the one before's, [9 + 8 g1 + g2] the one before that's.
+ */
+#define LRU_CAST_WTAB		(1 + 8 + 64)
+extern u32 lru_cast_wtab[LRU_CAST_LE_MAX + 1][LRU_CAST_WTAB];
+extern const u8 lru_cast_log2m[256];
+
+/* tau / H in Q16 half-lives per tick: 2^(le - 10) */
+static inline u64 lru_cast_dq(int le)
+{
+	return le ? 1ULL << (le + 6) : 0;
+}
+
+/* 256 log2(v / 2^16) */
+static __always_inline s64 lru_cast_log2q8(u64 v)
+{
+	int msb = fls64(v) - 1;
+	u32 m = (msb >= 8 ? v >> (msb - 8) : v << (8 - msb)) & 255;
+
+	return ((s64)msb - 16) * 256 + lru_cast_log2m[m];
+}
+
+/* the bucket of a state word: 2^-@res half-lives of the key, or n */
+static __always_inline long lru_cast_key_res_inl(u32 w, unsigned long tick, int le, int res)
+{
+	u32 n = w >> 24, g1 = (w >> LRU_CAST_W_GAP) & 7, g2 = (w >> (LRU_CAST_W_GAP + 3)) & 7;
+	u8 age0 = n ? lru_cast_age(w, tick) : 0;
+	unsigned long last = tick >= age0 ? tick - age0 : 0;
+	const u32 *t;
+	u64 s, wt;
+
+	if (!le)
+		return n;
+	if (!n)
+		return LONG_MIN;
+	/*
+	 * Stale (core.h), the reads all at the last, taken at the start of its
+	 * unit: as fixed as any other key. Deep, older than any: the count alone.
+	 */
+	if (lru_cast_stale(w)) {
+		s64 lift = lru_cast_log2q8((u64)n << 16);
+
+		if (lru_cast_deep(w))
+			return lift >> (8 - res);
+		last = lru_cast_stale_last(w, tick);
+		return ((s64)((last * lru_cast_dq(le)) >> 8) + lift) >> (8 - res);
+	}
+	/*
+	 * The key is the same taken at any time; taken at the last read, its
+	 * weight is 1 and the sum cannot underflow however long ago that was.
+	 * The reads before it are the middles of the gaps their codes allow
+	 * (lru_cast_gap2()), their weights looked up.
+	 */
+	/*
+	 * Read once, the weights are the newest's alone, 1 (65536): the log of
+	 * it is 0, and nothing needs looking up. Most words in a sweep are.
+	 */
+	if (n == 1)
+		return (s64)((last * lru_cast_dq(le)) >> 8) >> (8 - res);
+	t = lru_cast_wtab[min(le, LRU_CAST_LE_MAX)];
+	s = wt = t[0];
+	if (n >= 2) {
+		wt = t[1 + g1];
+		s += wt;
+	}
+	if (n >= 3) {
+		wt = t[9 + 8 * g1 + g2];
+		s += wt;
+	}
+	if (n > 3)
+		s += (u64)(n - 3) * wt;		/* older reads count at the oldest stamp */
+	return ((s64)((last * lru_cast_dq(le)) >> 8) + lru_cast_log2q8(s)) >> (8 - res);
+}
+
+#include "core/store.h"
+
+/*
+ * The first PFN in [@pfn, @end) whose owner tag is @owner, its state word
+ * in *@w; @end if there is none. A section without words is passed over.
+ */
+static __always_inline unsigned long lru_cast_find_owner_inl(unsigned long pfn, unsigned long end,
+							    u32 owner, u32 *w)
+{
+	owner <<= LRU_CAST_W_OWNER;
+	while (pfn < end) {
+		unsigned long sec_end = min(end, section_nr_to_pfn(pfn_to_section_nr(pfn) + 1));
+		u32 *p = lru_cast_word(pfn);
+
+		if (!p) {
+			pfn = sec_end;
+			continue;
+		}
+		for (; pfn < sec_end; pfn++, p++) {
+			u32 v = READ_ONCE(*p);
+
+			if ((v & LRU_CAST_OWNER_MASK) == owner) {
+				*w = v & ~LRU_CAST_OWNER_MASK;
+				return pfn;
+			}
+		}
+	}
+	return end;
+}
+
+#endif /* _MM_LRU_CAST_CORE_INL_H */
diff --git a/mm/lru_cast/core/key.c b/mm/lru_cast/core/key.c
new file mode 100644
index 0000000000..11490ff95c
--- /dev/null
+++ b/mm/lru_cast/core/key.c
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the key of a state word.
+ *
+ * The score of a folio is its read count decayed with a half-life of H
+ * pages taken in (core/clock.c), H = C * 2^(8 - le), le from LRU_CAST_LE_MIN
+ * (H = 128 C) to LRU_CAST_LE_MAX:
+ *
+ *   s = sum_j 2^-(age_j / H) + max(n - 3, 0) * 2^-(age_oldest / H)
+ *
+ * over the last three reads, the newest's age exact, the two before it
+ * each a gap back known to within a factor of two (core/core.h) and taken
+ * at its middle.
+ *
+ * It factors as 2^(-E/H) * K, E the clock, so the order of two folios not
+ * read does not change as E grows: it is the order of the key
+ *
+ *   key = E/H + log2 s   (half-lives),
+ *
+ * which changes only when the folio is read. Keys are counted in buckets of
+ * 2^-res half-lives: the main cache's sweep (policy/ring.c) in sixteenths,
+ * the controllers' simulated caches (tune/) in quarters, in a ring of
+ * LRU_CAST_BUCKETS of them anchored at now: [top - 255, top], top = 4 E/H
+ * + 32 (a folio read just now has log2 s < 8). With no decay (le = 0,
+ * which the policy no longer runs at: core/core.h) the key is the read
+ * count.
+ *
+ * Pure arithmetic on a state word and a clock.
+ */
+#include "core/core.h"
+#include "core/inl.h"
+
+/* 2^(-f/256), Q16 */
+static const u32 lru_cast_exp2n[256] = {
+	65536, 65359, 65182, 65006, 64830, 64655, 64480, 64306,
+	64132, 63958, 63785, 63613, 63441, 63269, 63098, 62928,
+	62757, 62588, 62419, 62250, 62081, 61914, 61746, 61579,
+	61413, 61247, 61081, 60916, 60751, 60587, 60423, 60260,
+	60097, 59934, 59772, 59611, 59449, 59289, 59128, 58968,
+	58809, 58650, 58491, 58333, 58176, 58018, 57861, 57705,
+	57549, 57393, 57238, 57083, 56929, 56775, 56622, 56468,
+	56316, 56163, 56012, 55860, 55709, 55558, 55408, 55258,
+	55109, 54960, 54811, 54663, 54515, 54368, 54221, 54074,
+	53928, 53782, 53637, 53492, 53347, 53203, 53059, 52916,
+	52773, 52630, 52488, 52346, 52204, 52063, 51922, 51782,
+	51642, 51502, 51363, 51224, 51085, 50947, 50810, 50672,
+	50535, 50399, 50262, 50126, 49991, 49856, 49721, 49586,
+	49452, 49319, 49185, 49052, 48920, 48787, 48655, 48524,
+	48393, 48262, 48131, 48001, 47871, 47742, 47613, 47484,
+	47356, 47228, 47100, 46973, 46846, 46719, 46593, 46467,
+	46341, 46216, 46091, 45966, 45842, 45718, 45594, 45471,
+	45348, 45225, 45103, 44981, 44859, 44738, 44617, 44497,
+	44376, 44256, 44137, 44017, 43898, 43780, 43661, 43543,
+	43425, 43308, 43191, 43074, 42958, 42841, 42726, 42610,
+	42495, 42380, 42265, 42151, 42037, 41923, 41810, 41697,
+	41584, 41472, 41360, 41248, 41136, 41025, 40914, 40804,
+	40693, 40583, 40473, 40364, 40255, 40146, 40037, 39929,
+	39821, 39714, 39606, 39499, 39392, 39286, 39180, 39074,
+	38968, 38863, 38757, 38653, 38548, 38444, 38340, 38236,
+	38133, 38030, 37927, 37824, 37722, 37620, 37518, 37417,
+	37316, 37215, 37114, 37014, 36914, 36814, 36715, 36615,
+	36516, 36417, 36319, 36221, 36123, 36025, 35928, 35831,
+	35734, 35637, 35541, 35445, 35349, 35253, 35158, 35063,
+	34968, 34874, 34779, 34685, 34591, 34498, 34405, 34312,
+	34219, 34126, 34034, 33942, 33850, 33759, 33667, 33576,
+	33486, 33395, 33305, 33215, 33125, 33035, 32946, 32857,
+};
+
+/* 256 * log2(1 + m/256) */
+const u8 lru_cast_log2m[256] = {
+	0, 1, 3, 4, 6, 7, 9, 10, 11, 13, 14, 16,
+	17, 18, 20, 21, 22, 24, 25, 26, 28, 29, 30, 32,
+	33, 34, 36, 37, 38, 40, 41, 42, 44, 45, 46, 47,
+	49, 50, 51, 52, 54, 55, 56, 57, 59, 60, 61, 62,
+	63, 65, 66, 67, 68, 69, 71, 72, 73, 74, 75, 77,
+	78, 79, 80, 81, 82, 84, 85, 86, 87, 88, 89, 90,
+	92, 93, 94, 95, 96, 97, 98, 99, 100, 102, 103, 104,
+	105, 106, 107, 108, 109, 110, 111, 112, 113, 114, 116, 117,
+	118, 119, 120, 121, 122, 123, 124, 125, 126, 127, 128, 129,
+	130, 131, 132, 133, 134, 135, 136, 137, 138, 139, 140, 141,
+	142, 143, 144, 145, 146, 147, 148, 149, 150, 151, 152, 153,
+	154, 155, 155, 156, 157, 158, 159, 160, 161, 162, 163, 164,
+	165, 166, 167, 168, 169, 169, 170, 171, 172, 173, 174, 175,
+	176, 177, 178, 178, 179, 180, 181, 182, 183, 184, 185, 185,
+	186, 187, 188, 189, 190, 191, 192, 192, 193, 194, 195, 196,
+	197, 198, 198, 199, 200, 201, 202, 203, 203, 204, 205, 206,
+	207, 208, 208, 209, 210, 211, 212, 212, 213, 214, 215, 216,
+	216, 217, 218, 219, 220, 220, 221, 222, 223, 224, 224, 225,
+	226, 227, 228, 228, 229, 230, 231, 231, 232, 233, 234, 234,
+	235, 236, 237, 238, 238, 239, 240, 241, 241, 242, 243, 244,
+	244, 245, 246, 247, 247, 248, 249, 249, 250, 251, 252, 252,
+	253, 254, 255, 255,
+};
+
+/* 2^-(age tau / H), Q16, the age in half ticks */
+static u64 lru_cast_weight(u32 age2, int le)
+{
+	u64 x = (u64)age2 * lru_cast_dq(le) >> 1;
+	u32 xi = x >> 16;
+
+	if (xi >= 32)
+		return 0;
+	return lru_cast_exp2n[(x >> 8) & 255] >> xi;
+}
+
+/*
+ * the gap of code @c (lru_cast_gap_code()), in half ticks: the middle of
+ * [0, 1], or of [2^c, 2^(c+1) - 1]
+ */
+static u32 lru_cast_gap2(u32 c)
+{
+	return c ? 3 * (1U << c) - 1 : 1;
+}
+
+/*
+ * The weights of a word's reads at each decay, its gap codes read as an
+ * index: [0] the newest's, 1, [1 + g1] the one before's, [9 + 8 g1 + g2]
+ * the one before that's (lru_cast_key_res()). Set up once, at boot.
+ */
+u32 lru_cast_wtab[LRU_CAST_LE_MAX + 1][LRU_CAST_WTAB] __read_mostly;
+
+void __init lru_cast_key_init(void)
+{
+	u32 g1, g2;
+	int le;
+
+	for (le = 1; le <= LRU_CAST_LE_MAX; le++) {
+		u32 *t = lru_cast_wtab[le];
+
+		t[0] = lru_cast_weight(0, le);
+		for (g1 = 0; g1 < 8; g1++) {
+			t[1 + g1] = lru_cast_weight(lru_cast_gap2(g1), le);
+			for (g2 = 0; g2 < 8; g2++)
+				t[9 + 8 * g1 + g2] =
+					lru_cast_weight(lru_cast_gap2(g1) + lru_cast_gap2(g2), le);
+		}
+	}
+}
+
+/* the bucket of a state word: 2^-@res half-lives of the key, or n */
+long lru_cast_key_res(u32 w, unsigned long tick, int le, int res)
+{
+	return lru_cast_key_res_inl(w, tick, le, res);
+}
+
+long lru_cast_window_lo(unsigned long tick, int le)
+{
+	if (!le)
+		return 0;
+	return (long)((((tick * lru_cast_dq(le)) >> 8) + 8 * 256) >> 6) - (LRU_CAST_BUCKETS - 1);
+}
diff --git a/mm/lru_cast/core/prefetch.c b/mm/lru_cast/core/prefetch.c
new file mode 100644
index 0000000000..1f7064ac8f
--- /dev/null
+++ b/mm/lru_cast/core/prefetch.c
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- how far ahead the two prefetch legs reach (core/prefetch.h),
+ * by the CPU, as Marie sets hers:
+ *
+ *	AVX-512F (Zen 4/5, Sapphire Rapids)	L2 MSHRs ~32	l3 32, l1 8
+ *	AMD family 0x1a and later		~32		l3 32, l1 8
+ *	AMD Zen 3 (family 0x19)			~24		l3 24, l1 8
+ *	AMD Zen 1/2 (family 0x17)		~20		l3 20, l1 8
+ *	AMD Excavator (family 0x15)		~12		l3 16, l1 6
+ *	Intel Skylake and later (CLFLUSHOPT)	~24		l3 24, l1 8
+ *	Intel Haswell, Broadwell		~16		l3 16, l1 6
+ *	other AVX2				-		l3 16, l1 6
+ *	no AVX2, or not x86			~8		l3  8, l1 2
+ */
+#include <linux/cache.h>
+#include <linux/printk.h>
+#ifdef CONFIG_X86
+#include <asm/cpufeature.h>
+#include <asm/processor.h>
+#endif
+#include "core/core.h"
+#include "version.h"
+
+unsigned int lru_cast_pf_l3 __read_mostly = 8;
+unsigned int lru_cast_pf_l1 __read_mostly = 2;
+
+void lru_cast_prefetch_init(void)
+{
+	unsigned int l3 = 8, l1 = 2;
+
+#ifdef CONFIG_X86
+	if (!boot_cpu_has(X86_FEATURE_AVX2))
+		goto done;
+	if (boot_cpu_has(X86_FEATURE_AVX512F)) {
+		l3 = 32; l1 = 8;
+		goto done;
+	}
+	switch (boot_cpu_data.x86_vendor) {
+	case X86_VENDOR_AMD:
+		if (boot_cpu_data.x86 >= 0x1a) {
+			l3 = 32; l1 = 8;
+		} else if (boot_cpu_data.x86 == 0x19) {
+			l3 = 24; l1 = 8;
+		} else if (boot_cpu_data.x86 == 0x17) {
+			l3 = 20; l1 = 8;
+		} else {
+			l3 = 16; l1 = 6;
+		}
+		break;
+	case X86_VENDOR_INTEL:
+		/* CLFLUSHOPT as Skylake's mark: Haswell and Broadwell predate it */
+		if (boot_cpu_has(X86_FEATURE_CLFLUSHOPT)) {
+			l3 = 24; l1 = 8;
+		} else {
+			l3 = 16; l1 = 6;
+		}
+		break;
+	default:
+		l3 = 16; l1 = 6;
+	}
+done:
+#endif
+	lru_cast_prefetch_set(l3, l1);
+	pr_info(LRU_CAST_PROGNAME ": prefetch l3 %u l1 %u ahead\n", l3, l1);
+}
+
+/* both legs set, the L1 one no further than the L3 one; 0 0: none */
+int lru_cast_prefetch_set(unsigned int l3, unsigned int l1)
+{
+	if (l3 > LRU_CAST_PF_MAX || l1 > l3 || (l3 && !l1))
+		return -EINVAL;
+	WRITE_ONCE(lru_cast_pf_l3, l3);
+	WRITE_ONCE(lru_cast_pf_l1, l1);
+	return 0;
+}
diff --git a/mm/lru_cast/core/prefetch.h b/mm/lru_cast/core/prefetch.h
new file mode 100644
index 0000000000..a3c067a782
--- /dev/null
+++ b/mm/lru_cast/core/prefetch.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST -- software prefetch in two stages, as Marie's.
+ *
+ * Where the frames to be read next are known before they are read -- a
+ * page table's young PTEs, the sweep's candidates -- the loop pulls the
+ * struct page and the state word of the frame lru_cast_pf_l3 ahead from
+ * memory toward L3, and of the frame lru_cast_pf_l1 ahead from L3 into
+ * L1: the long haul started as early as the next frames are known, while
+ * L1 holds only the few about to be read.
+ *
+ *	L3 leg: prefetcht2 on x86 (into L2/L3, not L1), tracked by the L2's
+ *		miss buffers (MSHRs): it may be as far ahead as those can
+ *		hold misses in flight
+ *	L1 leg: prefetcht0 (into every level), tracked by L1's fill buffers:
+ *		a short way, as far as the L3-to-L1 latency needs
+ *
+ * The kernel's prefetch() is PREFETCHNTA on x86, which bypasses L3 and
+ * is gone from L1 soon: wrong for the long leg. __builtin_prefetch() with
+ * locality 1 and 3 gives the two hints where the architecture has them.
+ *
+ * How far is set at boot by the CPU (lru_cast_prefetch_init()), and may
+ * be set by hand (sysfs prefetch; 0 0 turns it off). A prefetch never
+ * faults: a frame with no struct page or no word costs a line at most.
+ */
+#ifndef _MM_LRU_CAST_CORE_PREFETCH_H
+#define _MM_LRU_CAST_CORE_PREFETCH_H
+
+#include <linux/mm.h>
+
+#define LRU_CAST_PF_MAX		64	/* the most either leg may be set to */
+
+extern unsigned int lru_cast_pf_l3, lru_cast_pf_l1;
+/* store.c's, for the address of a frame's word alone */
+extern u32 *lru_cast_states;
+
+void lru_cast_prefetch_init(void);
+int lru_cast_prefetch_set(unsigned int l3, unsigned int l1);
+
+/* the frame @pfn's struct page and state word, pulled toward L1 (@l1) or L3 */
+static __always_inline void lru_cast_prefetch_frame(unsigned long pfn, bool l1)
+{
+	u32 *states = READ_ONCE(lru_cast_states);
+
+	if (l1) {
+#ifdef CONFIG_SPARSEMEM_VMEMMAP		/* pfn_to_page() is arithmetic, for any pfn */
+		__builtin_prefetch(pfn_to_page(pfn), 0, 3);
+#endif
+		if (states)
+			__builtin_prefetch(states + pfn, 0, 3);
+	} else {
+#ifdef CONFIG_SPARSEMEM_VMEMMAP
+		__builtin_prefetch(pfn_to_page(pfn), 0, 1);
+#endif
+		if (states)
+			__builtin_prefetch(states + pfn, 0, 1);
+	}
+}
+
+#endif /* _MM_LRU_CAST_CORE_PREFETCH_H */
diff --git a/mm/lru_cast/core/state.c b/mm/lru_cast/core/state.c
new file mode 100644
index 0000000000..84f4ee71f3
--- /dev/null
+++ b/mm/lru_cast/core/state.c
@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the per-folio state word.
+ *
+ * One 32-bit word per folio (its head page's, store.c): the clock's
+ * tick of its last read, 8 bits, in the low byte; the gaps back to the two
+ * reads before it, 3 bits each, as their logs (lru_cast_push()); and its read
+ * count, 8 bits, saturating, in the high byte. A count of zero means the
+ * folio is new to the cache. The word is reset when the page is freed and
+ * copied when a folio is migrated or split.
+ *
+ * The ticks are the clock's (core/clock.c): pages taken in.
+ *
+ * In the same word, the owner tag: what the policy above says the folio
+ * belongs to, 0 for nothing, so that a sweep of the array finds a set of
+ * folios by their words alone (lru_cast_find_owner()). The core only keeps
+ * it: cleared when the page is freed, carried to the folios a split
+ * leaves, not to a migrated folio's new place, which is given one when it
+ * is put back. Everything else here reads and writes the history around
+ * it, and gives the word without it.
+ */
+#include "core/core.h"
+#include "core/store.h"
+#include "core/inl.h"
+
+u32 lru_cast_read(struct folio *folio)
+{
+	u32 *p = lru_cast_word(folio_pfn(folio));
+
+	return p ? READ_ONCE(*p) & ~LRU_CAST_OWNER_MASK : 0;
+}
+
+/* the word of the page frame @pfn, 0 if it has none */
+u32 lru_cast_read_pfn(unsigned long pfn)
+{
+	u32 *p = lru_cast_word(pfn);
+
+	return p ? READ_ONCE(*p) & ~LRU_CAST_OWNER_MASK : 0;
+}
+
+/* @folio's owner tag made @owner; the one it had */
+u32 lru_cast_set_owner(struct folio *folio, u32 owner)
+{
+	u32 *p = lru_cast_word(folio_pfn(folio)), old;
+
+	if (!p)
+		return 0;
+	old = READ_ONCE(*p);
+	do {
+		if ((old & LRU_CAST_OWNER_MASK) >> LRU_CAST_W_OWNER == owner)
+			return owner;
+	} while (!try_cmpxchg(p, &old, (old & ~LRU_CAST_OWNER_MASK) | owner << LRU_CAST_W_OWNER));
+	return (old & LRU_CAST_OWNER_MASK) >> LRU_CAST_W_OWNER;
+}
+
+/* the out-of-line form of lru_cast_find_owner_inl() (core/inl.h) */
+unsigned long lru_cast_find_owner(unsigned long pfn, unsigned long end, u32 owner, u32 *w)
+{
+	return lru_cast_find_owner_inl(pfn, end, owner, w);
+}
+
+/*
+ * The first PFN in [@pfn, @end) whose owner tag is of a number in @lids
+ * (lru_cast.lid; bit n for tags n << 1 and n << 1 | 1), its tag in
+ * *@owner; @end if there is none.
+ */
+unsigned long lru_cast_find_owners(unsigned long pfn, unsigned long end,
+				   const unsigned long *lids, u32 *owner)
+{
+	while (pfn < end) {
+		unsigned long sec_end = min(end, section_nr_to_pfn(pfn_to_section_nr(pfn) + 1));
+		u32 *p = lru_cast_word(pfn);
+
+		if (!p) {
+			pfn = sec_end;
+			continue;
+		}
+		for (; pfn < sec_end; pfn++, p++) {
+			u32 o = (READ_ONCE(*p) & LRU_CAST_OWNER_MASK) >> LRU_CAST_W_OWNER;
+
+			if (o && test_bit(o >> 1, lids)) {
+				*owner = o;
+				return pfn;
+			}
+		}
+	}
+	return end;
+}
+
+/*
+ * The words of [@pfn, @end) old enough at @tick marked stale
+ * (lru_cast_mark()), lock-free: one read meanwhile is left as it is. How
+ * many were marked. It may sleep, a section of words at a time: run by a
+ * worker, it gives way where the kernel is not preemptible.
+ */
+unsigned long lru_cast_mark_stale(unsigned long pfn, unsigned long end, unsigned long tick)
+{
+	unsigned long marked = 0;
+
+	while (pfn < end) {
+		unsigned long sec_end = min(end, section_nr_to_pfn(pfn_to_section_nr(pfn) + 1));
+		u32 *p = lru_cast_word(pfn);
+
+		if (!p) {
+			pfn = sec_end;
+			continue;
+		}
+		for (; pfn < sec_end; pfn++, p++) {
+			u32 v = READ_ONCE(*p), m = lru_cast_mark(v, tick);
+
+			if (m && try_cmpxchg(p, &v, m))
+				marked++;
+		}
+		cond_resched();
+	}
+	return marked;
+}
+
+/* @folio's history made @w; its tag kept */
+void lru_cast_write(struct folio *folio, u32 w)
+{
+	u32 *p = lru_cast_word(folio_pfn(folio)), old;
+
+	if (!p)
+		return;
+	old = READ_ONCE(*p);
+	while (!try_cmpxchg(p, &old, (old & LRU_CAST_OWNER_MASK) | (w & ~LRU_CAST_OWNER_MASK)))
+		;
+}
+
+/* a read: push the tick, count it; lock-free */
+/* a read: push the tick, count it -- or, @kept, count it as the most there are; lock-free */
+static void lru_cast_record(struct folio *folio, enum lru_cast_read how, bool kept)
+{
+	u8 t = lru_cast_tick(folio_pgdat(folio), folio_is_file_lru(folio));
+	u32 *p = lru_cast_word(folio_pfn(folio)), old, new;
+
+	if (!p)
+		return;
+	old = READ_ONCE(*p);
+	do {
+		u32 n = kept ? 255 : min((old >> 24) + 1, 255u);
+
+		new = lru_cast_push(old, t, n);
+	} while (!try_cmpxchg(p, &old, new));
+	/* after the word (the cmpxchg orders it): its key is to be taken again */
+	if (!folio_test_rekey(folio))
+		folio_set_rekey(folio);
+
+	/* whoever watches reads sees this one (lru_cast_hook_read()) */
+	lru_cast_hook_read(folio, how);
+}
+
+void lru_cast_access(struct folio *folio)
+{
+	lru_cast_record(folio, LRU_CAST_READ, false);
+}
+
+/* a read known only by a young bit: the watchers may count it otherwise */
+void lru_cast_access_young(struct folio *folio)
+{
+	lru_cast_record(folio, LRU_CAST_READ_YOUNG, false);
+}
+
+/*
+ * Program text reclaim found in use (mm/vmscan.c), kept whatever its key:
+ * its read counted as the most a word holds, so that its key is the top of
+ * the ring now -- a read count of 255 is log2 255, about 8 half-lives,
+ * above a read just now. With decay it comes down as any key does once the
+ * text is no longer used; with none it stays above all read less.
+ */
+void lru_cast_access_kept(struct folio *folio)
+{
+	lru_cast_record(folio, LRU_CAST_READ_YOUNG, true);
+}
+
+/*
+ * A folio entering the LRU from folio_add_lru(). New to the cache (no
+ * reads recorded, nor any brought back from its shadow: ghost.c), the access that brought it in counts as its read, as a
+ * miss does in the model. That access is seen once more --
+ * folio_mark_accessed() after a read(), the young bit a fault leaves --
+ * and counted again it would make a file streamed once look read twice
+ * now, outranking all of M at the gate. PG_referenced, which legacy
+ * reclaim keeps for the same first access and CAST otherwise leaves
+ * alone, marks the entry's read as counted; the first sighting after it
+ * clears the mark instead of counting (lru_cast_access_seen()).
+ */
+void lru_cast_enter(struct folio *folio)
+{
+	if (folio_test_unevictable(folio) || (lru_cast_read(folio) >> 24))
+		return;
+	lru_cast_installed(folio, folio_nr_pages(folio));
+	lru_cast_access(folio);
+	folio_set_referenced(folio);
+}
+
+/*
+ * A sighting of a read -- folio_mark_accessed(), or a young bit found at
+ * reclaim with @referenced the folio's PG_referenced as it was taken: the
+ * first one after the folio entered the cache is the entry's own access,
+ * counted already (see lru_cast_enter()).
+ */
+void lru_cast_access_seen(struct folio *folio, bool referenced)
+{
+	if (!referenced)
+		lru_cast_access(folio);
+}
+
+/* a page freed: whatever comes next is new */
+/*
+ * A page freed, @order of them: their word cleared. A folio the cache had
+ * taken in (its word not zero) leaves it, and the clock takes it back: what
+ * leaves of itself makes no time (core/clock.c).
+ */
+void __lru_cast_reset(struct page *page, unsigned int order)
+{
+	u32 *p = lru_cast_word(page_to_pfn(page)), w;
+
+	if (!p)
+		return;
+	w = READ_ONCE(*p);
+	if (w & ~LRU_CAST_OWNER_MASK)
+		lru_cast_released(page_to_nid(page), 1UL << order);
+	if (w)
+		WRITE_ONCE(*p, 0);
+}
+
+/* the folios a split leaves: they carry the history, and belong where it did */
+void __lru_cast_copy(struct folio *dst, struct folio *src)
+{
+	u32 *s = lru_cast_word(folio_pfn(src)), *d = lru_cast_word(folio_pfn(dst));
+
+	if (!d)
+		return;
+	WRITE_ONCE(*d, s ? READ_ONCE(*s) : 0);
+}
+
+/*
+ * Migration: @src's history goes to @dst, which the clock counts taken in,
+ * as @src, freed, is counted gone -- the folio moved, nothing came or went.
+ */
+void __lru_cast_migrate(struct folio *dst, struct folio *src)
+{
+	u32 w = lru_cast_read(src);
+
+	lru_cast_write(dst, w);
+	if (w)
+		lru_cast_installed(dst, folio_nr_pages(dst));
+}
diff --git a/mm/lru_cast/core/store.c b/mm/lru_cast/core/store.c
new file mode 100644
index 0000000000..079687b98f
--- /dev/null
+++ b/mm/lru_cast/core/store.c
@@ -0,0 +1,197 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- where the state words live.
+ *
+ * One 32-bit word per page frame, in an array indexed by PFN: the state
+ * word of a folio, lru_cast_states[folio_pfn()], with no lookup and no RCU. Memory
+ * comes and goes (ACPI DIMMs, virtio-mem), so the array cannot be sized at
+ * boot to what is installed: it is a virtual range reserved for every PFN
+ * the machine could have (max_possible_pfn), backed one memory section at a
+ * time (PAGES_PER_SECTION words), as the kernel backs its own struct page
+ * array. lru_cast_sec_on[] says which sections are backed and is the only
+ * authority for "may this word be touched": a section is backed before its
+ * memory goes online and let go after it is offline, so nothing is in use
+ * while it changes. A PFN past the limit, or in a section that could not be
+ * backed, has no word: it reads as zero -- a folio never read -- and its
+ * writes go nowhere.
+ *
+ * Nothing is set up until CAST first runs: booted with lru_cast=0 the
+ * array costs nothing, and switched on later it is set up then. Once set
+ * up it stays, through CAST going off and on again.
+ */
+#include <linux/memory.h>
+#include <linux/memblock.h>
+#include <linux/memory_hotplug.h>
+#include <linux/mutex.h>
+#include <linux/vmalloc.h>
+#include "core/store.h"
+#include "compat/vmap.h"
+#include "version.h"
+
+#define LRU_CAST_SEC_BYTES		(PAGES_PER_SECTION * sizeof(u32))
+
+u32 *lru_cast_states __read_mostly;
+unsigned long lru_cast_pfn_limit __read_mostly;
+u8 *lru_cast_sec_on __read_mostly;
+static unsigned long lru_cast_nr_secs;
+static DEFINE_MUTEX(lru_cast_store_lock);
+
+/* back section @sec with zeroed pages */
+static int lru_cast_sec_attach(unsigned long sec)
+{
+	unsigned long addr = (unsigned long)(lru_cast_states + sec * PAGES_PER_SECTION);
+	unsigned long n = LRU_CAST_SEC_BYTES >> PAGE_SHIFT, i;
+	struct page **pages;
+	int err = -ENOMEM;
+
+	if (sec >= lru_cast_nr_secs)
+		return -ERANGE;
+	if (lru_cast_sec_on[sec])
+		return 0;
+	pages = kvmalloc_array(n, sizeof(*pages), GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN);
+	if (!pages)
+		return -ENOMEM;
+	for (i = 0; i < n; i++) {
+		pages[i] = alloc_page(GFP_KERNEL | __GFP_ZERO | __GFP_NORETRY | __GFP_NOWARN);
+		if (!pages[i])
+			goto free;
+	}
+	err = lru_cast_vmap_pages(addr, addr + LRU_CAST_SEC_BYTES, pages);
+	if (err)
+		goto free;
+	flush_cache_vmap(addr, addr + LRU_CAST_SEC_BYTES);
+	kvfree(pages);
+	smp_store_release(&lru_cast_sec_on[sec], 1);
+	return 0;
+free:
+	while (i--)
+		__free_page(pages[i]);
+	kvfree(pages);
+	return err;
+}
+
+/* let section @sec go: its memory is offline, no word of it is in use */
+static void lru_cast_sec_detach(unsigned long sec)
+{
+	unsigned long addr = (unsigned long)(lru_cast_states + sec * PAGES_PER_SECTION);
+	unsigned long n = LRU_CAST_SEC_BYTES >> PAGE_SHIFT, i;
+	struct page **pages;
+
+	if (sec >= lru_cast_nr_secs || !lru_cast_sec_on[sec])
+		return;
+	pages = kvmalloc_array(n, sizeof(*pages), GFP_KERNEL);
+	if (!pages)
+		return;		/* cannot name the pages: keep them, still backed */
+	WRITE_ONCE(lru_cast_sec_on[sec], 0);
+	for (i = 0; i < n; i++)
+		pages[i] = vmalloc_to_page((void *)addr + i * PAGE_SIZE);
+	vunmap_range(addr, addr + LRU_CAST_SEC_BYTES);
+	for (i = 0; i < n; i++)
+		__free_page(pages[i]);
+	kvfree(pages);
+}
+
+static int lru_cast_mem_cb(struct notifier_block *nb, unsigned long action, void *arg)
+{
+	struct memory_notify *mn = arg;
+	unsigned long sec = pfn_to_section_nr(mn->start_pfn);
+	unsigned long end = pfn_to_section_nr(mn->start_pfn + mn->nr_pages - 1);
+
+	mutex_lock(&lru_cast_store_lock);
+	if (lru_cast_states) {
+		for (; sec <= end; sec++) {
+			if (action == MEM_GOING_ONLINE) {
+				if (lru_cast_sec_attach(sec))	/* it cannot refuse: no words */
+					pr_warn_ratelimited(LRU_CAST_PROGNAME ": no state words for section %lu, its pages unranked\n",
+							    sec);
+			} else if (action == MEM_OFFLINE || action == MEM_CANCEL_ONLINE)
+				lru_cast_sec_detach(sec);
+		}
+	}
+	mutex_unlock(&lru_cast_store_lock);
+	return NOTIFY_OK;
+}
+
+static struct notifier_block lru_cast_mem_nb = {
+	.notifier_call = lru_cast_mem_cb,
+	.priority = DEFAULT_CALLBACK_PRI,
+};
+
+/*
+ * The words for all the memory there is, before CAST runs: the array set
+ * up the first time, then every present section without its words given
+ * them -- those a short allocation left out before. Short now, CAST does
+ * not come on: a page with no word is never ranked, and running with some
+ * would be a failure no one sees. A section brought online later that
+ * finds no memory for its words goes without them (it cannot refuse) and
+ * says so.
+ */
+int lru_cast_store_init(void)
+{
+	struct vm_struct *area;
+	unsigned long sec, limit;
+	int err = 0;
+
+	get_online_mems();
+	mutex_lock(&lru_cast_store_lock);
+	if (!lru_cast_states) {
+		limit = ALIGN((unsigned long)max_possible_pfn, PAGES_PER_SECTION);
+		lru_cast_nr_secs = limit / PAGES_PER_SECTION;
+		lru_cast_sec_on = kvzalloc(lru_cast_nr_secs,
+					   GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN);
+		area = lru_cast_sec_on ? get_vm_area(limit * sizeof(u32), VM_MAP) : NULL;
+		if (!area) {
+			kvfree(lru_cast_sec_on);
+			lru_cast_sec_on = NULL;
+			err = -ENOMEM;
+			goto out;
+		}
+		lru_cast_states = area->addr;
+		smp_store_release(&lru_cast_pfn_limit, limit);
+		pr_info(LRU_CAST_PROGNAME ": state words for %lu PFNs (%lu KiB reserved)\n",
+			limit, limit * sizeof(u32) >> 10);
+	}
+	for (sec = 0; sec < lru_cast_nr_secs; sec++) {
+		if (present_section_nr(sec)) {
+			err = lru_cast_sec_attach(sec);
+			if (err)
+				break;
+		}
+		cond_resched();
+	}
+out:
+	mutex_unlock(&lru_cast_store_lock);
+	put_online_mems();
+	return err;
+}
+
+/*
+ * Hotplug is followed from boot, whether or not the array is set up yet:
+ * the callback does nothing until it is. Registered here, apart from
+ * lru_cast_store_init(): there, under lru_cast_store_lock, it would take the
+ * notifier chain's lock inside ours, the callback ours inside the chain's.
+ */
+static int __init lru_cast_store_hotplug_init(void)
+{
+	return register_memory_notifier(&lru_cast_mem_nb);
+}
+subsys_initcall(lru_cast_store_hotplug_init);
+
+/*
+ * Every state word to zero, before CAST is switched back on: while it was
+ * off nothing reset a freed page's word, and a page in use since then would
+ * carry reads from before. CAST is off while this runs, so nothing else
+ * writes the words.
+ */
+void lru_cast_clear_states(void)
+{
+	unsigned long sec;
+
+	mutex_lock(&lru_cast_store_lock);
+	for (sec = 0; lru_cast_states && sec < lru_cast_nr_secs; sec++) {
+		if (lru_cast_sec_on[sec])
+			memset(lru_cast_states + sec * PAGES_PER_SECTION, 0, LRU_CAST_SEC_BYTES);
+		cond_resched();
+	}
+	mutex_unlock(&lru_cast_store_lock);
+}
diff --git a/mm/lru_cast/core/store.h b/mm/lru_cast/core/store.h
new file mode 100644
index 0000000000..d63c2dc2b1
--- /dev/null
+++ b/mm/lru_cast/core/store.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST -- the state words' array, inside core/ only: the rest reads
+ * and writes a folio's word through core.h.
+ */
+#ifndef _MM_LRU_CAST_CORE_STORE_H
+#define _MM_LRU_CAST_CORE_STORE_H
+
+#include "core/core.h"
+
+extern u32 *lru_cast_states;
+extern unsigned long lru_cast_pfn_limit;
+extern u8 *lru_cast_sec_on;
+
+/* the state word of @pfn, or NULL: none (see store.c) */
+static inline u32 *lru_cast_word(unsigned long pfn)
+{
+	if (unlikely(pfn >= READ_ONCE(lru_cast_pfn_limit)))
+		return NULL;
+	if (unlikely(!smp_load_acquire(&lru_cast_sec_on[pfn_to_section_nr(pfn)])))
+		return NULL;
+	return lru_cast_states + pfn;
+}
+
+#endif /* _MM_LRU_CAST_CORE_STORE_H */
diff --git a/mm/lru_cast/hooks.c b/mm/lru_cast/hooks.c
new file mode 100644
index 0000000000..3393f1e192
--- /dev/null
+++ b/mm/lru_cast/hooks.c
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- what the core's events reach. The core (core/) tells of a
+ * read and of pages taken in and knows no more; who hears of them is decided
+ * here, and only here.
+ */
+#include "core/core.h"
+#include "tune/tune.h"
+#include "walk/walk.h"
+
+/*
+ * A read: the controllers' sample sees it too. One known only by a young
+ * bit is not passed on while sampled pages are protected: their reads
+ * reach the controllers as faults, one each (tune/protect.c).
+ */
+void lru_cast_hook_read(struct folio *folio, enum lru_cast_read how)
+{
+	if (how == LRU_CAST_READ_YOUNG && lru_cast_protect_active())
+		return;
+	lru_cast_tune_read(folio);
+}
+
+/* those paced by the clock, by pages taken in: re-protection, and the walker */
+void lru_cast_hook_installed(long nr, unsigned long size)
+{
+	lru_cast_protect_installed(nr, size);
+	lru_cast_walk_installed(nr, size);
+}
diff --git a/mm/lru_cast/policy/balance.c b/mm/lru_cast/policy/balance.c
new file mode 100644
index 0000000000..88ce0a116e
--- /dev/null
+++ b/mm/lru_cast/policy/balance.c
@@ -0,0 +1,275 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- which type to take from, and the clean-file floor.
+ *
+ * Reclaim loses what it evicts: a refault, if the page is read again. How
+ * much memory each type should have to lose least is measured, not
+ * guessed: the controllers (tune/) keep each type's miss-ratio curve on a
+ * sample and sets anon's share of memory at the split that costs least,
+ * anon's misses weighed against file's by what their refaults cost --
+ * swappiness in its first meaning, (MAX_SWAPPINESS - s) : s. Reclaim then
+ * presses both types toward that share, a page of each by how far its type
+ * is over the share -- its part of memory over its share, against the
+ * other's -- as a swappiness, held within 1..MAX_SWAPPINESS - 1 as one an
+ * administrator sets is: at the share the two are pressed alike, the
+ * further over it the harder, and never is a type left alone. A type that
+ * will not give, its pages in use, keeps them, and the other gives in its
+ * place. Anon's part of memory counts what it holds compressed in memory,
+ * in zram or zswap, as well as its pages on the lists: a page swapped to
+ * zram frees only what compressing it saves. Before the curves can
+ * compare, the share is the split memory had when reclaim first chose, so
+ * that each type pays for its own. On the last pass before OOM (priority
+ * 0) it takes from both by their sizes.
+ *
+ * Three values of swappiness are promises, kept outside the measure:
+ *
+ *	0	never swap: file only, and at the floor nothing (then OOM)
+ *	1	file first, down to the floor, and only then anon
+ *	MAX	anon first, while swap lasts, and only then file
+ *
+ * Nothing else weighs in: a cache streamed once costs little to lose, anon
+ * in use much, and the curves show it -- by measure, where cache_trim_mode,
+ * file_is_tiny or a cost-weighted share of the scan each tried to by rule.
+ *
+ * One rule stands apart, as a promise rather than a measure: the floor.
+ * No reclaim takes clean file while the node's clean file (file pages less
+ * dirty ones) is at or below clean_min_ratio percent of its present pages
+ * and the node still has anon to take instead; then file is not on offer,
+ * and with anon unreclaimable nothing is: zone_reclaimable_pages() leaves
+ * the floor out of its count, so the stock retry logic reaches the OOM
+ * killer. The floor is the node's, and only reclaim forced by a cgroup's
+ * limit (memory.max, memory.high, its own or an ancestor's) goes below it:
+ * such a cgroup reclaims its own pages to stay within the limit whatever
+ * the node's cache, and held to the node's floor it would OOM with
+ * reclaimable file. All other reclaim holds it -- reclaim for the node, and
+ * proactive reclaim (memory.reclaim) of any cgroup, which fails rather than
+ * OOMs when there is nothing it may take. An OOM victim's own reclaim
+ * takes file. There is no floor of a cgroup's own.
+ *
+ * mm/vmscan.c holds the floor the way le9uo does: prepare_scan_control()
+ * sets sc->clean_below_min once per node pass, and get_scan_count() takes
+ * file off the offer and zeroes its scan whatever decided it.
+ */
+#include <linux/oom.h>
+#include <linux/swap.h>
+#include <linux/sched.h>
+#include <linux/sysfs.h>
+#include "policy/policy.h"
+
+static unsigned int lru_cast_clean_min_ratio = 10;
+
+/* reclaim calls that took anon, took file, took nothing, both by size, both by share */
+static atomic_long_t lru_cast_picks[5];
+
+/* node passes the floor held for */
+static atomic_long_t lru_cast_floor_held;
+
+/*
+ * The pages zsmalloc holds on @pgdat (all nodes, with NULL): anon swapped
+ * to zram or zswap, still in memory, compressed. It is anon's memory as
+ * much as the anon on the lists is.
+ */
+static unsigned long lru_cast_zspages(struct pglist_data *pgdat)
+{
+	unsigned long n = 0;
+#if IS_ENABLED(CONFIG_ZSMALLOC)
+	int z;
+
+	if (!pgdat)
+		return global_zone_page_state(NR_ZSPAGES);
+	for (z = 0; z < MAX_NR_ZONES; z++)
+		n += zone_page_state(&pgdat->node_zones[z], NR_ZSPAGES);
+#endif
+	return n;
+}
+
+static bool lru_cast_has_anon(struct pglist_data *pgdat)
+{
+	return node_page_state(pgdat, NR_ACTIVE_ANON) +
+	       node_page_state(pgdat, NR_INACTIVE_ANON) > 0;
+}
+
+/* the floor in pages, and the node's clean file */
+static void lru_cast_floor(struct pglist_data *pgdat, unsigned long *clean,
+			unsigned long *floor)
+{
+	unsigned long file = node_page_state(pgdat, NR_ACTIVE_FILE) +
+			     node_page_state(pgdat, NR_INACTIVE_FILE);
+	unsigned long dirty = node_page_state(pgdat, NR_FILE_DIRTY);
+
+	*clean = file > dirty ? file - dirty : 0;
+	*floor = pgdat->node_present_pages * READ_ONCE(lru_cast_clean_min_ratio) / 100;
+}
+
+unsigned long lru_cast_floor_file_pages(struct pglist_data *pgdat)
+{
+	unsigned long clean, floor;
+
+	if (!READ_ONCE(lru_cast_clean_min_ratio) || !lru_cast_has_anon(pgdat))
+		return 0;
+	lru_cast_floor(pgdat, &clean, &floor);
+	return min(clean, floor);
+}
+
+/* Strictly: clean file AT the floor is protected. */
+bool lru_cast_floor_holds(struct pglist_data *pgdat)
+{
+	unsigned long clean, floor;
+
+	if (!READ_ONCE(lru_cast_clean_min_ratio) || unlikely(tsk_is_oom_victim(current)))
+		return false;
+	lru_cast_floor(pgdat, &clean, &floor);
+	if (clean > floor || !lru_cast_has_anon(pgdat))
+		return false;
+	atomic_long_inc(&lru_cast_floor_held);
+	return true;
+}
+
+/*
+ * The share first wanted before the curves can compare: held at the split
+ * memory has now, each type keeping a tenth, as the curves leave a type
+ * one until they have seen it read (tune/share.c)
+ */
+static noinline void lru_cast_hold_share(void)
+{
+	unsigned long anon = global_node_page_state(NR_INACTIVE_ANON) +
+			     global_node_page_state(NR_ACTIVE_ANON) + lru_cast_zspages(NULL);
+	unsigned long file = global_node_page_state(NR_INACTIVE_FILE) +
+			     global_node_page_state(NR_ACTIVE_FILE);
+
+	lru_cast_param_hold_share(clamp(DIV_ROUND_CLOSEST(anon * 1000, max(anon + file, 1UL)),
+				     100UL, 900UL));
+}
+
+/*
+ * @lruvec's part of its node's compressed anon (@anon on its lists): by its
+ * part of the node's anon -- zram charges no cgroup for what it holds
+ */
+static unsigned long lru_cast_zs_part(struct lruvec *lruvec, unsigned long anon)
+{
+	struct pglist_data *pgdat = lruvec_pgdat(lruvec);
+	unsigned long zs = lru_cast_zspages(pgdat);
+	unsigned long node = node_page_state(pgdat, NR_ACTIVE_ANON) +
+			     node_page_state(pgdat, NR_INACTIVE_ANON);
+
+	if (!zs || !node)
+		return 0;
+	return div64_u64((u64)zs * min(anon, node), node);
+}
+
+/*
+ * @lruvec's part of the node's anon pinned for a device: the node's pins
+ * (taken less released, in pages: gup counts both, and an unpin shows at
+ * once) by its part of the node's anon, as lru_cast_zs_part() does for
+ * zram. Pinned pages stay on the lists but reclaim cannot take them, so
+ * what anon can give is its pages less these. The count does not tell
+ * anon from file; file pinned is rare, and then anon is taken for less
+ * than it is, for as long as the pin lasts.
+ */
+static unsigned long lru_cast_pinned_part(struct lruvec *lruvec, unsigned long anon)
+{
+	struct pglist_data *pgdat = lruvec_pgdat(lruvec);
+	long pins = node_page_state(pgdat, NR_FOLL_PIN_ACQUIRED) -
+		    node_page_state(pgdat, NR_FOLL_PIN_RELEASED);
+	unsigned long node = node_page_state(pgdat, NR_ACTIVE_ANON) +
+			     node_page_state(pgdat, NR_INACTIVE_ANON);
+
+	if (pins <= 0 || !node)
+		return 0;
+	return min(anon, div64_u64((u64)min((unsigned long)pins, node) * anon, node));
+}
+
+/*
+ * The pressure on a page of each type, as a swappiness: each type's part of
+ * memory over its share, anon's against file's, no further apart than 1:199.
+ * Anon's memory is its pages on the lists and those compressed in memory.
+ */
+static void lru_cast_pressure(unsigned long anon, unsigned long file, u64 *weight)
+{
+	unsigned int share = clamp(lru_cast_param_share(), 1U, 999U);
+	u64 wa = div64_u64((u64)anon * 1000000, (u64)(anon + file) * share);
+	u64 wf = div64_u64((u64)file * 1000000, (u64)(anon + file) * (1000 - share));
+	u64 sw = clamp(div64_u64(wa * MAX_SWAPPINESS, max(wa + wf, 1ULL)),
+		       1ULL, MAX_SWAPPINESS - 1ULL);
+
+	weight[LRU_CAST_ANON] = sw;
+	weight[LRU_CAST_FILE] = MAX_SWAPPINESS - sw;
+}
+
+/*
+ * What @lruvec holds of each type is read off its lists, as reclaim will
+ * scan them: a memcg's statistics are summed up only now and then, and a
+ * cgroup new to its limit can show none yet -- nothing to take, its
+ * reclaim scanning nothing, and the charge OOM.
+ */
+int lru_cast_pick(struct lruvec *lruvec, int swappiness, int priority, bool anon_ok,
+		   bool file_ok, u64 *weight)
+{
+	unsigned long anon = lru_cast_lru_size(lruvec, LRU_INACTIVE_ANON) +
+			     lru_cast_lru_size(lruvec, LRU_ACTIVE_ANON);
+	unsigned long file = lru_cast_lru_size(lruvec, LRU_INACTIVE_FILE) +
+			     lru_cast_lru_size(lruvec, LRU_ACTIVE_FILE);
+	unsigned long pinned = 0;
+	int pick;
+
+	if (swappiness <= 0)
+		anon_ok = false;		/* never swap: at the floor, nothing */
+	anon_ok = anon_ok && anon;
+	file_ok = file_ok && file;
+	if (anon_ok && file_ok && priority) {
+		/* what anon can give is what is not pinned; none, and file gives (not on the last pass) */
+		pinned = lru_cast_pinned_part(lruvec, anon);
+		if (pinned >= anon)
+			anon_ok = false;
+	}
+	if (anon_ok && file_ok) {
+		if (swappiness == 1)		/* file to the floor first */
+			pick = LRU_CAST_FILE;
+		else if (swappiness >= MAX_SWAPPINESS)	/* anon while swap lasts */
+			pick = LRU_CAST_ANON;
+		else if (!priority)	/* the last pass before OOM: both, by size */
+			pick = LRU_CAST_EQUAL;
+		else {	/* both, pressed toward the share */
+			if (unlikely(!lru_cast_param_share_held()))
+				lru_cast_hold_share();
+			lru_cast_pressure(anon - pinned + lru_cast_zs_part(lruvec, anon), file, weight);
+			pick = LRU_CAST_BOTH;
+		}
+	} else if (anon_ok) {
+		pick = LRU_CAST_ANON;
+	} else if (file_ok) {
+		pick = LRU_CAST_FILE;
+	} else {
+		pick = LRU_CAST_NONE;
+	}
+	atomic_long_inc(&lru_cast_picks[pick == LRU_CAST_NONE ? 2 : pick]);
+	return pick;
+}
+
+unsigned int lru_cast_floor_ratio(void)
+{
+	return READ_ONCE(lru_cast_clean_min_ratio);
+}
+
+int lru_cast_set_floor_ratio(unsigned int percent)
+{
+	if (percent > 100)
+		return -EINVAL;
+	WRITE_ONCE(lru_cast_clean_min_ratio, percent);
+	return 0;
+}
+
+int lru_cast_floor_held_show(char *buf)
+{
+	return sysfs_emit(buf, "%ld\n", atomic_long_read(&lru_cast_floor_held));
+}
+
+int lru_cast_balance_show(char *buf)
+{
+	return sysfs_emit(buf, "anon %ld\nfile %ld\nnone %ld\nequal %ld\nboth %ld\n",
+			  atomic_long_read(&lru_cast_picks[0]),
+			  atomic_long_read(&lru_cast_picks[1]),
+			  atomic_long_read(&lru_cast_picks[2]),
+			  atomic_long_read(&lru_cast_picks[3]),
+			  atomic_long_read(&lru_cast_picks[4]));
+}
diff --git a/mm/lru_cast/policy/ghost.c b/mm/lru_cast/policy/ghost.c
new file mode 100644
index 0000000000..7e0c39e8d4
--- /dev/null
+++ b/mm/lru_cast/policy/ghost.c
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the history of evicted folios.
+ *
+ * An evicted folio leaves a shadow entry in the page cache or swap cache
+ * (mm/workingset.c); on a CAST node the shadow carries the folio's state
+ * word, the tick of the clock (core/clock.c) it was evicted at, its node
+ * and whether it had been read more than once, over the bit that marks it
+ * CAST's:
+ *
+ *	| history H | tick 16 | node NODES_SHIFT | workingset 1 | kind 1 |
+ *
+ * The history, H = LRU_CAST_W_HISTORY_BITS bits, is the state word less its
+ * owner tag (lru_cast_read() gives none, lru_cast_write() keeps the
+ * frame's): its read count over its tick and gaps. An anon shadow is kept
+ * in the swap table, whose top LRU_CAST_SHADOW_ANON_RESERVED bits of the
+ * word are the slot's count and zero flag; the shadow stays below them.
+ *
+ * The tick wraps after 65536 ticks, 16384 turnovers of the node's memory;
+ * a shadow that old comes back as recent, and only then.
+ *
+ * A folio faulted back within LRU_CAST_GHOST_TICKS (8C pages taken in) gets its
+ * state word back, its reads since it entered the cache with it, and the
+ * fault counts as one more read: the model's ghost. Later than that the
+ * history is too old to rank by and the folio starts afresh.
+ *
+ * Legacy reclaim measures a refault against the size of the workingset to
+ * tell whether the eviction was a mistake; CAST asks its own question --
+ * kept, would the folio's key, its history alone, rank above the bucket
+ * reclaim is taking from? -- and answers it with the same counters and flags
+ * (WORKINGSET_ACTIVATE, PG_active, and for a folio read more than once
+ * WORKINGSET_RESTORE, PG_workingset and the refault cost that
+ * get_scan_count() weighs).
+ *
+ * A shadow is read as CAST's while CAST runs and as legacy's otherwise;
+ * one left by the other side across a switch is told by its kind bit
+ * (LRU_CAST_SHADOW_KIND) and taken as no history.
+ */
+#include <linux/swap.h>
+#include <linux/xarray.h>
+#include "policy/policy.h"
+
+#define LRU_CAST_GHOST_TICKS	32
+
+#define LRU_CAST_SHADOW_WS		1
+#define LRU_CAST_SHADOW_TICK	16
+#define LRU_CAST_SHADOW_STATE	LRU_CAST_W_HISTORY_BITS
+
+static void *lru_cast_pack(u32 w, u16 tick, int nid, bool workingset)
+{
+	unsigned long v = lru_cast_history_pack(w);
+
+	BUILD_BUG_ON(LRU_CAST_SHADOW_STATE + LRU_CAST_SHADOW_TICK + NODES_SHIFT +
+		     LRU_CAST_SHADOW_WS + LRU_CAST_SHADOW_KIND >
+		     BITS_PER_XA_VALUE - LRU_CAST_SHADOW_ANON_RESERVED);
+	v = (v << LRU_CAST_SHADOW_TICK) | tick;
+	v = (v << NODES_SHIFT) | nid;
+	v = (v << LRU_CAST_SHADOW_WS) | workingset;
+	v = (v << LRU_CAST_SHADOW_KIND) | 1;
+	return xa_mk_value(v);
+}
+
+static void lru_cast_unpack(void *shadow, u32 *w, u16 *tick, int *nid, bool *workingset)
+{
+	unsigned long v = xa_to_value(shadow) >> LRU_CAST_SHADOW_KIND;
+
+	*workingset = v & 1;
+	v >>= LRU_CAST_SHADOW_WS;
+	*nid = v & ((1UL << NODES_SHIFT) - 1);
+	v >>= NODES_SHIFT;
+	*tick = v & 0xffff;
+	v >>= LRU_CAST_SHADOW_TICK;
+	*w = lru_cast_history_unpack(v);
+}
+
+/* the shadow is CAST's, left on this node within the ghosts' window: its history read out */
+static bool lru_cast_ghost_recent(void *shadow, int nid, int type, u32 *w, bool *workingset)
+{
+	u16 tick;
+	int snid;
+
+	*workingset = false;
+	if (!lru_cast_shadow(shadow))
+		return false;
+	lru_cast_unpack(shadow, w, &tick, &snid, workingset);
+	if (snid != nid || !node_online(snid))
+		return false;
+	return (u16)(lru_cast_tick(NODE_DATA(snid), type) - tick) <= LRU_CAST_GHOST_TICKS;
+}
+
+/* the shadow's history if it is still worth having, else false */
+static bool lru_cast_ghost(void *shadow, int nid, int type, u32 *w, bool *workingset)
+{
+	return lru_cast_ghost_recent(shadow, nid, type, w, workingset) && (*w >> 24);
+}
+
+void *lru_cast_eviction(struct folio *folio)
+{
+	struct pglist_data *pgdat = folio_pgdat(folio);
+	int type = folio_is_file_lru(folio);
+	u32 w = lru_cast_read(folio);
+
+	lru_cast_shadowed(pgdat, type, folio_nr_pages(folio));
+	return lru_cast_pack(w, lru_cast_tick(pgdat, type), pgdat->node_id, (w >> 24) > 1);
+}
+
+bool lru_cast_test_recent(void *shadow, bool file, bool *workingset)
+{
+	int nid = (xa_to_value(shadow) >> (LRU_CAST_SHADOW_KIND + LRU_CAST_SHADOW_WS)) &
+		  ((1UL << NODES_SHIFT) - 1);
+	u32 w;
+
+	return lru_cast_ghost(shadow, nid, file, &w, workingset);
+}
+
+void lru_cast_refault(struct folio *folio, void *shadow)
+{
+	int type = folio_is_file_lru(folio);
+	long nr = folio_nr_pages(folio), kept, victim;
+	struct lruvec *lruvec;
+	bool workingset;
+	u32 w;
+
+	/* the folio is locked: its memcg is held, its lruvec read under RCU */
+	rcu_read_lock();
+	lruvec = folio_lruvec(folio);
+	mod_lruvec_state(lruvec, WORKINGSET_REFAULT_BASE + type, nr);
+	if (!lru_cast_ghost_recent(shadow, folio_nid(folio), type, &w, &workingset))
+		goto out;
+	lru_cast_returned(folio_pgdat(folio), type, nr);	/* the eviction undone */
+	if (!(w >> 24))
+		goto out;
+
+	/*
+	 * The history back, and the question asked of it before the fault
+	 * adds its read: kept, would the folio rank above what reclaim takes
+	 * now? With this read counted it would, for anything just read ranks
+	 * above M's lowest. With no bucket taken from yet there is nothing to
+	 * ask it against.
+	 */
+	lru_cast_write(folio, w);
+	lru_cast_installed(folio, nr);		/* taken in again: the clock counts it */
+	kept = lru_cast_bucket(folio, type);
+	victim = READ_ONCE(lruvec->lru_cast[type].victim);
+	lru_cast_access(folio);
+	folio_set_referenced(folio);
+
+	if (victim == LONG_MIN || kept <= victim)
+		goto out;
+	folio_set_active(folio);
+	mod_lruvec_state(lruvec, WORKINGSET_ACTIVATE_BASE + type, nr);
+	if (workingset) {
+		folio_set_workingset(folio);
+		lru_cast_note_refault_cost(folio);
+		mod_lruvec_state(lruvec, WORKINGSET_RESTORE_BASE + type, nr);
+	}
+out:
+	rcu_read_unlock();
+}
+
+/*
+ * CAST coming back on: the shadows it left before it went off are older
+ * than their ticks say, the clocks having stood still meanwhile, and their
+ * folios' state words have been cleared. Every node's clock moves past the
+ * ghosts' window, and those shadows are taken as no history.
+ */
+void lru_cast_ghosts_forget(void)
+{
+	int nid;
+
+	for_each_online_node(nid) {
+		struct lru_cast_clock *c = &NODE_DATA(nid)->lru_cast_clock;
+
+		WRITE_ONCE(c->tick, c->tick + LRU_CAST_GHOST_TICKS + 1);
+	}
+}
diff --git a/mm/lru_cast/policy/params.c b/mm/lru_cast/policy/params.c
new file mode 100644
index 0000000000..d032ff4630
--- /dev/null
+++ b/mm/lru_cast/policy/params.c
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the main cache's operating point.
+ *
+ * Three numbers say how the main cache runs, and only these: per type the
+ * decay le its keys rank by (policy/ring.c), W's share of its pages
+ * (policy/reclaim.c), and anon's share of memory (policy/balance.c). The
+ * controllers (tune/) set them from what they measure, or the
+ * administrator by hand (sysfs.c); the policy reads them, on every
+ * reclaim, inline (policy.h). Each is set here and nowhere else, within its
+ * range: lru_cast_params is named in this file and in policy.h's readers
+ * only (check-layers.sh).
+ */
+#include "policy/policy.h"
+
+/*
+ * The decay starts at its weakest (core/core.h). A decay too weak costs
+ * misses as long as it lasts -- folios read often once and no more stay --
+ * and the controllers see them pile up; one too strong costs only after a scan, a few, the
+ * folios read often until it began: too few, in the sample, to move the
+ * decay back down before the next.
+ */
+struct lru_cast_params lru_cast_params = {
+	.le = { LRU_CAST_LE_MIN, LRU_CAST_LE_MIN },
+	.share = 500,
+};
+
+void lru_cast_param_set_le(int type, unsigned int le)
+{
+	WRITE_ONCE(lru_cast_params.le[type], clamp(le, (unsigned int)LRU_CAST_LE_MIN,
+						   (unsigned int)LRU_CAST_LE_MAX));
+}
+
+void lru_cast_param_set_w(int type, unsigned int permille)
+{
+	WRITE_ONCE(lru_cast_params.w[type], min(permille, 1000u));
+}
+
+void lru_cast_param_set_share(unsigned int permille)
+{
+	WRITE_ONCE(lru_cast_params.share, min(permille, 1000u));
+}
+
+/*
+ * The share is held once it has been set at a split: when reclaim first
+ * wants it (balance.c) or the curves can first compare (tune/share.c),
+ * whichever comes first. Before that it is not used.
+ */
+static atomic_t lru_cast_share_held = ATOMIC_INIT(0);
+
+bool lru_cast_param_share_held(void)
+{
+	return atomic_read(&lru_cast_share_held);
+}
+
+/* the share held at @permille, unless it is already; true if this held it */
+bool lru_cast_param_hold_share(unsigned int permille)
+{
+	if (atomic_cmpxchg(&lru_cast_share_held, 0, 1))
+		return false;
+	lru_cast_param_set_share(permille);
+	return true;
+}
+
+/* the share let go, to be held again: the controllers start over */
+void lru_cast_param_free_share(void)
+{
+	lru_cast_param_set_share(500);
+	atomic_set(&lru_cast_share_held, 0);
+}
diff --git a/mm/lru_cast/policy/policy.h b/mm/lru_cast/policy/policy.h
new file mode 100644
index 0000000000..ad9271c982
--- /dev/null
+++ b/mm/lru_cast/policy/policy.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST -- the policy: the main cache, run inside reclaim.
+ *
+ *   params.c   its operating point: per type the decay and W's share, and
+ *              anon's share of memory -- set by tune/ or by hand
+ *   ring.c     M, the active folios, and its lowest found by a sweep
+ *   reclaim.c  the victims: W's excess admitted to M, then M's lowest
+ *   ghost.c    the history an evicted folio leaves in its shadow
+ *   balance.c  which type reclaim takes from, and the clean-file floor
+ *
+ * Built on core/ alone. mm/vmscan.c reaches it through <linux/lru_cast.h>.
+ */
+#ifndef _MM_LRU_CAST_POLICY_H
+#define _MM_LRU_CAST_POLICY_H
+
+#include "core/core.h"
+
+/* params.c: set there only; read here, inline */
+struct lru_cast_params {
+	unsigned int le[ANON_AND_FILE];	/* half-life C * 2^(8 - le) pages taken in; 0: no decay */
+	unsigned int w[ANON_AND_FILE];	/* W's share of the type, thousandths; 0: the gate */
+	unsigned int share;		/* anon's share of memory, thousandths */
+};
+extern struct lru_cast_params lru_cast_params;
+
+void lru_cast_param_set_le(int type, unsigned int le);
+void lru_cast_param_set_w(int type, unsigned int permille);
+void lru_cast_param_set_share(unsigned int permille);
+/* anon's share held at a split once, by whichever wants it first; the curves move it from there */
+bool lru_cast_param_share_held(void);
+bool lru_cast_param_hold_share(unsigned int permille);
+void lru_cast_param_free_share(void);
+
+static inline unsigned int lru_cast_param_le(int type)
+{
+	return READ_ONCE(lru_cast_params.le[type]);
+}
+
+static inline unsigned int lru_cast_param_w(int type)
+{
+	return READ_ONCE(lru_cast_params.w[type]);
+}
+
+static inline unsigned int lru_cast_param_share(void)
+{
+	return READ_ONCE(lru_cast_params.share);
+}
+
+/* reclaim.c: under the lruvec's lru_lock */
+#define LRU_CAST_ADMIT	2	/* W's tail admitted per page reclaim asks for */
+#define LRU_CAST_W_SLACK	32	/* pages W may hold over its share as folios come in */
+unsigned long lru_cast_w_admit(struct lruvec *lruvec, int type, unsigned long *nr_w,
+			    unsigned long *nr_m, unsigned long slack, unsigned long budget);
+
+/* ring.c: under the lruvec's lru_lock; admit and min after prepare, in the same hold */
+long lru_cast_bucket(struct folio *folio, int type);
+void lru_cast_ring_prepare(struct lruvec *lruvec, int type);
+void lru_cast_ring_put(struct lruvec *lruvec, struct folio *folio, int type);
+void lru_cast_ring_out(struct folio *folio);
+void lru_cast_ring_admit(struct lruvec *lruvec, struct folio *folio, int type);
+struct folio *lru_cast_ring_min(struct lruvec *lruvec, int type, long *bucket);
+void lru_cast_ring_reset(struct lruvec *lruvec);
+void lru_cast_ring_init(struct lruvec *lruvec);
+void lru_cast_ring_exit(struct lruvec *lruvec);
+void lru_cast_ring_reparent(struct lruvec *child, struct lruvec *parent);
+int lru_cast_sweep_show(char *buf);
+
+/* ghost.c */
+void lru_cast_ghosts_forget(void);
+
+/* balance.c */
+unsigned int lru_cast_floor_ratio(void);
+int lru_cast_set_floor_ratio(unsigned int percent);
+int lru_cast_floor_held_show(char *buf);
+int lru_cast_balance_show(char *buf);
+
+#endif /* _MM_LRU_CAST_POLICY_H */
diff --git a/mm/lru_cast/policy/reclaim.c b/mm/lru_cast/policy/reclaim.c
new file mode 100644
index 0000000000..c598c51651
--- /dev/null
+++ b/mm/lru_cast/policy/reclaim.c
@@ -0,0 +1,197 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the choice of victims.
+ *
+ * W holds the newcomers not yet weighed against M. While W is over its
+ * share, its tail joins M (lru_cast_w_admit()), in front of reclaim's
+ * candidates when its key is below theirs, so it is the first to go; and
+ * what reclaim takes is M's lowest as a sweep finds it (policy/ring.c).
+ * That is the model's gate -- W's tail meets M's lowest, the lower goes.
+ * W is kept to its share as folios come in (policy/ring.c), not only once
+ * reclaim runs: left to grow until then, W held all that came in since
+ * boot, in the order it came, and reclaim admitted its oldest first -- the
+ * folios read most since, a database warmed before a scan -- to take M's
+ * lowest from among only those, while the scan waited in W unweighed.
+ *
+ * A folio leaving W for M has left what legacy reclaim calls the inactive
+ * list, as an activated one has there, and ages the nonresident clock the
+ * same way: refault distances are measured on it, and with it running on
+ * evictions alone a refault would look twice as recent as it is.
+ *
+ * As folios come in, W may go over its share by LRU_CAST_W_SLACK pages before
+ * its excess is admitted, all of it at once: the fixed part of an
+ * admission, under the lock every fault adding to the LRU takes, is paid
+ * once a slack's worth and not for every folio, and W stays within a few
+ * dozen pages of where the model keeps it. Reclaim admits without slack,
+ * LRU_CAST_ADMIT times the pages it asks for at most, so the lock is not held
+ * over the whole of a large W; what is left waits for the next call, still
+ * the oldest of W. A folio taken from
+ * M loses PG_active, so what reclaim hands back without a verdict joins
+ * W's head.
+ *
+ * Runs under the lruvec's lru_lock; the caller (mm/vmscan.c) passes in
+ * what it knows of the scan and does the size accounting from the counts
+ * this hands back.
+ */
+#include "policy/policy.h"
+
+/*
+ * W's excess joins M by key, its tail first, at most @budget pages, once
+ * W is over its share by more than @slack; the lists' sizes, *@nr_w and
+ * *@nr_m, follow, once per zone. Run where a folio enters W
+ * (__lru_cast_add_folio()), so that W holds no more than its share, as in
+ * the model, but for the slack; and again by reclaim, should the share
+ * have shrunk. Under the lru_lock.
+ */
+unsigned long lru_cast_w_admit(struct lruvec *lruvec, int type, unsigned long *nr_w,
+			    unsigned long *nr_m, unsigned long slack, unsigned long budget)
+{
+	enum lru_list lru_w = type ? LRU_INACTIVE_FILE : LRU_INACTIVE_ANON;
+	enum lru_list lru_m = lru_w + LRU_ACTIVE;
+	struct list_head *w = &lruvec->lists[lru_w];
+	unsigned long target = (*nr_w + *nr_m) * lru_cast_param_w(type) / 1000;
+	unsigned long moved[MAX_NR_ZONES] = { 0 }, admitted = 0, nr_pages;
+	int zid;
+
+	if (*nr_w <= target + slack)
+		return 0;
+	lru_cast_ring_prepare(lruvec, type);
+	while (budget && *nr_w > target && !list_empty(w)) {
+		struct folio *folio = lru_to_folio(w);
+
+		/* still being read in: it has not arrived, and waits in W until it has */
+		if (folio_test_locked(folio))
+			break;
+
+		nr_pages = folio_nr_pages(folio);
+		list_del(&folio->lru);
+		folio_set_active(folio);
+		moved[folio_zonenum(folio)] += nr_pages;
+		lru_cast_ring_admit(lruvec, folio, type);
+		*nr_w -= min(*nr_w, nr_pages);
+		*nr_m += nr_pages;
+		budget -= min(budget, nr_pages);
+		admitted += nr_pages;
+	}
+	for (zid = 0; admitted && zid < MAX_NR_ZONES; zid++) {
+		if (!moved[zid])
+			continue;
+		lru_cast_update_lru_size(lruvec, lru_w, zid, -moved[zid]);
+		lru_cast_update_lru_size(lruvec, lru_m, zid, moved[zid]);
+	}
+	if (admitted)
+		lru_cast_age_nonresident(lruvec, admitted);
+	return admitted;
+}
+
+unsigned long lru_cast_isolate(struct lruvec *lruvec, struct lru_cast_scan *s,
+				struct list_head *dst)
+{
+	enum lru_list lru_w = s->type ? LRU_INACTIVE_FILE : LRU_INACTIVE_ANON;
+	struct list_head *w = &lruvec->lists[lru_w];
+	unsigned long nr_w = s->nr_w, nr_m = s->nr_m, scan = 0, nr_pages;
+	LIST_HEAD(aside_w);
+	LIST_HEAD(aside_m);
+
+	lru_cast_w_admit(lruvec, s->type, &nr_w, &nr_m, 0, s->nr_to_scan * LRU_CAST_ADMIT);
+	lru_cast_ring_prepare(lruvec, s->type);
+
+	while (scan < s->nr_to_scan) {
+		struct folio *folio;
+		bool from_m = true;
+		long bm = 0;
+
+		folio = nr_m ? lru_cast_ring_min(lruvec, s->type, &bm) : NULL;
+		if (folio) {
+			WRITE_ONCE(lruvec->lru_cast[s->type].victim, bm);
+		} else if (!list_empty(w)) {
+			folio = lru_to_folio(w);
+			from_m = false;
+		} else {
+			break;
+		}
+
+		nr_pages = folio_nr_pages(folio);
+		s->nr_scanned += nr_pages;
+		if (from_m)
+			nr_m -= min(nr_m, nr_pages);
+		else
+			nr_w -= min(nr_w, nr_pages);
+
+		/* not eligible: set aside, back where it was at the end */
+		if (folio_zonenum(folio) > s->reclaim_idx) {
+			s->skipped[folio_zonenum(folio)] += nr_pages;
+			goto aside;
+		}
+		scan += nr_pages;
+		if (!folio_test_lru(folio) || (!s->may_unmap && folio_mapped(folio)))
+			goto aside;
+		/*
+		 * Pinned for a device (FOLL_LONGTERM: CUDA, io_uring, RDMA): the
+		 * unmap fails, and the folio would go back to M under the same
+		 * key, still the lowest, for reclaim to take again -- the CPU
+		 * does not read it, so nothing lifts it. Lift it, as program
+		 * text in use is: it is in use, and a victim must be one that
+		 * can go. (How much of a type is pinned, lru_cast_pick() reads
+		 * off the node's pin counts.)
+		 */
+		if (unlikely(folio_maybe_dma_pinned(folio))) {
+			lru_cast_access_kept(folio);
+			goto aside;
+		}
+		if (unlikely(!folio_try_get(folio)))
+			goto aside;
+		if (!folio_test_clear_lru(folio)) {
+			folio_put(folio);
+			goto aside;
+		}
+
+		list_move(&folio->lru, dst);
+		if (from_m) {
+			s->taken_m[folio_zonenum(folio)] += nr_pages;
+			folio_clear_active(folio);
+			lru_cast_ring_out(folio);
+		} else {
+			s->taken_w[folio_zonenum(folio)] += nr_pages;
+			folio_set_rekey(folio);	/* not placed by a key: reclaim asks it */
+		}
+		s->nr_taken += nr_pages;
+		continue;
+aside:
+		list_move(&folio->lru, from_m ? &aside_m : &aside_w);
+	}
+
+	list_splice(&aside_w, w);
+	while (!list_empty(&aside_m)) {
+		struct folio *folio = lru_to_folio(&aside_m);
+
+		list_del(&folio->lru);
+		lru_cast_ring_put(lruvec, folio, s->type);
+	}
+	if (s->nr_taken)
+		lru_cast_evicted(lruvec_pgdat(lruvec), s->type, s->nr_taken);
+	return s->nr_taken;
+}
+
+/*
+ * Reclaim found @folio young and credited the read. It stays only if that
+ * lifted it above the key reclaim was taking at; still at or below,
+ * it is as good a victim as before -- the same decision as picking M's
+ * lowest again after the credit. Without this, a cache whose every folio is
+ * in use would keep them all and make no progress.
+ */
+bool lru_cast_still_victim(struct folio *folio)
+{
+	int type = folio_is_file_lru(folio);
+	bool still;
+
+	/* not read since its key was taken at or below that one */
+	if (!folio_test_rekey(folio))
+		return true;
+	/* the folio is isolated: its memcg is held, its lruvec read under RCU */
+	rcu_read_lock();
+	still = lru_cast_bucket(folio, type) <=
+		READ_ONCE(folio_lruvec(folio)->lru_cast[type].victim);
+	rcu_read_unlock();
+	return still;
+}
diff --git a/mm/lru_cast/policy/ring.c b/mm/lru_cast/policy/ring.c
new file mode 100644
index 0000000000..14e3265be0
--- /dev/null
+++ b/mm/lru_cast/policy/ring.c
@@ -0,0 +1,796 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- keys, and M's lowest found by a sweep.
+ *
+ * Each type of an lruvec is a cache of two parts: W, the inactive list, a
+ * FIFO window for newcomers; and M, the active list, in no order.
+ *
+ * A folio of M carries its owner tag in its state word (core/state.c):
+ * its lruvec's number in the node and its type, 0 if not in M -- set as it enters M,
+ * cleared as reclaim takes it, as it goes to W or becomes unevictable, and
+ * as the page is freed. A folio isolated by others keeps its tag until it
+ * comes back: the tag says where to look, the folio itself is asked before
+ * it is taken. A stale tag costs more than a wasted candidate: its block
+ * is never found empty.
+ *
+ * The tag has 10 bits: an lruvec is given a number in its node as its first
+ * folio comes into M, one of LRU_CAST_LIDS - 2, and gives it back when it
+ * is freed. Past that many in a node, the rest share the last number, and
+ * their folios of M are told apart by CAST's own number of their lruvec
+ * (lru_cast.tag) in a table by PFN beside the array, lru_cast_spill: a
+ * sweep of a spilled lruvec looks there for each folio of the shared number
+ * it meets. A folio of the shared number the table has nothing for (a
+ * split's tail, a store that failed) is taken for the sweeper's; whatever
+ * the table holds, the folio itself is asked before it is taken.
+ *
+ * Reclaim takes M's lowest key (core/key.c), counted in sixteenths of a
+ * half-life. It finds it by sweeping the node's state words in PFN order
+ * from a cursor that wraps, and for each of this lruvec's M taking the
+ * key of the word; it keeps the LRU_CAST_CANDS lowest keys
+ * as candidates (PFN, key, the word as read). A sweep stops once it holds
+ * that many all at or below tau, the 1/16 quantile of the keys the last
+ * full pass read (a sample of them) -- before any pass, of the keys of
+ * folios of M drawn at random from the node (lru_cast_tau_probe()): the
+ * cursor starts where the node does, and the folios there, the first to
+ * come in, would otherwise be taken as the lowest of the few read, a
+ * working set allocated at once among them; until there is tau, or after
+ * LRU_CAST_SWEEP_MAX frames, it keeps the lowest it has read -- or, having
+ * found none, reads on to LRU_CAST_SWEEP_EMPTY: a small memcg's folios lie
+ * in a few places of the node. A candidate is
+ * taken only if it is still a folio of M here and its word is as read: one
+ * read since has a higher key and waits for the next pass.
+ *
+ * A newcomer from W's tail below the lowest candidate goes in front of the
+ * candidates, first to be taken: W's tail meeting M's lowest, the lower
+ * goes.
+ *
+ * A memcg taken offline may hand its LRU folios to its parent's lruvec by
+ * splicing its lists (lru_cast_ring_reparent()), and its folios of M come
+ * with its number. The number is then the node's to give back, not the
+ * lruvec's: it is marked moved, and a work item (lru_cast_rehome_fn()),
+ * out of the locks the splice holds, gives each folio of M carrying it the
+ * tag of the lruvec it is on now, before the number is given back. Until
+ * then a sweep of the parent does not find them, as if they had come in
+ * late.
+ *
+ * Everything here runs under the lruvec's lru_lock but the work.
+ */
+#include <linux/hash.h>
+#include <linux/xarray.h>
+#include <linux/workqueue.h>
+#include "policy/policy.h"
+#include "core/inl.h"
+
+#define LRU_CAST_RES		4	/* sixteenths of a half-life */
+#define LRU_CAST_SWEEP_MAX		4096	/* frames a sweep reads at most */
+#define LRU_CAST_SWEEP_EMPTY	65536	/* ... or, with nothing found yet, this many */
+#define LRU_CAST_TAU_SHIFT		4	/* tau: the 1/16 quantile */
+#define LRU_CAST_PROBES		4096	/* frames drawn at most for tau before a pass */
+#define LRU_CAST_PROBE_MIN		32	/* ... and the keys it takes */
+#define LRU_CAST_REHOME_SCAN	(1UL << 18)	/* frames the work reads between rests */
+
+/* the number the lruvecs past the node's numbers share */
+#ifndef LRU_CAST_LID_SPILL
+#define LRU_CAST_LID_SPILL		(LRU_CAST_LIDS - 1)
+#endif
+
+/* their folios of M by PFN: their lruvecs' tag, type (as lru_cast_spilled()) */
+static DEFINE_XARRAY_FLAGS(lru_cast_spill, XA_FLAGS_LOCK_IRQ);
+
+/* what the sweeps did, for sysfs (lru_cast/sweep): counted under the lru_lock, per CPU */
+enum { SW_SWEEPS, SW_FRAMES, SW_WORDS, SW_TAKEN, SW_STALE, SW_GATE, SW_FALLBACK, SW_SPILLED, SW_PROBED, SW_NR };
+static DEFINE_PER_CPU(unsigned long [SW_NR], lru_cast_sw);
+
+static inline void sw_add(int i, unsigned long n)
+{
+	__this_cpu_add(lru_cast_sw[i], n);
+}
+
+long lru_cast_bucket(struct folio *folio, int type)
+{
+	return lru_cast_key_res(lru_cast_read(folio), lru_cast_tick(folio_pgdat(folio), type),
+			     lru_cast_param_le(type), LRU_CAST_RES);
+}
+
+static struct list_head *lru_cast_m(struct lruvec *lruvec, int type)
+{
+	return &lruvec->lists[LRU_ACTIVE_ANON + type * LRU_FILE];
+}
+
+/*
+ * @lruvec's number in its node, given on first use: the lowest free of
+ * 1 .. LRU_CAST_LID_SPILL - 1, or LRU_CAST_LID_SPILL, shared, if none is. Not the
+ * memcg's ID, which a memcg removed with pages left gives up, to 0.
+ */
+static u32 lru_cast_lid(struct lruvec *lruvec)
+{
+	struct lru_cast *k = &lruvec->lru_cast[0];
+	unsigned long *ids = lruvec_pgdat(lruvec)->lru_cast_clock.lids;
+	unsigned int id;
+
+	BUILD_BUG_ON(LRU_CAST_LIDS > 1U << (LRU_CAST_OWNER_BITS - 1));
+	if (likely(k->lid))
+		return k->lid;
+	do {
+		id = find_next_zero_bit(ids, LRU_CAST_LID_SPILL, 1);
+	} while (id < LRU_CAST_LID_SPILL && test_and_set_bit(id, ids));
+	if (id == LRU_CAST_LID_SPILL)
+		sw_add(SW_SPILLED, 1);
+	k->lid = id;
+	return id;
+}
+
+/* the owner tag of @lruvec's M of @type: its number, its type; never 0 */
+static u32 lru_cast_owner(struct lruvec *lruvec, int type)
+{
+	return lru_cast_lid(lruvec) << 1 | type;
+}
+
+static bool lru_cast_spilled(u32 owner)
+{
+	return owner >> 1 == LRU_CAST_LID_SPILL;
+}
+
+/* who a folio of a spilled M belongs to: CAST's number of its lruvec, its type */
+static unsigned long lru_cast_spill_owner(struct lruvec *lruvec, int type)
+{
+	return (unsigned long)lruvec->lru_cast[0].tag << 1 | type;
+}
+
+/* the table's entry for @pfn made @v, or none for NULL; failing, left */
+static void lru_cast_spill_store(unsigned long pfn, void *v)
+{
+	unsigned long flags;
+
+	xa_lock_irqsave(&lru_cast_spill, flags);
+	__xa_store(&lru_cast_spill, pfn, v, GFP_ATOMIC | __GFP_NOWARN);
+	xa_unlock_irqrestore(&lru_cast_spill, flags);
+}
+
+/* is the folio at @pfn, of the shared number, @lruvec's of @type, as the table tells */
+static bool lru_cast_spill_ours(unsigned long pfn, struct lruvec *lruvec, int type)
+{
+	void *v = xa_load(&lru_cast_spill, pfn);
+
+	return !v || xa_to_value(v) == lru_cast_spill_owner(lruvec, type);
+}
+
+/*
+ * The blocks of the node, as @k has them: LRU_CAST_BLOCKS of 2^shift
+ * PFNs, at least 512 (a PMD). A block's bit is set as a folio of M comes
+ * into it and cleared once a sweep reads all of it and finds none; the
+ * node grown or shrunk, the blocks are drawn again, all set.
+ */
+static unsigned int lru_cast_blocks(struct lruvec *lruvec, struct lru_cast *k)
+{
+	struct pglist_data *pgdat = lruvec_pgdat(lruvec);
+	unsigned long span = pgdat_end_pfn(pgdat) - pgdat->node_start_pfn;
+	unsigned int shift = max_t(int, 9, fls64(span ? span - 1 : 0) - ilog2(LRU_CAST_BLOCKS));
+
+	if (k->block_shift != shift) {
+		bitmap_fill(k->blocks, LRU_CAST_BLOCKS);
+		k->block_shift = shift;
+	}
+	return shift;
+}
+
+/* @folio into M of @type: its tag, and its block */
+static void lru_cast_m_enter(struct lruvec *lruvec, struct folio *folio, int type)
+{
+	struct lru_cast *k = &lruvec->lru_cast[type];
+	unsigned int shift = lru_cast_blocks(lruvec, k);
+	u32 owner = lru_cast_owner(lruvec, type);
+
+	lru_cast_set_owner(folio, owner);
+	if (lru_cast_spilled(owner))
+		lru_cast_spill_store(folio_pfn(folio),
+				     xa_mk_value(lru_cast_spill_owner(lruvec, type)));
+	else if (!xa_empty(&lru_cast_spill) && xa_load(&lru_cast_spill, folio_pfn(folio)))
+		/* the page's, before it was freed */
+		lru_cast_spill_store(folio_pfn(folio), NULL);
+	__set_bit((folio_pfn(folio) - lruvec_pgdat(lruvec)->node_start_pfn) >> shift, k->blocks);
+}
+
+void lru_cast_ring_init(struct lruvec *lruvec)
+{
+	static atomic_t next;
+
+	lruvec->lru_cast[0].tag = atomic_inc_return(&next);
+	lruvec->lru_cast[0].lid = 0;
+}
+
+/* its number back to the node; no folio is left with it */
+void lru_cast_ring_exit(struct lruvec *lruvec)
+{
+	u16 lid = lruvec->lru_cast[0].lid;
+
+	if (lid && lid != LRU_CAST_LID_SPILL)
+		clear_bit(lid, lruvec_pgdat(lruvec)->lru_cast_clock.lids);
+	lruvec->lru_cast[0].lid = 0;
+}
+
+static void lru_cast_rehome_fn(struct work_struct *work);
+static DECLARE_WORK(lru_cast_rehome_work, lru_cast_rehome_fn);
+
+/*
+ * @child's folios go to @parent's lists, with both lru_locks held: its
+ * number goes with them, marked moved, for the work to retag them by
+ */
+void lru_cast_ring_reparent(struct lruvec *child, struct lruvec *parent)
+{
+	u16 lid = child->lru_cast[0].lid;
+
+	if (!lid)
+		return;
+	child->lru_cast[0].lid = 0;
+	set_bit(lid, lruvec_pgdat(child)->lru_cast_clock.lids_moved);
+	lru_cast_queue_work(&lru_cast_rehome_work);
+}
+
+/*
+ * The folio at @pfn, if it is of M of @type: tagged as of the lruvec it is
+ * on now. Its lruvec is not known until it is held and locked.
+ */
+static void lru_cast_rehome(unsigned long pfn, int type)
+{
+	struct page *page = pfn_to_online_page(pfn);
+	struct lruvec *lruvec;
+	struct folio *folio;
+
+	if (!page || PageTail(page))
+		return;
+	folio = page_folio(page);
+	if (!folio_try_get(folio))
+		return;
+	if (folio_pfn(folio) == pfn) {
+		lruvec = folio_lruvec_lock_irq(folio);
+		if (lru_cast_on(lruvec) && folio_test_lru(folio) && folio_test_active(folio) &&
+		    !folio_test_unevictable(folio) && folio_is_file_lru(folio) == type)
+			lru_cast_m_enter(lruvec, folio, type);
+		lru_cast_lruvec_unlock_irq(lruvec);
+	}
+	folio_put(folio);
+}
+
+/*
+ * Every node's moved numbers: their folios of M retagged, then the numbers
+ * given back. A folio isolated meanwhile keeps the number until it is put
+ * back and tagged afresh; one found then by an lruvec given the number
+ * again is not its folio, and the sweep's check passes it over. A spilled
+ * lruvec moved (the shared number marked) has its folios found by the
+ * table: each is told again whose it is.
+ */
+static void lru_cast_rehome_fn(struct work_struct *work)
+{
+	DECLARE_BITMAP(moved, LRU_CAST_LIDS);
+	int nid, i;
+
+	for_each_online_node(nid) {
+		struct pglist_data *pgdat = NODE_DATA(nid);
+		unsigned long *lids = pgdat->lru_cast_clock.lids;
+		unsigned long pfn = pgdat->node_start_pfn, end = pgdat_end_pfn(pgdat);
+		unsigned long idx;
+		bool spilled;
+		void *v;
+		u32 owner;
+
+		for (i = 0; i < BITS_TO_LONGS(LRU_CAST_LIDS); i++)
+			moved[i] = xchg(&pgdat->lru_cast_clock.lids_moved[i], 0);
+		spilled = __test_and_clear_bit(LRU_CAST_LID_SPILL, moved);
+		if (!bitmap_empty(moved, LRU_CAST_LIDS)) {
+			while (pfn < end) {
+				unsigned long lim = min(end, pfn + LRU_CAST_REHOME_SCAN);
+
+				pfn = lru_cast_find_owners(pfn, lim, moved, &owner);
+				if (pfn < lim)
+					lru_cast_rehome(pfn++, owner & 1);
+				cond_resched();
+			}
+			for_each_set_bit(i, moved, LRU_CAST_LIDS)
+				clear_bit(i, lids);
+		}
+		if (spilled) {
+			xa_for_each_range(&lru_cast_spill, idx, v, pgdat->node_start_pfn, end - 1) {
+				lru_cast_rehome(idx, xa_to_value(v) & 1);
+				cond_resched();
+			}
+		}
+	}
+}
+
+/* the key of @folio, taken now; the mark comes off first (see lru_cast_record()) */
+static long lru_cast_key_now(struct folio *folio, unsigned long tick, int le)
+{
+	folio_clear_rekey(folio);
+	smp_mb__after_atomic();
+	return lru_cast_key_res(lru_cast_read(folio), tick, le, LRU_CAST_RES);
+}
+
+/*
+ * A key ranked among its equals. Folios with one key -- read
+ * in the same ticks, the same number of times -- are taken in the order a
+ * sweep meets them, a cursor's over PFNs: a clock, a folio read again
+ * since it was found skipped. Of folios read more than once that is a loop's
+ * order, and a loop over more than M is served best by keeping the same
+ * part of itself: those are ranked by a hash of the PFN, the same of them
+ * going first each time. A folio read once keeps the clock's order. The
+ * rank is the key times 2^16, plus the hash; the key is the rank >> 16.
+ */
+static long lru_cast_rank(long key, unsigned long pfn, u32 w)
+{
+	if (key == LONG_MIN)
+		return LONG_MIN;
+	return key * 65536 + ((w >> 24) >= 2 ? hash_long(pfn, 16) : 0);
+}
+
+static long lru_cast_unrank(long rank)
+{
+	return rank == LONG_MIN ? LONG_MIN : rank >> 16;
+}
+
+static void lru_cast_flush(struct lru_cast *k)
+{
+	k->ncand = k->pos = 0;
+	k->seen = 0;
+	k->tau_ok = false;
+}
+
+/* the decay changed: the keys are in other units, the candidates void */
+void lru_cast_ring_prepare(struct lruvec *lruvec, int type)
+{
+	struct lru_cast *k = &lruvec->lru_cast[type];
+	int le = lru_cast_param_le(type);
+
+	if (k->ring_le != le) {
+		lru_cast_flush(k);
+		k->ring_le = le;
+	}
+}
+
+/* a folio into M; the caller does the size accounting */
+void lru_cast_ring_put(struct lruvec *lruvec, struct folio *folio, int type)
+{
+	list_add(&folio->lru, lru_cast_m(lruvec, type));
+	lru_cast_m_enter(lruvec, folio, type);
+}
+
+/* a folio out of M: taken by reclaim, gone to W, or unevictable */
+void lru_cast_ring_out(struct folio *folio)
+{
+	if (lru_cast_spilled(lru_cast_set_owner(folio, 0)))
+		lru_cast_spill_store(folio_pfn(folio), NULL);
+}
+
+/*
+ * A newcomer from W's tail joins M. Below the lowest candidate -- below
+ * tau when there is none -- it goes in front of them; the highest
+ * candidate gives way if they are full.
+ */
+void lru_cast_ring_admit(struct lruvec *lruvec, struct folio *folio, int type)
+{
+	struct lru_cast *k = &lruvec->lru_cast[type];
+	long b = lru_cast_key_now(folio, lru_cast_tick(lruvec_pgdat(lruvec), type), k->ring_le);
+	u32 w = lru_cast_read(folio);
+	/*
+	 * Read more than once, it is ranked as M's are; read once, by its key
+	 * alone: of one key, the newcomer is the one read last.
+	 */
+	bool ranked = (w >> 24) >= 2;
+	long r = lru_cast_rank(b, folio_pfn(folio), w), x = ranked ? r : b;
+	struct lru_cast_cand *c;
+
+	list_add(&folio->lru, lru_cast_m(lruvec, type));
+	lru_cast_m_enter(lruvec, folio, type);
+	if (k->pos < k->ncand) {
+		long lo = k->cand[k->pos].key;
+
+		if (x >= (ranked ? lo : lru_cast_unrank(lo)))
+			return;
+	} else if (!k->tau_ok || x > (ranked ? k->tau : lru_cast_unrank(k->tau))) {
+		return;
+	}
+	if (k->pos == k->ncand)
+		k->pos = k->ncand = 0;
+	if (k->pos) {
+		k->pos--;
+	} else {
+		if (k->ncand < LRU_CAST_CANDS)
+			k->ncand++;
+		memmove(&k->cand[1], &k->cand[0], (k->ncand - 1) * sizeof(k->cand[0]));
+	}
+	c = &k->cand[k->pos];
+	c->pfn = folio_pfn(folio);
+	c->key = r;
+	c->word = w;
+	sw_add(SW_GATE, 1);
+}
+
+/*
+ * The candidates, a max-heap on the key, in ascending key order: the sort-down
+ * of a heapsort. The heap is already built, and sort() would call a compare
+ * function for each of the n log n steps.
+ */
+static void lru_cast_cand_sort(struct lru_cast_cand *a, unsigned int n)
+{
+	unsigned int e;
+
+	for (e = n; e-- > 1;) {
+		struct lru_cast_cand x = a[e];
+		unsigned int i = 0;
+
+		a[e] = a[0];
+		for (;;) {
+			unsigned int l = 2 * i + 1, m = l;
+
+			if (l >= e)
+				break;
+			if (l + 1 < e && a[l + 1].key > a[l].key)
+				m = l + 1;
+			if (a[m].key <= x.key)
+				break;
+			a[i] = a[m];
+			i = m;
+		}
+		a[i] = x;
+	}
+}
+
+/*
+ * The @k-th smallest of the @n keys in @a (k < n), as sort() would put it at
+ * a[k]; @a is left as it is. Only the k + 1 smallest are kept, in order.
+ */
+static long lru_cast_kth(const long *a, unsigned int n, unsigned int k)
+{
+	long t[((LRU_CAST_SAMPLES - 1) >> LRU_CAST_TAU_SHIFT) + 1];
+	unsigned int i, j, m = 0;
+
+	for (i = 0; i < n; i++) {
+		long v = a[i];
+
+		if (m > k && v >= t[k])
+			continue;
+		j = m < k + 1 ? m++ : k;
+		for (; j && t[j - 1] > v; j--)
+			t[j] = t[j - 1];
+		t[j] = v;
+	}
+	return t[k];
+}
+
+/* the candidates as a max-heap on the key: one more in, the highest out if full */
+static void lru_cast_heap_put(struct lru_cast *k, unsigned long pfn, long key, u32 word)
+{
+	struct lru_cast_cand *h = k->cand, x = { pfn, key, word };
+	unsigned int i, n = k->ncand;
+
+	if (n < LRU_CAST_CANDS) {
+		for (i = k->ncand++; i && h[(i - 1) / 2].key < key; i = (i - 1) / 2)
+			h[i] = h[(i - 1) / 2];
+		h[i] = x;
+		return;
+	}
+	if (key >= h[0].key)
+		return;
+	for (i = 0;;) {
+		unsigned int l = 2 * i + 1, m = l;
+
+		if (l >= n)
+			break;
+		if (l + 1 < n && h[l + 1].key > h[l].key)
+			m = l + 1;
+		if (h[m].key <= key)
+			break;
+		h[i] = h[m];
+		i = m;
+	}
+	h[i] = x;
+}
+
+/* is the page at @pfn the head of a folio of M of @lruvec, as far as its flags tell */
+static struct page *lru_cast_m_page(struct lruvec *lruvec, int type, unsigned long pfn)
+{
+	struct page *page = pfn_to_online_page(pfn);
+	unsigned long flags;
+
+	if (!page || PageTail(page))
+		return NULL;
+	flags = lru_cast_page_flags(page);
+	if (!(flags & BIT(PG_lru)) || !(flags & BIT(PG_active)) || (flags & BIT(PG_unevictable)))
+		return NULL;
+	if ((int)!(flags & BIT(PG_swapbacked)) != type)	/* a file folio is not swap-backed */
+		return NULL;
+#ifdef CONFIG_MEMCG
+	if (!lru_cast_page_memcg_is(page, lruvec_memcg(lruvec)))
+		return NULL;
+#endif
+	return page;
+}
+
+static u32 lru_cast_rnd(struct lru_cast *k)
+{
+	k->rnd = k->rnd * 1664525 + 1013904223;
+	return k->rnd;
+}
+
+/*
+ * tau with no pass read yet: the keys of folios of @lruvec's M of @type
+ * at frames drawn at random from the blocks that may hold them, each frame
+ * of those blocks as likely, so each folio of M as likely. The pass then
+ * samples afresh.
+ */
+static void lru_cast_tau_probe(struct lruvec *lruvec, int type, unsigned int shift,
+			    unsigned long tick, int le)
+{
+	struct lru_cast *k = &lruvec->lru_cast[type];
+	struct pglist_data *pgdat = lruvec_pgdat(lruvec);
+	unsigned long start = pgdat->node_start_pfn, end = pgdat_end_pfn(pgdat);
+	unsigned int nb = min_t(unsigned long, LRU_CAST_BLOCKS, ((end - start - 1) >> shift) + 1);
+	u32 owner = lru_cast_owner(lruvec, type);
+	unsigned int i, n = 0;
+
+	for (i = 0; i < LRU_CAST_PROBES && n < LRU_CAST_SAMPLES; i++) {
+		unsigned int b = ((u64)lru_cast_rnd(k) * nb) >> 32;
+		unsigned long pfn = start + ((unsigned long)b << shift) +
+				    (lru_cast_rnd(k) & ((1UL << shift) - 1));
+		u32 w;
+
+		if (!test_bit(b, k->blocks) || pfn >= end ||
+		    lru_cast_find_owner(pfn, pfn + 1, owner, &w) != pfn || !(w >> 24))
+			continue;
+		if (lru_cast_spilled(owner) && !lru_cast_spill_ours(pfn, lruvec, type))
+			continue;
+		k->sample[n++] = lru_cast_rank(lru_cast_key_res(w, tick, le, LRU_CAST_RES), pfn, w);
+	}
+	k->seen = 0;
+	if (n < LRU_CAST_PROBE_MIN)
+		return;
+	k->tau = lru_cast_kth(k->sample, n, (n - 1) >> LRU_CAST_TAU_SHIFT);
+	k->tau_ok = true;
+	sw_add(SW_PROBED, 1);
+}
+
+static void lru_cast_sweep(struct lruvec *lruvec, int type)
+{
+	struct lru_cast *k = &lruvec->lru_cast[type];
+	struct pglist_data *pgdat = lruvec_pgdat(lruvec);
+	unsigned long start = pgdat->node_start_pfn, end = pgdat_end_pfn(pgdat);
+	unsigned long tick = lru_cast_tick(pgdat, type), frames = 0, words = 0;
+	u32 owner = lru_cast_owner(lruvec, type);
+	bool spilled = lru_cast_spilled(owner);
+	unsigned int shift = lru_cast_blocks(lruvec, k), nb = LRU_CAST_BLOCKS;
+	long clean = -1;			/* a block read from its start, none found yet */
+	int le = k->ring_le, wraps = 0;
+
+	k->ncand = k->pos = 0;
+	if (end <= start)
+		return;
+	if (k->cursor < start || k->cursor > end)
+		k->cursor = start;
+	if (!k->tau_ok)
+		lru_cast_tau_probe(lruvec, type, shift, tick, le);
+	for (;;) {
+		unsigned long pfn, budget = k->ncand ? LRU_CAST_SWEEP_MAX : LRU_CAST_SWEEP_EMPTY;
+		long key;
+		u32 w;
+
+		if (frames >= budget)
+			break;
+		if (k->tau_ok && k->ncand == LRU_CAST_CANDS && k->cand[0].key <= k->tau)
+			break;
+		if (k->cursor >= end) {			/* a pass ends: tau from its keys */
+			if (++wraps > 2)		/* no block left that may hold M */
+				break;
+			k->cursor = start;
+			if (k->seen) {
+				unsigned int m = min_t(unsigned long, k->seen, LRU_CAST_SAMPLES);
+
+				k->tau = lru_cast_kth(k->sample, m, (m - 1) >> LRU_CAST_TAU_SHIFT);
+				k->tau_ok = true;
+				k->seen = 0;
+			}
+		}
+		{
+			unsigned long b = (k->cursor - start) >> shift, bstart, bend, lim;
+
+			if (!test_bit(b, k->blocks)) {	/* none of M there: the next block that may */
+				b = find_next_bit(k->blocks, nb, b);
+				k->cursor = b >= nb ? end : start + (b << shift);
+				continue;
+			}
+			bstart = start + (b << shift);
+			bend = min(end, bstart + (1UL << shift));
+			if (k->cursor == bstart)
+				clean = b;
+			lim = min(bend, k->cursor + budget - frames);
+			pfn = lru_cast_find_owner_inl(k->cursor, lim, owner, &w);
+			frames += pfn - k->cursor;
+			k->cursor = pfn;
+			if (pfn >= lim) {
+				if (lim == bend && clean == b)
+					__clear_bit(b, k->blocks);
+				continue;
+			}
+			if (spilled && !lru_cast_spill_ours(pfn, lruvec, type)) {
+				k->cursor++;		/* another spilled lruvec's */
+				frames++;
+				continue;
+			}
+			clean = -1;
+		}
+		k->cursor++;
+		frames++;
+		if (!(w >> 24))
+			continue;
+		words++;
+		key = lru_cast_rank(lru_cast_key_res_inl(w, tick, le, LRU_CAST_RES), pfn, w);
+		/* a reservoir sample of the pass's keys */
+		if (k->seen < LRU_CAST_SAMPLES) {
+			k->sample[k->seen] = key;
+		} else {
+			u64 r = (u64)lru_cast_rnd(k) * (k->seen + 1) >> 32;
+
+			if (r < LRU_CAST_SAMPLES)
+				k->sample[r] = key;
+		}
+		k->seen++;
+		lru_cast_heap_put(k, pfn, key, w);
+	}
+	lru_cast_cand_sort(k->cand, k->ncand);
+	sw_add(SW_SWEEPS, 1);
+	sw_add(SW_FRAMES, frames);
+	sw_add(SW_WORDS, words);
+}
+
+/*
+ * The candidates asked next pulled in (core/prefetch.h): the one l3 past
+ * @pos toward L3, the one l1 past it on to L1; with @all, every one up to
+ * them, as a sweep has just found them.
+ */
+static void lru_cast_cand_ahead(struct lru_cast *k, unsigned int pos, bool all)
+{
+	unsigned int l3 = READ_ONCE(lru_cast_pf_l3), l1 = READ_ONCE(lru_cast_pf_l1), i;
+
+	if (all) {
+		for (i = pos; i < min(pos + l3, k->ncand); i++)
+			lru_cast_prefetch_frame(k->cand[i].pfn, i < pos + l1);
+		return;
+	}
+	if (l3 && pos + l3 < k->ncand)
+		lru_cast_prefetch_frame(k->cand[pos + l3].pfn, false);
+	if (l1 && pos + l1 < k->ncand)
+		lru_cast_prefetch_frame(k->cand[pos + l1].pfn, true);
+}
+
+/* the folio of candidate @c if it is still of M here and not read since */
+static struct folio *lru_cast_cand_folio(struct lruvec *lruvec, int type, struct lru_cast_cand *c)
+{
+	struct page *page = lru_cast_m_page(lruvec, type, c->pfn);
+	struct folio *folio;
+
+	if (!page)
+		return NULL;
+	folio = page_folio(page);
+	if (&folio->page != page || lru_cast_read_pfn(c->pfn) != c->word)
+		return NULL;
+	/* PG_lru under this lru_lock, of this memcg and node: on this lruvec's M */
+	return folio;
+}
+
+/*
+ * M's lowest folio, and its key; taken off the candidates. When the
+ * candidates run out, a sweep; when it finds none, M's oldest-added folio.
+ */
+struct folio *lru_cast_ring_min(struct lruvec *lruvec, int type, long *bucket)
+{
+	struct lru_cast *k = &lruvec->lru_cast[type];
+	struct list_head *m = lru_cast_m(lruvec, type);
+	struct folio *folio;
+	bool swept = false;
+
+	if (list_empty(m))
+		return NULL;
+	for (;;) {
+		while (k->pos < k->ncand) {
+			struct lru_cast_cand *c = &k->cand[k->pos++];
+
+			lru_cast_cand_ahead(k, k->pos - 1, false);
+			folio = lru_cast_cand_folio(lruvec, type, c);
+			if (folio) {
+				*bucket = lru_cast_unrank(c->key);
+				sw_add(SW_TAKEN, 1);
+				return folio;
+			}
+			sw_add(SW_STALE, 1);
+		}
+		if (swept)
+			break;
+		lru_cast_sweep(lruvec, type);
+		lru_cast_cand_ahead(k, 0, true);
+		swept = true;
+	}
+	sw_add(SW_FALLBACK, 1);
+	folio = lru_to_folio(m);
+	*bucket = lru_cast_key_now(folio, lru_cast_tick(lruvec_pgdat(lruvec), type), k->ring_le);
+	return folio;
+}
+
+int lru_cast_sweep_show(char *buf)
+{
+	unsigned long n[SW_NR] = { 0 };
+	int cpu, i;
+
+	for_each_possible_cpu(cpu)
+		for (i = 0; i < SW_NR; i++)
+			n[i] += per_cpu(lru_cast_sw, cpu)[i];
+	return sysfs_emit(buf, "sweeps %lu frames %lu words %lu taken %lu stale %lu gate %lu fallback %lu spilled %lu probed %lu\n",
+			  n[SW_SWEEPS], n[SW_FRAMES], n[SW_WORDS], n[SW_TAKEN], n[SW_STALE],
+			  n[SW_GATE], n[SW_FALLBACK], n[SW_SPILLED], n[SW_PROBED]);
+}
+
+/*
+ * lruvec_add_folio(), on an lruvec CAST runs: an active folio goes into
+ * M; the rest into W, the inactive list, after which W's excess over its
+ * share, once more than a slack, joins M (lru_cast_w_admit()). A folio new to
+ * the cache had its entry counted in folio_add_lru() (lru_cast_enter()),
+ * before the lock: this runs under it, for every folio the LRU takes in.
+ */
+bool __lru_cast_add_folio(struct lruvec *lruvec, struct folio *folio, bool tail)
+{
+	if (folio_test_unevictable(folio)) {
+		lru_cast_ring_out(folio);
+		return false;
+	}
+	if (!folio_test_active(folio)) {
+		enum lru_list lru = folio_lru_list(folio);
+		int type = folio_is_file_lru(folio);
+		struct lru_cast *k = &lruvec->lru_cast[type];
+		unsigned long nr_w, nr_m, nr = folio_nr_pages(folio);
+
+		folio_set_rekey(folio);		/* W's: never placed by a key */
+		lru_cast_ring_out(folio);		/* deactivated: no longer of M */
+		lru_cast_update_lru_size(lruvec, lru, folio_zonenum(folio), nr);
+		if (tail)
+			list_add_tail(&folio->lru, &lruvec->lists[lru]);
+		else
+			list_add(&folio->lru, &lruvec->lists[lru]);
+		/*
+		 * W kept to its share as it fills, not only once reclaim runs.
+		 * Its size, summed over the zones on lines every CPU adding to
+		 * the LRU writes, is looked at only once the room left the
+		 * last time is used: W gains only here, so it is over its share
+		 * by more than the slack no sooner. The room is a slack at
+		 * most, so that a share made smaller is caught up with soon.
+		 */
+		k->w_room -= nr;
+		if (k->w_room > 0)
+			return true;
+		nr_w = lru_cast_lru_size(lruvec, lru);
+		nr_m = lru_cast_lru_size(lruvec, lru + LRU_ACTIVE);
+		lru_cast_w_admit(lruvec, type, &nr_w, &nr_m, LRU_CAST_W_SLACK,
+				 LRU_CAST_W_SLACK + nr);
+		k->w_room = clamp_t(long, (nr_w + nr_m) * lru_cast_param_w(type) / 1000 +
+				    LRU_CAST_W_SLACK - nr_w, 1, LRU_CAST_W_SLACK);
+		return true;
+	}
+	lru_cast_update_lru_size(lruvec, folio_lru_list(folio), folio_zonenum(folio),
+			      folio_nr_pages(folio));
+	lru_cast_ring_put(lruvec, folio, folio_is_file_lru(folio));
+	return true;
+}
+
+void lru_cast_ring_reset(struct lruvec *lruvec)
+{
+	int type;
+
+	for (type = 0; type < ANON_AND_FILE; type++) {
+		struct lru_cast *k = &lruvec->lru_cast[type];
+
+		lru_cast_flush(k);
+		k->cursor = 0;
+		k->rnd = type + 1;
+		k->block_shift = 0;		/* the blocks drawn on first use, all set */
+		k->ring_le = -1;		/* set on first use */
+		k->w_room = 0;			/* W's size looked at on first use */
+		k->victim = LONG_MIN;
+	}
+}
