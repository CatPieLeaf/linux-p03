@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* CAST -- what a refault costs, per type (cost.c) */
+#ifndef _MM_LRU_CAST_TUNE_COST_H
+#define _MM_LRU_CAST_TUNE_COST_H
+
+#include "tune/shape.h"
+
+void lru_cast_tune_cost_gather(void);
+void lru_cast_tune_cost_reset(void);
+void lru_cast_tune_weights(u64 *wa, u64 *wf);
+
+#endif /* _MM_LRU_CAST_TUNE_COST_H */
diff --git a/mm/lru_cast/tune/decay.c b/mm/lru_cast/tune/decay.c
new file mode 100644
index 0000000000..3ba561fbae
--- /dev/null
+++ b/mm/lru_cast/tune/decay.c
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the decay: the half-life a type's keys decay with,
+ * H = C * 2^(8 - le), chosen by measuring.
+ *
+ * The grid's caches run at le at the centre and +-1, 2, 4, 8 from it. Per
+ * point, its misses and the accesses on which it and the centre disagree
+ * (one hits, the other misses). A point whose misses are below the
+ * centre's by more than twice the square root of the disagreements is
+ * better at 2 sigma -- a sign test: on a disagreement each is as likely to
+ * be the one that missed if neither is better. Of those, the centre moves
+ * to the one that gains most; the grid moves with it, a new point starting
+ * from the nearest old one, and the main cache takes the new le.
+ */
+#include "tune/decay.h"
+
+static const int lru_cast_tune_off[LRU_CAST_TUNE_DECAY] = { -8, -4, -2, -1, 0, 1, 2, 4, 8 };
+
+/* every cache's le about @centre, each its own: the grid as it starts */
+void lru_cast_tune_decay_grid(int centre, int *le, int *src)
+{
+	int m;
+
+	for (m = 0; m < LRU_CAST_TUNE_DECAY; m++)
+		le[m] = clamp(centre + lru_cast_tune_off[m], LRU_CAST_LE_MIN, LRU_CAST_LE_MAX);
+	for (m = LRU_CAST_TUNE_WLO; m < LRU_CAST_TUNE_SIM; m++)
+		le[m] = centre;
+	for (m = 0; m < LRU_CAST_TUNE_SIM; m++)
+		src[m] = m;
+}
+
+/* the grid moved to @centre, each point from the nearest old one */
+void lru_cast_tune_decay_regrid(struct lru_cast_tune_sim *sim, int centre, int *le, int *src)
+{
+	int m, i;
+
+	for (m = 0; m < LRU_CAST_TUNE_DECAY; m++) {
+		int best = 0, d, bd = INT_MAX;
+
+		le[m] = clamp(centre + lru_cast_tune_off[m], LRU_CAST_LE_MIN, LRU_CAST_LE_MAX);
+		for (i = 0; i < LRU_CAST_TUNE_DECAY; i++) {
+			d = abs(lru_cast_tune_sim_le(sim, i) - le[m]);
+			if (d < bd) {
+				bd = d;
+				best = i;
+			}
+		}
+		src[m] = best;
+	}
+	/* the w pair at the new decay; the order follows the centre */
+	for (m = LRU_CAST_TUNE_WLO; m < LRU_CAST_TUNE_SIM; m++) {
+		le[m] = centre;
+		src[m] = m;
+	}
+}
+
+/* the point better than the centre at 2 sigma that gains most, or -1 */
+int lru_cast_tune_decay_choose(const struct lru_cast_tune_evidence *ev,
+			       struct lru_cast_tune_sim *sim)
+{
+	int c = lru_cast_tune_sim_le(sim, LRU_CAST_TUNE_CENTER), m, best = -1;
+	s64 best_gain = 0;
+
+	for (m = 0; m < LRU_CAST_TUNE_DECAY; m++) {
+		s64 gain = ev->miss[LRU_CAST_TUNE_CENTER] - ev->miss[m];
+
+		/* gain > 2 sqrt(dis), all in 1/256: gain^2 > 1024 dis */
+		if (m != LRU_CAST_TUNE_CENTER && lru_cast_tune_sim_le(sim, m) != c &&
+		    gain > best_gain &&
+		    (u64)gain * gain > 1024 * (u64)ev->dis[m]) {
+			best_gain = gain;
+			best = m;
+		}
+	}
+	return best;
+}
diff --git a/mm/lru_cast/tune/decay.h b/mm/lru_cast/tune/decay.h
new file mode 100644
index 0000000000..c2c68b8b12
--- /dev/null
+++ b/mm/lru_cast/tune/decay.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* CAST -- the decay controller (decay.c) */
+#ifndef _MM_LRU_CAST_TUNE_DECAY_H
+#define _MM_LRU_CAST_TUNE_DECAY_H
+
+#include "tune/evidence.h"
+#include "tune/sim.h"
+
+void lru_cast_tune_decay_grid(int centre, int *le, int *src);
+void lru_cast_tune_decay_regrid(struct lru_cast_tune_sim *sim, int centre, int *le, int *src);
+int lru_cast_tune_decay_choose(const struct lru_cast_tune_evidence *ev,
+			       struct lru_cast_tune_sim *sim);
+
+#endif /* _MM_LRU_CAST_TUNE_DECAY_H */
diff --git a/mm/lru_cast/tune/evidence.c b/mm/lru_cast/tune/evidence.c
new file mode 100644
index 0000000000..fb52502070
--- /dev/null
+++ b/mm/lru_cast/tune/evidence.c
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the evidence the controllers decide on.
+ *
+ * The decay grid's and W's caches keep none while they fill: they differ
+ * only once they evict. The curve's points are read from the order's
+ * ranks, not from those caches, and keep theirs from the first read: a
+ * type whose sample never fills its cache -- a few pages read all the
+ * time, a program's text -- would otherwise wait at no split, and the
+ * share would give its memory away for nothing.
+ *
+ * What a type's caches are weighed by against each other -- the decay
+ * grid's and W's -- decays by 1/16 an evaluation of the type, a time
+ * constant of about one cache of its accesses. What the share weighs the
+ * two types by -- the curve, its patterns and a cache of nothing's waits --
+ * cannot: the types read at their own rates, and a count over the last
+ * cache of each type's accesses is a count over a time of its own. Anon
+ * read a hundred times as often as file would be weighed over a hundredth
+ * of the time, its misses as if a hundredth as many. The curve's evidence
+ * is a count over one time for both types: it ages on the clock both share
+ * (lru_cast_tune_ev_age()), a cache's worth of what memory takes in.
+ */
+#include "tune/evidence.h"
+
+void lru_cast_tune_ev_reset(struct lru_cast_tune_evidence *ev)
+{
+	memset(ev, 0, sizeof(*ev));
+}
+
+/*
+ * An access of the sample: @hit, the caches it hit in; @wait, the curve's
+ * points it costs a wait at (bit p: p tenths, bit 0 a cache of nothing);
+ * @full, the caches full. A decay or W cache waits on every miss; the
+ * curve's on the misses readahead did not cover.
+ */
+void lru_cast_tune_ev_note(struct lru_cast_tune_evidence *ev, const bool *hit, u16 wait, bool full)
+{
+	int m;
+
+	if (wait & 1)
+		ev->evd += 256;
+	for (m = full ? 0 : LRU_CAST_TUNE_CURVE; m < LRU_CAST_TUNE_N; m++) {
+		bool waits = m < LRU_CAST_TUNE_CURVE ? !hit[m] :
+			     wait & BIT(m - LRU_CAST_TUNE_CURVE + 1);
+
+		if (waits)
+			ev->miss[m] += 256;
+		if (hit[m] != hit[LRU_CAST_TUNE_CENTER])
+			ev->dis[m] += 256;
+	}
+	ev->pat[wait] += 256;
+	__set_bit(wait, ev->pats);
+}
+
+/* the decay grid's and W's evidence, by 1/16: an evaluation of the type */
+void lru_cast_tune_ev_decay(struct lru_cast_tune_evidence *ev)
+{
+	int m;
+
+	for (m = 0; m < LRU_CAST_TUNE_CURVE; m++) {
+		ev->miss[m] -= ev->miss[m] >> 4;
+		ev->dis[m] -= ev->dis[m] >> 4;
+	}
+}
+
+/* the curve's evidence, by 1 / 2^LRU_CAST_TUNE_AGE_SHIFT: a step of the time both types share */
+void lru_cast_tune_ev_age(struct lru_cast_tune_evidence *ev)
+{
+	unsigned int p;
+	int m;
+
+	for (m = LRU_CAST_TUNE_CURVE; m < LRU_CAST_TUNE_N; m++) {
+		ev->miss[m] -= ev->miss[m] >> LRU_CAST_TUNE_AGE_SHIFT;
+		ev->dis[m] -= ev->dis[m] >> LRU_CAST_TUNE_AGE_SHIFT;
+	}
+	ev->evd -= ev->evd >> LRU_CAST_TUNE_AGE_SHIFT;
+	for_each_set_bit(p, ev->pats, LRU_CAST_TUNE_PATS) {
+		ev->pat[p] -= ev->pat[p] >> LRU_CAST_TUNE_AGE_SHIFT;
+		if (!ev->pat[p])
+			__clear_bit(p, ev->pats);
+	}
+}
+
+/*
+ * The decay grid and the W pair moved (lru_cast_tune_sim_regrid()): what they showed
+ * was of caches no longer there. The curve's points keep their counts:
+ * they take the new le together and are weighed only against each other
+ * (with evd and pat, which stay too), and what they learnt under the old
+ * one fades as the rest of the curve's evidence does. Zeroed, they would
+ * sit at nothing next to evd's and pat's counts, and a split would look
+ * free of the type's misses until they filled again.
+ */
+void lru_cast_tune_ev_forget_grid(struct lru_cast_tune_evidence *ev)
+{
+	int m;
+
+	for (m = 0; m < LRU_CAST_TUNE_CURVE; m++)
+		ev->miss[m] = ev->dis[m] = 0;
+}
+
+/* the accesses on which the curve's points @i and @j disagree, in 1/256 */
+u64 lru_cast_tune_ev_pdis(const struct lru_cast_tune_evidence *ev, int i, int j)
+{
+	u64 sum = 0;
+	unsigned int p;
+
+	for_each_set_bit(p, ev->pats, LRU_CAST_TUNE_PATS)
+		if (!(p & BIT(i)) != !(p & BIT(j)))
+			sum += ev->pat[p];
+	return sum;
+}
diff --git a/mm/lru_cast/tune/evidence.h b/mm/lru_cast/tune/evidence.h
new file mode 100644
index 0000000000..9aa141ad0e
--- /dev/null
+++ b/mm/lru_cast/tune/evidence.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST -- what the controllers decide on (evidence.c): per cache of
+ * a type's sample its waits and its disagreements with the decay grid's
+ * centre, and the patterns of the curve's waits; all in 1/256, decaying
+ * together.
+ */
+#ifndef _MM_LRU_CAST_TUNE_EVIDENCE_H
+#define _MM_LRU_CAST_TUNE_EVIDENCE_H
+
+#include "tune/shape.h"
+
+#define LRU_CAST_TUNE_PATS		(1 << (LRU_CAST_TUNE_SHARES + 1))
+
+/*
+ * The curve's evidence ages by 1/4 a tick, C/4 of what memory takes in:
+ * at the rate the cache turns over, a time constant of about one cache's
+ * worth. And by as much while it holds over LRU_CAST_TUNE_HELD accesses of
+ * both types, as the share's test can take in 64 bits (share.c): a
+ * weight of 16 bits squared, times the disagreements in 1/256.
+ */
+#define LRU_CAST_TUNE_AGE_SHIFT	2
+#define LRU_CAST_TUNE_HELD	(1L << 20)
+
+struct lru_cast_tune_evidence {
+	s64 miss[LRU_CAST_TUNE_N];		/* the accesses cache m waited for */
+	s64 dis[LRU_CAST_TUNE_N];		/* ... on which it and the centre disagree */
+	s64 evd;		/* the waits of a cache of nothing */
+	/*
+	 * The accesses by which of the curve's points (bit p: p tenths) they
+	 * cost a wait at. Two points disagree on an access when one bit is
+	 * set and the other not: their disagreements, lru_cast_tune_ev_pdis(), are a sum
+	 * over the patterns seen -- a dozen or so, the curve nesting almost
+	 * always -- where counting them per pair would be 55 counts for
+	 * every access.
+	 */
+	s32 pat[LRU_CAST_TUNE_PATS];
+	DECLARE_BITMAP(pats, LRU_CAST_TUNE_PATS);
+};
+
+void lru_cast_tune_ev_reset(struct lru_cast_tune_evidence *ev);
+void lru_cast_tune_ev_note(struct lru_cast_tune_evidence *ev, const bool *hit, u16 wait, bool full);
+void lru_cast_tune_ev_decay(struct lru_cast_tune_evidence *ev);
+void lru_cast_tune_ev_age(struct lru_cast_tune_evidence *ev);
+void lru_cast_tune_ev_forget_grid(struct lru_cast_tune_evidence *ev);
+u64 lru_cast_tune_ev_pdis(const struct lru_cast_tune_evidence *ev, int i, int j);
+
+#endif /* _MM_LRU_CAST_TUNE_EVIDENCE_H */
diff --git a/mm/lru_cast/tune/protect.c b/mm/lru_cast/tune/protect.c
new file mode 100644
index 0000000000..e4a28303fd
--- /dev/null
+++ b/mm/lru_cast/tune/protect.c
@@ -0,0 +1,236 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- catching every read of a sampled mapped page.
+ *
+ * The decay controller's simulated caches need the true reference stream
+ * of the sampled pages (tune.c). A read of a page mapped in a process is
+ * invisible to the kernel while the page is resident: the CPU only sets the
+ * young bit. So the sampled pages' PTEs are made PROT_NONE, the way NUMA
+ * balancing marks pages for its hinting faults; the next access faults, and
+ * do_numa_page() hands the fault here (lru_cast_protfault()): one read of
+ * the page for the simulated caches, the PTE made accessible again, and the
+ * page queued to be protected again.
+ *
+ * Protecting again is lazy and batched: the queue is worked through once
+ * the clock has moved by delta = 1/1024 of the node's pages since the last
+ * time (about 20 ms at 100k pages taken in a second with C = 2M), and
+ * only the pages that faulted in between -- or had a read recorded by the
+ * main cache -- are in it. The TLB is flushed once a batch, per mm, not per
+ * page: a flush per page was an IPI per page to the CPUs running the mm.
+ * Until the flush a stale entry lets a read through without its fault, one
+ * read the sample misses; and the rest of the kernel must know the entry
+ * may be there. A PROT_NONE PTE is taken as cached only while its mm has a
+ * flush pending (pte_accessible()): unmapped without, by reclaim or
+ * migration, the page would be freed with no flush and read on through
+ * the stale entry by its next owner's data. So the batch holds each mm's
+ * tlb_flush_pending raised from before its first PTE is made PROT_NONE
+ * until its flush, as change_protection() does for NUMA balancing. A page
+ * touched again within delta faults once: the model's finding is that this
+ * loses nothing, and it keeps the faults to about 0.6% of accesses.
+ *
+ * Only while NUMA balancing is off -- a single node, or switched off: then
+ * every hinting fault is CAST's. With it on, no page is protected and the
+ * simulated caches see what the main cache sees. Not protected either:
+ * KSM pages, PMD-mapped THPs, hugetlb and special mappings.
+ */
+#include <linux/rmap.h>
+#include <linux/hugetlb.h>
+#include <linux/sysfs.h>
+#include <linux/workqueue.h>
+#include <asm/tlbflush.h>
+#include "tune/tune.h"
+
+#define LRU_CAST_PROT_QUEUE	4096
+
+static DEFINE_SPINLOCK(lru_cast_prot_lock);
+static unsigned long lru_cast_prot_queue[2][LRU_CAST_PROT_QUEUE];
+static unsigned int lru_cast_prot_len, lru_cast_prot_cur;
+static long lru_cast_prot_installed, lru_cast_prot_next;	/* the clock, net, as told */
+/* PTEs protected, and protection faults taken */
+static atomic_long_t lru_cast_prot_armed, lru_cast_prot_faults;
+
+/* the mms a batch armed PTEs in, to be flushed once at its end */
+#define LRU_CAST_PROT_MMS	8
+struct lru_cast_prot_flush {
+	struct mm_struct *mm[LRU_CAST_PROT_MMS];
+	int n;
+};
+
+/* each mm flushed, and only then its flush no longer pending */
+static void lru_cast_prot_flush_all(struct lru_cast_prot_flush *f)
+{
+	while (f->n) {
+		struct mm_struct *mm = f->mm[--f->n];
+
+		flush_tlb_mm(mm);
+		dec_tlb_flush_pending(mm);
+		mmdrop(mm);
+	}
+}
+
+static bool lru_cast_prot_flush_has(struct lru_cast_prot_flush *f, struct mm_struct *mm)
+{
+	int i;
+
+	for (i = 0; i < f->n; i++)
+		if (f->mm[i] == mm)
+			return true;
+	return false;
+}
+
+/* room for @mm, the others flushed if there is none: before the PTL is taken */
+static void lru_cast_prot_flush_room(struct lru_cast_prot_flush *f, struct mm_struct *mm)
+{
+	if (f->n == LRU_CAST_PROT_MMS && !lru_cast_prot_flush_has(f, mm))
+		lru_cast_prot_flush_all(f);
+}
+
+/* @mm's flush pending, before the first of its PTEs is made PROT_NONE */
+static void lru_cast_prot_flush_add(struct lru_cast_prot_flush *f, struct mm_struct *mm)
+{
+	if (lru_cast_prot_flush_has(f, mm))
+		return;
+	mmgrab(mm);
+	inc_tlb_flush_pending(mm);
+	f->mm[f->n++] = mm;
+}
+
+static void lru_cast_prot_workfn(struct work_struct *work);
+static DECLARE_WORK(lru_cast_prot_work, lru_cast_prot_workfn);
+
+bool lru_cast_protect_active(void)
+{
+	return lru_cast_numa_hinting_free();
+}
+
+/* @folio, sampled, is to be protected (again) at the next boundary */
+void lru_cast_protect_queue(struct folio *folio)
+{
+	unsigned long flags;
+
+	if (!lru_cast_protect_active())
+		return;
+	spin_lock_irqsave(&lru_cast_prot_lock, flags);
+	if (lru_cast_prot_len < LRU_CAST_PROT_QUEUE)
+		lru_cast_prot_queue[lru_cast_prot_cur][lru_cast_prot_len++] = folio_pfn(folio);
+	spin_unlock_irqrestore(&lru_cast_prot_lock, flags);
+}
+
+/* the clock moved by @nr pages taken in, of @size: past a boundary, protect */
+void lru_cast_protect_installed(long nr, unsigned long size)
+{
+	data_race(lru_cast_prot_installed += nr);
+	if (data_race(lru_cast_prot_installed) < data_race(lru_cast_prot_next))
+		return;
+	data_race(lru_cast_prot_next = lru_cast_prot_installed + (long)max(size / 1024, 32UL));
+	if (READ_ONCE(lru_cast_prot_len) && lru_cast_protect_active())
+		lru_cast_queue_work(&lru_cast_prot_work);
+}
+
+static bool lru_cast_prot_arm_one(struct folio *folio, struct vm_area_struct *vma,
+		       unsigned long address, void *arg)
+{
+	DEFINE_FOLIO_VMA_WALK(pvmw, folio, vma, address, 0);
+	struct mmu_notifier_range range;
+	bool armed = false;
+
+	if (!vma_is_accessible(vma) || is_vm_hugetlb_page(vma) ||
+	    (vma->vm_flags & (VM_IO | VM_PFNMAP | VM_MIXEDMAP)))
+		return true;
+
+	lru_cast_prot_flush_room(arg, vma->vm_mm);
+	lru_cast_mmu_range_init(&range, vma->vm_mm, address,
+			     min(vma->vm_end, address + folio_size(folio)));
+	mmu_notifier_invalidate_range_start(&range);
+	while (page_vma_mapped_walk(&pvmw)) {
+		pte_t old, new;
+
+		if (!pvmw.pte)			/* PMD-mapped: not protected */
+			continue;
+		old = ptep_get(pvmw.pte);
+		if (!pte_present(old) || pte_protnone(old))
+			continue;
+		if (!armed)	/* under the PTL, before the PTE changes: inc_tlb_flush_pending() */
+			lru_cast_prot_flush_add(arg, vma->vm_mm);
+		old = ptep_modify_prot_start(vma, pvmw.address, pvmw.pte);
+		new = pte_modify(old, PAGE_NONE);
+		ptep_modify_prot_commit(vma, pvmw.address, pvmw.pte, old, new);
+		atomic_long_inc(&lru_cast_prot_armed);
+		armed = true;
+	}
+	mmu_notifier_invalidate_range_end(&range);
+	return true;
+}
+
+static void lru_cast_prot_arm_pfn(unsigned long pfn, struct lru_cast_prot_flush *f)
+{
+	struct rmap_walk_control rwc = {
+		.rmap_one = lru_cast_prot_arm_one,
+		.arg = f,
+		.try_lock = true,
+	};
+	struct page *page = pfn_to_online_page(pfn);
+	struct folio *folio;
+
+	if (!page)
+		return;
+	folio = page_folio(page);
+	if (!folio_try_get(folio))
+		return;
+	if (unlikely(page_folio(page) != folio) || !folio_test_lru(folio) ||
+	    !folio_mapped(folio) || folio_test_ksm(folio) ||
+	    folio_is_zone_device(folio) || !lru_cast_tune_sampled(folio))
+		goto put;
+	if (!folio_trylock(folio))
+		goto put;
+	rmap_walk(folio, &rwc);
+	folio_unlock(folio);
+put:
+	folio_put(folio);
+}
+
+static void lru_cast_prot_workfn(struct work_struct *work)
+{
+	struct lru_cast_prot_flush f = { .n = 0 };
+	unsigned int n, i, b;
+
+	spin_lock_irq(&lru_cast_prot_lock);
+	b = lru_cast_prot_cur;
+	n = lru_cast_prot_len;
+	lru_cast_prot_cur ^= 1;
+	lru_cast_prot_len = 0;
+	spin_unlock_irq(&lru_cast_prot_lock);
+
+	for (i = 0; i < n; i++) {
+		if (!lru_cast_enabled() || !lru_cast_protect_active())
+			break;
+		lru_cast_prot_arm_pfn(lru_cast_prot_queue[b][i], &f);
+		if (!(i & 63))
+			cond_resched();
+	}
+	lru_cast_prot_flush_all(&f);
+}
+
+/*
+ * do_numa_page(), with the PTE lock held: a hinting fault. CAST's while
+ * NUMA balancing is off -- a read of a sampled page for the simulated
+ * caches, the page to be protected again -- and the caller only makes the
+ * PTE accessible. True if it was CAST's.
+ */
+bool lru_cast_protfault(struct folio *folio)
+{
+	if (!lru_cast_enabled() || !lru_cast_protect_active())
+		return false;
+	atomic_long_inc(&lru_cast_prot_faults);
+	lru_cast_tune_read(folio);
+	lru_cast_protect_queue(folio);
+	return true;
+}
+
+int lru_cast_protect_show(char *buf, int len)
+{
+	return len + sysfs_emit_at(buf, len, "protect %s armed %ld faults %ld\n",
+				   lru_cast_protect_active() ? "on" : "off",
+				   atomic_long_read(&lru_cast_prot_armed),
+			   atomic_long_read(&lru_cast_prot_faults));
+}
diff --git a/mm/lru_cast/tune/readahead.c b/mm/lru_cast/tune/readahead.c
new file mode 100644
index 0000000000..fb5908469c
--- /dev/null
+++ b/mm/lru_cast/tune/readahead.c
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- readahead, as each point of the curve would have it.
+ *
+ * What a split costs is the time tasks wait, and a file miss read ahead
+ * in time waits nothing. How many are depends on the split -- the more of a
+ * file is gone, the longer its misses run and the more of them readahead
+ * covers -- so each point of the curve reads ahead for itself, as the
+ * kernel would in a cache of its size: a read that follows the one before
+ * it in the block (a run) opens a window at its point if it missed, and
+ * keeps it open; a miss in an open window waits nothing and counts as
+ * none. A read out of a run closes it. Anon is not read ahead (zram swaps
+ * in one page at a time).
+ */
+#include <linux/hash.h>
+#include <linux/vmalloc.h>
+#include "tune/sample.h"
+
+#define LRU_CAST_TUNE_BLKS		4096		/* file's blocks whose runs are followed */
+
+/* a sampled block of file: where its run is, and the curve's open windows */
+struct lru_cast_tune_blk {
+	u64 id;
+	pgoff_t next;			/* the index a read continuing the run is at */
+	u16 win;			/* the curve's points (0..10 tenths) with a window open */
+};
+
+/* direct-mapped: a clash forgets */
+struct lru_cast_tune_ra {
+	struct lru_cast_tune_blk blk[LRU_CAST_TUNE_BLKS];
+};
+
+struct lru_cast_tune_ra *lru_cast_tune_ra_alloc(void)
+{
+	return __vmalloc(sizeof(struct lru_cast_tune_ra), LRU_CAST_TUNE_GFP);
+}
+
+void lru_cast_tune_ra_free(struct lru_cast_tune_ra *ra)
+{
+	vfree(ra);
+}
+
+void lru_cast_tune_ra_init(struct lru_cast_tune_ra *ra)
+{
+	memset(ra, 0, sizeof(*ra));
+}
+
+/*
+ * Which of the curve's points (bit p: p tenths; 0 misses all) wait for the
+ * read of the @nr pages at @index of @block, given those that miss it -- a
+ * miss in an open window does not -- and the windows after it. The run
+ * before a block is out of sight: a read at its start begins one, as a
+ * read of a file's start does.
+ */
+u16 lru_cast_tune_ra_waits(struct lru_cast_tune_ra *ra, u64 block, pgoff_t index,
+			   unsigned int nr, u16 miss)
+{
+	struct lru_cast_tune_blk *b = &ra->blk[hash_64(block, ilog2(LRU_CAST_TUNE_BLKS))];
+	bool run = b->id == block && b->next == index;
+	u16 wait = run ? miss & ~b->win : miss;
+
+	b->id = block;
+	b->win = run ? b->win | miss : index % LRU_CAST_TUNE_BLOCK ? 0 : miss;
+	b->next = index + nr;
+	return wait;
+}
diff --git a/mm/lru_cast/tune/sample.c b/mm/lru_cast/tune/sample.c
new file mode 100644
index 0000000000..ab1a0cad59
--- /dev/null
+++ b/mm/lru_cast/tune/sample.c
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the controllers' sample.
+ *
+ * A page is in it when the hash of its block -- (mapping, index /
+ * LRU_CAST_TUNE_BLOCK), which survives eviction and refault, unlike the PFN -- falls
+ * under a threshold set at boot so that about LRU_CAST_TUNE_TARGET pages of the whole
+ * memory are (the test, asked of every read, is inline: tune.h); each
+ * simulated cache holds the sample's share of the type's pages. Whole
+ * blocks, so that the caches see reads in runs, as readahead does.
+ *
+ * Not yet as the model has it: an anon page swapped out comes back as a
+ * new identity.
+ */
+#include "tune/tune.h"
+#include "tune/sample.h"
+
+u32 lru_cast_tune_threshold __read_mostly;
+
+void lru_cast_tune_sample_init(unsigned long total)
+{
+	WRITE_ONCE(lru_cast_tune_threshold, total > LRU_CAST_TUNE_TARGET ?
+		   (u32)div64_u64((u64)LRU_CAST_TUNE_TARGET << 32, total) : U32_MAX);
+}
+
+/* the identity of the page, in the sample if its block is (lru_cast_tune_block()) */
+u64 lru_cast_tune_sample_page(struct folio *folio)
+{
+	return lru_cast_tune_mix(READ_ONCE(folio->mapping), folio->index);
+}
+
+unsigned long lru_cast_tune_sample_pages(unsigned long pages)
+{
+	return mult_frac(pages, (unsigned long)READ_ONCE(lru_cast_tune_threshold), 1UL << 32);
+}
diff --git a/mm/lru_cast/tune/sample.h b/mm/lru_cast/tune/sample.h
new file mode 100644
index 0000000000..ba3cf220d4
--- /dev/null
+++ b/mm/lru_cast/tune/sample.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST -- which pages the controllers sample (sample.c), and how
+ * file's are read ahead in the curve's caches (readahead.c).
+ */
+#ifndef _MM_LRU_CAST_TUNE_SAMPLE_H
+#define _MM_LRU_CAST_TUNE_SAMPLE_H
+
+#include "tune/shape.h"
+
+/* sample.c */
+void lru_cast_tune_sample_init(unsigned long total);
+u64 lru_cast_tune_sample_page(struct folio *folio);
+/* of @pages, how many are sampled */
+unsigned long lru_cast_tune_sample_pages(unsigned long pages);
+
+/* readahead.c: under the controllers' lock */
+struct lru_cast_tune_ra;
+struct lru_cast_tune_ra *lru_cast_tune_ra_alloc(void);
+void lru_cast_tune_ra_free(struct lru_cast_tune_ra *ra);
+void lru_cast_tune_ra_init(struct lru_cast_tune_ra *ra);
+u16 lru_cast_tune_ra_waits(struct lru_cast_tune_ra *ra, u64 block, pgoff_t index,
+			   unsigned int nr, u16 miss);
+
+#endif /* _MM_LRU_CAST_TUNE_SAMPLE_H */
diff --git a/mm/lru_cast/tune/shape.h b/mm/lru_cast/tune/shape.h
new file mode 100644
index 0000000000..a2afba6c3f
--- /dev/null
+++ b/mm/lru_cast/tune/shape.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST -- the shape of the controllers, shared inside tune/.
+ *
+ * Each type's sample is measured at LRU_CAST_TUNE_N points at once, the first LRU_CAST_TUNE_SIM
+ * of them simulated caches (sim.c), the rest read from its order:
+ *
+ *	0..8	the decay grid: le at the centre and +-1, 2, 4, 8 from it
+ *		(decay.c), W as the main cache's
+ *	9, 10	W's share -/+ 0.1 C, le at the centre (wshare.c)
+ *	11..20	the curve: the type at 1..10 tenths of all memory's sample,
+ *		each a world with the other type's point at the rest
+ *		(world.c, share.c), le at the centre and no W
+ */
+#ifndef _MM_LRU_CAST_TUNE_SHAPE_H
+#define _MM_LRU_CAST_TUNE_SHAPE_H
+
+#include "tune/tune.h"
+
+#define LRU_CAST_TUNE_N		21
+#define LRU_CAST_TUNE_DECAY	9		/* the decay grid: 0..8 */
+#define LRU_CAST_TUNE_CENTER	4
+#define LRU_CAST_TUNE_WLO		9
+#define LRU_CAST_TUNE_WHI		10
+#define LRU_CAST_TUNE_CURVE	11		/* the type at 1..10 tenths of all memory: 11..20 */
+#define LRU_CAST_TUNE_SIM		LRU_CAST_TUNE_CURVE	/* the simulated caches: 0..10 */
+#define LRU_CAST_TUNE_SHARES	10
+
+#define LRU_CAST_TUNE_TARGET	15000		/* sampled pages in the whole memory */
+#define LRU_CAST_TUNE_TABLE	4		/* slots per page of a simulated cache */
+
+#define LRU_CAST_TUNE_WUNIT	64000		/* W's share in 1/64000 of the cache */
+
+/* the controllers are optional: switching CAST on must not invoke the OOM killer */
+#define LRU_CAST_TUNE_GFP		(GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN)
+
+/* the world of @type's curve point @m: anon's at k tenths is world k, file's world 10 - k */
+static inline int lru_cast_tune_world_of(int type, int m)
+{
+	int p = m - LRU_CAST_TUNE_CURVE + 1;
+
+	return type ? LRU_CAST_TUNE_SHARES - p : p;
+}
+
+/* the curve point of @type in world @k, or -1: none (anon at 0, file at 10) */
+static inline int lru_cast_tune_cache_in(int type, int k)
+{
+	if (!type)
+		return k ? LRU_CAST_TUNE_CURVE + k - 1 : -1;
+	return k < LRU_CAST_TUNE_SHARES ? LRU_CAST_TUNE_CURVE + LRU_CAST_TUNE_SHARES - k - 1 : -1;
+}
+
+/* the pages of @type on the LRUs, every node's */
+static inline unsigned long lru_cast_tune_type_pages(int type)
+{
+	return global_node_page_state(NR_LRU_BASE + LRU_INACTIVE_ANON + type * LRU_FILE) +
+	       global_node_page_state(NR_LRU_BASE + LRU_ACTIVE_ANON + type * LRU_FILE);
+}
+
+#endif /* _MM_LRU_CAST_TUNE_SHAPE_H */
diff --git a/mm/lru_cast/tune/share.c b/mm/lru_cast/tune/share.c
new file mode 100644
index 0000000000..15538d20e2
--- /dev/null
+++ b/mm/lru_cast/tune/share.c
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- anon's share of memory.
+ *
+ * Chosen across the types from their curves: of the eleven splits
+ * (0..10 tenths, world.c), the one that loses least -- anon's waits at k
+ * tenths and file's at the rest, weighed by what their refaults cost
+ * (cost.c). Reclaim presses both types toward the share
+ * (policy/balance.c). A curve, measured over the whole range, finds a
+ * split a gradient would not: the gain of a loop that does not fit comes
+ * all at once, when it does.
+ *
+ * Nothing switches on how much has been learnt. The share is held, the
+ * split memory had when reclaim first wanted it or the curves could first
+ * compare, whichever came first, and moves only to a split they show
+ * better at 2 sigma; reclaim presses toward it, so with no evidence the
+ * split stays about as it is. The curves can compare once the sample has seen LRU_CAST_TUNE_SHARE_SEEN
+ * of each type's reads: before, a split taken from memory would be the
+ * few pages a booting system has, as it happened to be. The weights of the two types' misses come from
+ * the estimate of what their refaults cost, which is the ratio swappiness
+ * gives until samples say otherwise. Either leans from what it was told to
+ * what it measures as the measure grows.
+ *
+ * A split that leaves a type nothing is taken only once the sample has
+ * seen LRU_CAST_TUNE_SHARE_SEEN of the type's reads (those a cache of nothing waits
+ * for, decaying as the rest). Few reads say only that the sample has not
+ * met the type's pages read: a program's text is a few hundred pages, of
+ * which a sample of LRU_CAST_TUNE_TARGET pages of all memory, in blocks, often holds
+ * none, and the type's few cold pages read once would show it needing
+ * nothing. Short of that, the
+ * type keeps a tenth, what it reads of it.
+ */
+#include "tune/tune.h"
+#include "tune/share.h"
+#include "tune/cost.h"
+#include "policy/policy.h"
+
+#define LRU_CAST_TUNE_SHARE_SEEN	256
+
+void lru_cast_tune_share_reset(void)
+{
+	lru_cast_param_free_share();
+}
+
+/* @a, @f: anon's and file's evidence */
+void lru_cast_tune_share_update(const struct lru_cast_tune_evidence *a,
+				const struct lru_cast_tune_evidence *f)
+{
+	unsigned long pa = lru_cast_tune_type_pages(0), pf = lru_cast_tune_type_pages(1);
+	s64 ma[LRU_CAST_TUNE_SHARES + 1], mf[LRU_CAST_TUNE_SHARES + 1];
+	s64 cost[LRU_CAST_TUNE_SHARES + 1], gain = 0;
+	int k, cur, best;
+	u64 wa, wf;
+
+	lru_cast_tune_cost_gather();
+	lru_cast_tune_weights(&wa, &wf);
+	for (k = 0; k <= LRU_CAST_TUNE_SHARES; k++) {
+		ma[k] = k ? READ_ONCE(a->miss[lru_cast_tune_cache_in(0, k)]) : READ_ONCE(a->evd);
+		mf[k] = k < LRU_CAST_TUNE_SHARES ?
+			READ_ONCE(f->miss[lru_cast_tune_cache_in(1, k)]) : READ_ONCE(f->evd);
+		cost[k] = ma[k] * wa + mf[k] * wf;
+	}
+	/*
+	 * The share is held, and starts as the split memory has when reclaim
+	 * first wants it (policy/balance.c) or here, when the curves can first
+	 * compare: reclaim pressing toward it, the split stays about as it
+	 * is. Until then
+	 * there is nothing to move. The curves move it only to a split they
+	 * show better at 2 sigma. The
+	 * spread of the difference between two splits comes from the accesses
+	 * on which their points disagree, each moving it by its type's weight,
+	 * as likely either way if neither is better.
+	 */
+	if (!lru_cast_param_share_held()) {
+		if (READ_ONCE(a->evd) < LRU_CAST_TUNE_SHARE_SEEN * 256 ||
+		    READ_ONCE(f->evd) < LRU_CAST_TUNE_SHARE_SEEN * 256)
+			return;
+		lru_cast_param_hold_share(DIV_ROUND_CLOSEST(pa * 1000, max(pa + pf, 1UL)));
+	}
+	/* the split as it is, not rounded: the curves compare at the nearest point */
+	cur = best = DIV_ROUND_CLOSEST(lru_cast_param_share() * LRU_CAST_TUNE_SHARES, 1000);
+	for (k = 0; k <= LRU_CAST_TUNE_SHARES; k++) {
+		s64 g = cost[cur] - cost[k];
+		const struct lru_cast_tune_evidence *left =
+			!k ? a : k == LRU_CAST_TUNE_SHARES ? f : NULL;
+		int i = min(k, cur), j = max(k, cur);
+		u64 var = wa * wa * lru_cast_tune_ev_pdis(a, i, j) +
+			  wf * wf * lru_cast_tune_ev_pdis(f, LRU_CAST_TUNE_SHARES - j,
+							  LRU_CAST_TUNE_SHARES - i);
+
+		/*
+		 * misses in 1/256: g^2 > 4 * 256 * var, as g > 32 sqrt(var) --
+		 * g, misses times a weight of up to 16 bits, squared would not
+		 * fit in 64
+		 */
+		if (k != cur && left && READ_ONCE(left->evd) < LRU_CAST_TUNE_SHARE_SEEN * 256)
+			continue;
+		if (g > gain && g > 32 * (s64)int_sqrt64(var)) {
+			gain = g;
+			best = k;
+		}
+	}
+	if (best != cur && lru_cast_tune_auto())
+		lru_cast_param_set_share(best * 1000 / LRU_CAST_TUNE_SHARES);
+}
diff --git a/mm/lru_cast/tune/share.h b/mm/lru_cast/tune/share.h
new file mode 100644
index 0000000000..ed70aed9e1
--- /dev/null
+++ b/mm/lru_cast/tune/share.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* CAST -- anon's share of memory (share.c), under the controllers' lock */
+#ifndef _MM_LRU_CAST_TUNE_SHARE_H
+#define _MM_LRU_CAST_TUNE_SHARE_H
+
+#include "tune/evidence.h"
+
+void lru_cast_tune_share_reset(void);
+void lru_cast_tune_share_update(const struct lru_cast_tune_evidence *a,
+				const struct lru_cast_tune_evidence *f);
+
+#endif /* _MM_LRU_CAST_TUNE_SHARE_H */
diff --git a/mm/lru_cast/tune/sim.c b/mm/lru_cast/tune/sim.c
new file mode 100644
index 0000000000..860d515971
--- /dev/null
+++ b/mm/lru_cast/tune/sim.c
@@ -0,0 +1,733 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- simulated CAST caches of a sample, and its order.
+ *
+ * Each cache is the main cache in small (policy/): W, a FIFO window for
+ * newcomers, and M, a ring of LRU_CAST_TUNE_BUCKETS buckets of the key (core/key.c).
+ * A miss enters W's head; while W is over its share, its tail meets the
+ * lowest bucket of M -- the lower goes, a tie against the page of that
+ * bucket read longest ago (policy/ring.c) -- or, the cache not yet full,
+ * joins M. A hit in M moves the page up; a hit in W only updates its state.
+ *
+ * Among pages of one key the main cache takes those read once first, in
+ * its clock's order, and those read more than once by a hash, the same of
+ * them first each time (policy/ring.c). So does each cache here: a key's
+ * bucket is LRU_CAST_TUNE_SUB of them, the first for pages read once, read
+ * longest ago first, and the rest for pages read more than once by a hash
+ * of the page, so that a loop over more than the cache keeps the same part
+ * of itself here as it does there -- ranked by when they were read, it
+ * would keep none, and the decay and W's share would be chosen for a
+ * cache that is not the one they set. A newcomer read once meets M's
+ * lowest by its key alone, as there.
+ *
+ * The order is every cache size at once. Without W, a CAST cache of any
+ * size holds the top of one order of the pages -- by key, at the decay
+ * grid's centre, and among equal keys the one read last first: a key
+ * changes only when its page is read, which only lifts it, and a newcomer
+ * joins only above the lowest, which then goes. So a page read is a hit in
+ * a cache of n pages if its rank before the read is n or better, and one
+ * rank says it for every point of the curve (world.c). That needs the
+ * clock to be one for all of them -- the nodes', as the other caches have.
+ *
+ * The caches and the order share the sample's slots: a slot is a sampled
+ * page read, linked into each cache it is resident in, and into the
+ * order. Past the slots are the sentinels of each cache's buckets and W,
+ * each linked in that cache only. Lists are circular through the
+ * sentinels, so a slot leaves one without knowing which. With the table
+ * full, a new page takes the slot of the lowest page in the order resident
+ * in no cache: the one every size would have let go first.
+ *
+ * A page not read for long is marked stale, then deep, as the main cache's
+ * words are (core/core.h): a part of the slots at each tick, each in
+ * LRU_CAST_STALE_PASS ticks. Its key then changes once, at the mark, and
+ * is as fixed as any other: the page moves in each cache it is in M of
+ * and in the order, as a read would move it.
+ */
+#include <linux/hash.h>
+#include <linux/rbtree_augmented.h>
+#include <linux/vmalloc.h>
+#include "tune/sim.h"
+
+#define LRU_CAST_TUNE_SUB	4				/* buckets per key */
+#define LRU_CAST_TUNE_BUCKETS	(256 * LRU_CAST_TUNE_SUB)
+#define LRU_CAST_TUNE_HEADS	(LRU_CAST_TUNE_BUCKETS + 1)	/* per cache: the buckets, then W */
+
+struct lru_cast_tune_slot {
+	u64 id;				/* 0: free */
+	u32 w;				/* state word, in the clock's ticks */
+	u16 hnext;			/* hash chain, or the free list */
+	u16 res;			/* the caches it is resident in */
+	u16 inw;			/* ... and in W of */
+	u16 lnk[LRU_CAST_TUNE_SIM][2];		/* prev, next in its list of each cache */
+	u16 size;			/* the order: pages in its subtree */
+	struct rb_node rb;		/* ... its node, empty if not in it */
+	long key;			/* ... its key when last read */
+	u64 seq;			/* ... and when */
+};
+
+struct lru_cast_tune_cache {
+	int le;
+	unsigned int wq;		/* W's share, in LRU_CAST_TUNE_WUNIT */
+	unsigned long cap;		/* pages it holds */
+	long lo;			/* absolute number of the lowest bucket */
+	DECLARE_BITMAP(nonempty, LRU_CAST_TUNE_BUCKETS);
+	unsigned long count, wcount;	/* pages resident, of them in W */
+};
+
+struct lru_cast_tune_sim {
+	struct lru_cast_tune_slot *slot;		/* slots, then the sentinels */
+	u16 *hash;
+	unsigned int nslots, hbits;
+	u16 free;
+	unsigned long tick;		/* the clock */
+	struct lru_cast_tune_cache c[LRU_CAST_TUNE_SIM];
+	struct rb_root order;		/* lowest first */
+	int ole;			/* the order's decay */
+	unsigned int tracked;		/* slots in it */
+	u64 seq;			/* reads */
+	/* the keys of the slot being read, at the decays asked so far (lru_cast_tune_skey()) */
+	u16 kslot;
+	u16 khave;
+	long kkey[LRU_CAST_LE_MAX + 1];
+	unsigned long stale_tick;	/* the tick the marking has looked up to */
+	unsigned int stale_slot;	/* the slot it looks at next */
+	unsigned int stale_todo;	/* ... and how many it has yet to */
+};
+
+static inline u16 lru_cast_tune_head(struct lru_cast_tune_sim *sim, int m, unsigned int idx)
+{
+	return sim->nslots + m * LRU_CAST_TUNE_HEADS + idx;
+}
+
+static inline u16 lru_cast_tune_whead(struct lru_cast_tune_sim *sim, int m)
+{
+	return lru_cast_tune_head(sim, m, LRU_CAST_TUNE_BUCKETS);
+}
+
+/*
+ * the key of @w at decay @le in buckets: its key's, then which of them (see
+ * above). Of the slot being read, each decay's once: the caches of one
+ * decay agree.
+ */
+static long lru_cast_tune_skey(struct lru_cast_tune_sim *sim, u16 s, int le)
+{
+	u32 w = sim->slot[s].w;
+	long key;
+
+	if (s != sim->kslot) {
+		key = lru_cast_key(w, sim->tick, le);
+	} else if (sim->khave & BIT(le)) {
+		key = sim->kkey[le];
+	} else {
+		key = lru_cast_key(w, sim->tick, le);
+		sim->kkey[le] = key;
+		sim->khave |= BIT(le);
+	}
+
+	if (key == LONG_MIN)
+		return LONG_MIN;
+	return key * LRU_CAST_TUNE_SUB +
+	       ((w >> 24) >= 2 ? 1 + hash_64(sim->slot[s].id, 16) % (LRU_CAST_TUNE_SUB - 1) : 0);
+}
+
+/* the bucket of slot @s in cache @m */
+static inline long lru_cast_tune_mkey(struct lru_cast_tune_sim *sim, int m, u16 s)
+{
+	return lru_cast_tune_skey(sim, s, sim->c[m].le);
+}
+
+/* the lowest bucket the window of cache @m holds now */
+static inline long lru_cast_tune_window_lo(struct lru_cast_tune_sim *sim, int m)
+{
+	return lru_cast_window_lo(sim->tick, sim->c[m].le) * LRU_CAST_TUNE_SUB;
+}
+
+/* ------------------------------------------------------------- lists */
+
+static void lru_cast_tune_unlink(struct lru_cast_tune_sim *sim, u16 s, int m)
+{
+	u16 p = sim->slot[s].lnk[m][0], n = sim->slot[s].lnk[m][1];
+
+	sim->slot[p].lnk[m][1] = n;
+	sim->slot[n].lnk[m][0] = p;
+}
+
+static void lru_cast_tune_add_tail(struct lru_cast_tune_sim *sim, u16 s, u16 head, int m)
+{
+	u16 p = sim->slot[head].lnk[m][0];
+
+	sim->slot[s].lnk[m][0] = p;
+	sim->slot[s].lnk[m][1] = head;
+	sim->slot[p].lnk[m][1] = s;
+	sim->slot[head].lnk[m][0] = s;
+}
+
+static void lru_cast_tune_add_head(struct lru_cast_tune_sim *sim, u16 s, u16 head, int m)
+{
+	u16 n = sim->slot[head].lnk[m][1];
+
+	sim->slot[s].lnk[m][0] = head;
+	sim->slot[s].lnk[m][1] = n;
+	sim->slot[n].lnk[m][0] = s;
+	sim->slot[head].lnk[m][1] = s;
+}
+
+static bool lru_cast_tune_empty(struct lru_cast_tune_sim *sim, u16 head, int m)
+{
+	return sim->slot[head].lnk[m][1] == head;
+}
+
+/* move all of @from to the head of @to, keeping its order */
+static void lru_cast_tune_splice_head(struct lru_cast_tune_sim *sim, u16 from, u16 to, int m)
+{
+	u16 first, last, nxt;
+
+	if (lru_cast_tune_empty(sim, from, m))
+		return;
+	first = sim->slot[from].lnk[m][1];
+	last = sim->slot[from].lnk[m][0];
+	nxt = sim->slot[to].lnk[m][1];
+	sim->slot[to].lnk[m][1] = first;
+	sim->slot[first].lnk[m][0] = to;
+	sim->slot[last].lnk[m][1] = nxt;
+	sim->slot[nxt].lnk[m][0] = last;
+	sim->slot[from].lnk[m][0] = sim->slot[from].lnk[m][1] = from;
+}
+
+/* -------------------------------------------------------------- order */
+
+static inline u16 lru_cast_tune_osize(struct rb_node *rb)
+{
+	return rb ? rb_entry(rb, struct lru_cast_tune_slot, rb)->size : 0;
+}
+
+static inline bool lru_cast_tune_ocompute(struct lru_cast_tune_slot *sl, bool exit)
+{
+	u16 size = 1 + lru_cast_tune_osize(sl->rb.rb_left) + lru_cast_tune_osize(sl->rb.rb_right);
+
+	if (exit && sl->size == size)
+		return true;
+	sl->size = size;
+	return false;
+}
+
+RB_DECLARE_CALLBACKS(static, lru_cast_tune_ocb, struct lru_cast_tune_slot, rb, size,
+		     lru_cast_tune_ocompute);
+
+/* @a ranks below @b: a lower key, or an equal one read before */
+static inline bool lru_cast_tune_obelow(const struct lru_cast_tune_slot *a,
+					const struct lru_cast_tune_slot *b)
+{
+	return a->key < b->key || (a->key == b->key && a->seq < b->seq);
+}
+
+/* slot @s into the order, by its key now and the read it had at @seq */
+static void lru_cast_tune_oinsert(struct lru_cast_tune_sim *sim, u16 s, u64 seq)
+{
+	struct lru_cast_tune_slot *sl = &sim->slot[s];
+	struct rb_node **link = &sim->order.rb_node, *parent = NULL;
+
+	sl->key = lru_cast_tune_skey(sim, s, sim->ole);
+	sl->seq = seq;
+	while (*link) {
+		struct lru_cast_tune_slot *p = rb_entry(*link, struct lru_cast_tune_slot, rb);
+
+		parent = *link;
+		p->size++;
+		link = lru_cast_tune_obelow(sl, p) ? &parent->rb_left : &parent->rb_right;
+	}
+	sl->size = 1;
+	rb_link_node(&sl->rb, parent, link);
+	rb_insert_augmented(&sl->rb, &sim->order, &lru_cast_tune_ocb);
+	sim->tracked++;
+}
+
+static void lru_cast_tune_oerase(struct lru_cast_tune_sim *sim, u16 s)
+{
+	rb_erase_augmented(&sim->slot[s].rb, &sim->order, &lru_cast_tune_ocb);
+	RB_CLEAR_NODE(&sim->slot[s].rb);
+	sim->tracked--;
+}
+
+/* the order rebuilt at decay @le: the keys are in other units */
+static void lru_cast_tune_oregrid(struct lru_cast_tune_sim *sim, int le)
+{
+	unsigned int s;
+
+	sim->ole = le;
+	sim->order = RB_ROOT;
+	sim->tracked = 0;
+	for (s = 0; s < sim->nslots; s++)
+		if (sim->slot[s].id)
+			lru_cast_tune_oinsert(sim, s, sim->slot[s].seq);
+}
+
+/* -------------------------------------------------------------- rings */
+
+static void lru_cast_tune_place(struct lru_cast_tune_sim *sim, int m, u16 s, long b)
+{
+	struct lru_cast_tune_cache *c = &sim->c[m];
+	unsigned int idx;
+
+	if (b < c->lo)
+		b = c->lo;
+	if (b > c->lo + LRU_CAST_TUNE_BUCKETS - 1)
+		b = c->lo + LRU_CAST_TUNE_BUCKETS - 1;
+	idx = b & (LRU_CAST_TUNE_BUCKETS - 1);
+	lru_cast_tune_add_tail(sim, s, lru_cast_tune_head(sim, m, idx), m);
+	__set_bit(idx, c->nonempty);
+}
+
+/* the window follows the clock: buckets fallen below join the lowest, oldest first */
+static void lru_cast_tune_advance(struct lru_cast_tune_sim *sim, int m)
+{
+	struct lru_cast_tune_cache *c = &sim->c[m];
+	long lo = lru_cast_tune_window_lo(sim, m), b, end;
+	u16 to;
+
+	if (lo <= c->lo)
+		return;
+	end = min(lo, c->lo + LRU_CAST_TUNE_BUCKETS - 1);
+	to = lru_cast_tune_head(sim, m, lo & (LRU_CAST_TUNE_BUCKETS - 1));
+	for (b = end; b >= c->lo; b--) {
+		unsigned int idx = b & (LRU_CAST_TUNE_BUCKETS - 1);
+		u16 h = lru_cast_tune_head(sim, m, idx);
+
+		if (h == to)
+			continue;
+		lru_cast_tune_splice_head(sim, h, to, m);
+		__clear_bit(idx, c->nonempty);
+	}
+	c->lo = lo;
+	if (!lru_cast_tune_empty(sim, to, m))
+		__set_bit(lo & (LRU_CAST_TUNE_BUCKETS - 1), c->nonempty);
+}
+
+/* the lowest nonempty bucket of cache @m: its number, and its sentinel */
+static long lru_cast_tune_lowest(struct lru_cast_tune_sim *sim, int m, u16 *head)
+{
+	struct lru_cast_tune_cache *c = &sim->c[m];
+	unsigned int start = c->lo & (LRU_CAST_TUNE_BUCKETS - 1), idx;
+
+	for (;;) {
+		idx = find_next_bit(c->nonempty, LRU_CAST_TUNE_BUCKETS, start);
+		if (idx >= LRU_CAST_TUNE_BUCKETS)
+			idx = find_first_bit(c->nonempty, LRU_CAST_TUNE_BUCKETS);
+		if (idx >= LRU_CAST_TUNE_BUCKETS)
+			return LONG_MAX;
+		*head = lru_cast_tune_head(sim, m, idx);
+		if (!lru_cast_tune_empty(sim, *head, m))
+			return c->lo + ((idx - start) & (LRU_CAST_TUNE_BUCKETS - 1));
+		__clear_bit(idx, c->nonempty);
+	}
+}
+
+/* @s leaves cache @m, from W or M */
+static void lru_cast_tune_evict(struct lru_cast_tune_sim *sim, int m, u16 s)
+{
+	lru_cast_tune_unlink(sim, s, m);
+	if (sim->slot[s].inw & BIT(m)) {
+		sim->slot[s].inw &= ~BIT(m);
+		sim->c[m].wcount--;
+	}
+	sim->slot[s].res &= ~BIT(m);
+	sim->c[m].count--;
+}
+
+/* W's tail into M (no longer counted in W) */
+static void lru_cast_tune_promote(struct lru_cast_tune_sim *sim, int m, u16 s, long b)
+{
+	lru_cast_tune_unlink(sim, s, m);
+	sim->slot[s].inw &= ~BIT(m);
+	sim->c[m].wcount--;
+	lru_cast_tune_place(sim, m, s, b);
+}
+
+/* W over its share meets M; then the cache within its size */
+static void lru_cast_tune_balance(struct lru_cast_tune_sim *sim, int m)
+{
+	struct lru_cast_tune_cache *c = &sim->c[m];
+	unsigned long wt = c->cap * c->wq / LRU_CAST_TUNE_WUNIT;
+	long low, bt;
+	u16 h, s;
+
+	while (c->wcount > wt) {
+		s = sim->slot[lru_cast_tune_whead(sim, m)].lnk[m][0];	/* W's tail */
+		bt = lru_cast_tune_mkey(sim, m, s);
+		if (c->count <= c->cap) {
+			lru_cast_tune_promote(sim, m, s, bt);	/* not full: it joins M */
+			continue;
+		}
+		low = lru_cast_tune_lowest(sim, m, &h);
+		/* read once, by its key alone: of one key, the newcomer was read last */
+		if (low == LONG_MAX ||
+		    ((sim->slot[s].w >> 24) >= 2 ? bt < low :
+		     bt / LRU_CAST_TUNE_SUB < low / LRU_CAST_TUNE_SUB)) {
+			lru_cast_tune_evict(sim, m, s);
+			continue;
+		}
+		lru_cast_tune_evict(sim, m, sim->slot[h].lnk[m][1]);
+		lru_cast_tune_promote(sim, m, s, bt);
+	}
+	while (c->count > c->cap) {
+		low = lru_cast_tune_lowest(sim, m, &h);
+		if (low == LONG_MAX)
+			s = sim->slot[lru_cast_tune_whead(sim, m)].lnk[m][0];
+		else
+			s = sim->slot[h].lnk[m][1];
+		lru_cast_tune_evict(sim, m, s);
+	}
+}
+
+/* an access to @s in cache @m: in, or up; not yet balanced */
+static void lru_cast_tune_access(struct lru_cast_tune_sim *sim, int m, u16 s, bool hit)
+{
+	struct lru_cast_tune_cache *c = &sim->c[m];
+
+	lru_cast_tune_advance(sim, m);
+	if (hit) {
+		if (sim->slot[s].inw & BIT(m))
+			return;			/* in W: its state only */
+		lru_cast_tune_unlink(sim, s, m);
+		lru_cast_tune_place(sim, m, s, lru_cast_tune_mkey(sim, m, s));
+		return;
+	}
+	lru_cast_tune_add_head(sim, s, lru_cast_tune_whead(sim, m), m);
+	sim->slot[s].res |= BIT(m);
+	sim->slot[s].inw |= BIT(m);
+	c->count++;
+	c->wcount++;
+}
+
+/*
+ * A read of @s, resident in the caches of @res, in every cache and in the
+ * order: in, or up. Each cache is made to fit on a hit too: a size or a
+ * share set lower (lru_cast_tune_sim_set_cap(), _set_wq()) or a regrid
+ * leaves it over until it is, and a cache over its size that only hits
+ * would never be -- holding more than it may, it misses less than the
+ * others, and the decay it runs at wins.
+ */
+void lru_cast_tune_sim_access_all(struct lru_cast_tune_sim *sim, u16 s, u32 res)
+{
+	int m;
+
+	sim->kslot = s;			/* its word stays as it is meanwhile */
+	sim->khave = 0;
+	for (m = 0; m < LRU_CAST_TUNE_SIM; m++) {
+		lru_cast_tune_access(sim, m, s, res & BIT(m));
+		lru_cast_tune_balance(sim, m);
+	}
+	if (!RB_EMPTY_NODE(&sim->slot[s].rb))
+		lru_cast_tune_oerase(sim, s);
+	lru_cast_tune_oinsert(sim, s, ++sim->seq);
+	sim->kslot = LRU_CAST_TUNE_SIM_NONE;
+}
+
+/* @s's rank in the order, 1 the top, before its read reaches it; 0: not in it */
+unsigned int lru_cast_tune_sim_rank(struct lru_cast_tune_sim *sim, u16 s)
+{
+	struct rb_node *rb = &sim->slot[s].rb, *p;
+	unsigned int below;
+
+	if (RB_EMPTY_NODE(rb))
+		return 0;
+	below = lru_cast_tune_osize(rb->rb_left);
+	for (p = rb_parent(rb); p; rb = p, p = rb_parent(rb))
+		if (p->rb_right == rb)
+			below += lru_cast_tune_osize(p->rb_left) + 1;
+	return sim->tracked - below;
+}
+
+/* the pages in the order: those read, while the table had room */
+unsigned int lru_cast_tune_sim_tracked(struct lru_cast_tune_sim *sim)
+{
+	return sim->tracked;
+}
+
+/* --------------------------------------------------------------- slots */
+
+static u16 lru_cast_tune_lookup(struct lru_cast_tune_sim *sim, u64 id)
+{
+	u16 s = sim->hash[hash_64(id, sim->hbits)];
+
+	while (s != LRU_CAST_TUNE_SIM_NONE && sim->slot[s].id != id)
+		s = sim->slot[s].hnext;
+	return s;
+}
+
+static void lru_cast_tune_unhash(struct lru_cast_tune_sim *sim, u16 s)
+{
+	u16 *pp = &sim->hash[hash_64(sim->slot[s].id, sim->hbits)];
+
+	while (*pp != s)
+		pp = &sim->slot[*pp].hnext;
+	*pp = sim->slot[s].hnext;
+}
+
+/* how far up the order to look for a slot in no cache */
+#define LRU_CAST_TUNE_REUSE_SCAN	64
+
+/* a slot for @id: a free one, or that of the lowest page in the order resident in no cache */
+static u16 lru_cast_tune_alloc(struct lru_cast_tune_sim *sim, u64 id)
+{
+	u16 s = sim->free, *hp;
+
+	if (s != LRU_CAST_TUNE_SIM_NONE) {
+		sim->free = sim->slot[s].hnext;
+	} else {
+		struct rb_node *rb = rb_first(&sim->order);
+		int n;
+
+		for (n = 0; rb && n < LRU_CAST_TUNE_REUSE_SCAN; n++, rb = rb_next(rb))
+			if (!rb_entry(rb, struct lru_cast_tune_slot, rb)->res)
+				break;
+		if (!rb || n == LRU_CAST_TUNE_REUSE_SCAN)
+			return LRU_CAST_TUNE_SIM_NONE;
+		s = rb_entry(rb, struct lru_cast_tune_slot, rb) - sim->slot;
+		lru_cast_tune_oerase(sim, s);
+		lru_cast_tune_unhash(sim, s);
+	}
+	sim->slot[s].id = id;
+	sim->slot[s].w = 0;
+	sim->slot[s].res = 0;
+	sim->slot[s].inw = 0;
+	RB_CLEAR_NODE(&sim->slot[s].rb);
+	hp = &sim->hash[hash_64(id, sim->hbits)];
+	sim->slot[s].hnext = *hp;
+	*hp = s;
+	return s;
+}
+
+/*
+ * What the marking does in a read, and in one when it is a pass behind: a
+ * slot looked at costs 1, one marked, moved in every cache and the order,
+ * LRU_CAST_TUNE_MARK_MOVE
+ */
+#define LRU_CAST_TUNE_MARK_STEP		64
+#define LRU_CAST_TUNE_MARK_CATCHUP	256
+#define LRU_CAST_TUNE_MARK_MOVE		16
+
+/*
+ * The slots marked stale or deep where their read is old, as the main
+ * cache's words are (core/clock.c), each moved by its new key in the caches
+ * it is in M of and in the order. Each tick owes a part of the table, a
+ * pass in LRU_CAST_STALE_PASS ticks; the reads pay it, a little each --
+ * slots read at one time go stale at one time, and a few are moved in a
+ * read -- and more each only while a whole pass is owed.
+ */
+static void lru_cast_tune_mark(struct lru_cast_tune_sim *sim)
+{
+	unsigned int part = DIV_ROUND_UP(sim->nslots, LRU_CAST_STALE_PASS), s;
+	unsigned long ticks = min(sim->tick - sim->stale_tick, (unsigned long)LRU_CAST_STALE_PASS);
+	int budget;
+
+	sim->stale_tick = sim->tick;
+	sim->stale_todo = min_t(unsigned long, sim->stale_todo + ticks * part, 2 * sim->nslots);
+	budget = sim->stale_todo > sim->nslots ? LRU_CAST_TUNE_MARK_CATCHUP : LRU_CAST_TUNE_MARK_STEP;
+	for (s = sim->stale_slot; sim->stale_todo && budget > 0;
+	     s = s + 1 < sim->nslots ? s + 1 : 0) {
+		struct lru_cast_tune_slot *sl = &sim->slot[s];
+		u32 w = sl->id ? lru_cast_mark(sl->w, sim->tick) : 0;
+		int m;
+
+		sim->stale_todo--;
+		budget--;
+		if (!w)
+			continue;
+		budget -= LRU_CAST_TUNE_MARK_MOVE;
+		sl->w = w;
+		for (m = 0; m < LRU_CAST_TUNE_SIM; m++) {
+			if ((sl->res & ~sl->inw) & BIT(m)) {
+				lru_cast_tune_unlink(sim, s, m);
+				lru_cast_tune_place(sim, m, s, lru_cast_tune_mkey(sim, m, s));
+			}
+		}
+		if (!RB_EMPTY_NODE(&sl->rb)) {
+			lru_cast_tune_oerase(sim, s);
+			lru_cast_tune_oinsert(sim, s, sl->seq);
+		}
+	}
+	sim->stale_slot = s;
+}
+
+/*
+ * A read of page @id at @tick, the nodes' clock: its slot, given one if it
+ * has none (LRU_CAST_TUNE_SIM_NONE: no room), and the read in its state word. @res:
+ * the caches it is resident in, before the read reaches them, and its rank
+ * in the order (lru_cast_tune_sim_rank()) is as it was, until lru_cast_tune_sim_access_all().
+ */
+u16 lru_cast_tune_sim_read(struct lru_cast_tune_sim *sim, u64 id, unsigned long tick, u32 *res)
+{
+	u16 s = lru_cast_tune_lookup(sim, id);
+	u32 old, n;
+
+	sim->tick = tick;
+	if (sim->stale_todo || tick != sim->stale_tick)
+		lru_cast_tune_mark(sim);
+	if (s == LRU_CAST_TUNE_SIM_NONE)
+		s = lru_cast_tune_alloc(sim, id);
+	if (s == LRU_CAST_TUNE_SIM_NONE)
+		return s;
+	old = sim->slot[s].w;
+	n = old >> 24;
+	sim->slot[s].w = lru_cast_push(old, sim->tick, min(n + 1, 255u));
+	*res = sim->slot[s].res;
+	return s;
+}
+
+/* ------------------------------------------------------------- caches */
+
+int lru_cast_tune_sim_le(struct lru_cast_tune_sim *sim, int m)
+{
+	return sim->c[m].le;
+}
+
+unsigned long lru_cast_tune_sim_count(struct lru_cast_tune_sim *sim, int m)
+{
+	return sim->c[m].count;
+}
+
+void lru_cast_tune_sim_set_cap(struct lru_cast_tune_sim *sim, int m, unsigned long cap)
+{
+	sim->c[m].cap = cap;
+}
+
+void lru_cast_tune_sim_set_wq(struct lru_cast_tune_sim *sim, int m, unsigned int wq)
+{
+	sim->c[m].wq = wq;
+}
+
+void lru_cast_tune_sim_stat(struct lru_cast_tune_sim *sim, int m, struct lru_cast_tune_sim_stat *st)
+{
+	struct lru_cast_tune_cache *c = &sim->c[m];
+
+	st->le = c->le;
+	st->wq = c->wq;
+	st->cap = c->cap;
+	st->count = c->count;
+	st->wcount = c->wcount;
+}
+
+/* the caches again: cache m takes le[m] and the pages of cache src[m]; the order, the centre's */
+void lru_cast_tune_sim_regrid(struct lru_cast_tune_sim *sim, const int *le, const int *src)
+{
+	unsigned int s, m, idx;
+
+	for (s = 0; s < sim->nslots; s++) {
+		struct lru_cast_tune_slot *sl = &sim->slot[s];
+		u16 res = 0, inw = 0;
+
+		if (!sl->id)
+			continue;
+		for (m = 0; m < LRU_CAST_TUNE_SIM; m++) {
+			if (sl->res & BIT(src[m]))
+				res |= BIT(m);
+			if (sl->inw & BIT(src[m]))
+				inw |= BIT(m);
+		}
+		sl->res = res;
+		sl->inw = inw;
+	}
+	for (m = 0; m < LRU_CAST_TUNE_SIM; m++) {
+		struct lru_cast_tune_cache *c = &sim->c[m];
+
+		c->le = le[m];
+		c->lo = lru_cast_tune_window_lo(sim, m);
+		c->count = c->wcount = 0;
+		bitmap_zero(c->nonempty, LRU_CAST_TUNE_BUCKETS);
+		for (idx = 0; idx < LRU_CAST_TUNE_HEADS; idx++) {
+			u16 h = lru_cast_tune_head(sim, m, idx);
+
+			sim->slot[h].lnk[m][0] = sim->slot[h].lnk[m][1] = h;
+		}
+	}
+	for (s = 0; s < sim->nslots; s++) {
+		struct lru_cast_tune_slot *sl = &sim->slot[s];
+
+		if (!sl->id || !sl->res)
+			continue;
+		for (m = 0; m < LRU_CAST_TUNE_SIM; m++) {
+			if (!(sl->res & BIT(m)))
+				continue;
+			sim->c[m].count++;
+			if (sl->inw & BIT(m)) {
+				lru_cast_tune_add_tail(sim, s, lru_cast_tune_whead(sim, m), m);
+				sim->c[m].wcount++;
+			} else {
+				lru_cast_tune_place(sim, m, s, lru_cast_tune_mkey(sim, m, s));
+			}
+		}
+	}
+	if (le[LRU_CAST_TUNE_CENTER] != sim->ole)
+		lru_cast_tune_oregrid(sim, le[LRU_CAST_TUNE_CENTER]);
+}
+
+/* ------------------------------------------------------------- set up */
+
+/* the most slots a sim can have: they, the sentinels and LRU_CAST_TUNE_SIM_NONE fit in a u16 */
+unsigned int lru_cast_tune_sim_max_slots(void)
+{
+	return LRU_CAST_TUNE_SIM_NONE - LRU_CAST_TUNE_SIM * LRU_CAST_TUNE_HEADS;
+}
+
+struct lru_cast_tune_sim *lru_cast_tune_sim_alloc(unsigned int nslots)
+{
+	unsigned int total = nslots + LRU_CAST_TUNE_SIM * LRU_CAST_TUNE_HEADS;
+	struct lru_cast_tune_sim *sim;
+
+	BUILD_BUG_ON(LRU_CAST_TUNE_SIM > 16);		/* res and inw are bitmasks */
+	BUILD_BUG_ON(LRU_CAST_LE_MAX >= 16);		/* khave is a bitmask */
+	if (WARN_ON_ONCE(nslots > lru_cast_tune_sim_max_slots()))
+		return NULL;
+	sim = kvmalloc(sizeof(*sim), LRU_CAST_TUNE_GFP);
+	if (!sim)
+		return NULL;
+	sim->nslots = nslots;
+	sim->hbits = ilog2(roundup_pow_of_two(nslots));
+	sim->slot = __vmalloc(array_size(total, sizeof(*sim->slot)), LRU_CAST_TUNE_GFP);
+	sim->hash = __vmalloc(array_size(1U << sim->hbits, sizeof(*sim->hash)), LRU_CAST_TUNE_GFP);
+	if (!sim->slot || !sim->hash) {
+		lru_cast_tune_sim_free(sim);
+		return NULL;
+	}
+	return sim;
+}
+
+void lru_cast_tune_sim_free(struct lru_cast_tune_sim *sim)
+{
+	if (!sim)
+		return;
+	vfree(sim->slot);
+	vfree(sim->hash);
+	kvfree(sim);
+}
+
+/* empty, every cache 256 pages at le[m], W's shares 0 */
+void lru_cast_tune_sim_init(struct lru_cast_tune_sim *sim, unsigned long tick, const int *le)
+{
+	unsigned int total = sim->nslots + LRU_CAST_TUNE_SIM * LRU_CAST_TUNE_HEADS, s;
+	int src[LRU_CAST_TUNE_SIM], m;
+
+	memset(sim->slot, 0, array_size(total, sizeof(*sim->slot)));
+	memset(sim->hash, 0xff, (1U << sim->hbits) * sizeof(*sim->hash));
+	memset(sim->c, 0, sizeof(sim->c));
+	sim->free = LRU_CAST_TUNE_SIM_NONE;
+	sim->kslot = LRU_CAST_TUNE_SIM_NONE;
+	for (s = sim->nslots; s-- > 0;) {
+		sim->slot[s].hnext = sim->free;
+		sim->free = s;
+	}
+	sim->tick = tick;
+	sim->order = RB_ROOT;
+	sim->ole = -1;
+	sim->tracked = 0;
+	sim->seq = 0;
+	sim->stale_tick = tick;
+	sim->stale_slot = 0;
+	sim->stale_todo = 0;
+	for (m = 0; m < LRU_CAST_TUNE_SIM; m++) {
+		sim->c[m].cap = 256;
+		src[m] = m;
+	}
+	lru_cast_tune_sim_regrid(sim, le, src);
+}
diff --git a/mm/lru_cast/tune/sim.h b/mm/lru_cast/tune/sim.h
new file mode 100644
index 0000000000..4aef61e831
--- /dev/null
+++ b/mm/lru_cast/tune/sim.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST -- LRU_CAST_TUNE_SIM simulated CAST caches of one type's sample, and
+ * its order (sim.c).
+ *
+ * A sampled page has a slot, found by its identity (lru_cast_tune_sim_read(), which
+ * also says which caches it is resident in), and one state word, by the
+ * nodes' clock, given with each read. Each cache has its decay le, W's
+ * share wq (in LRU_CAST_TUNE_WUNIT) and its size cap. The order ranks the pages read
+ * by key at the grid's centre: a cache of that decay and no W, of any
+ * size n, holds those ranked n or better (lru_cast_tune_sim_rank()).
+ *
+ * A read reaches every cache and the order in one call,
+ * lru_cast_tune_sim_access_all(): a page is taken in or moved up, and each cache is
+ * made to fit -- W over its share meets M's lowest, then the cache gives
+ * until it is within cap.
+ *
+ * All under the caller's lock; the sim takes none.
+ */
+#ifndef _MM_LRU_CAST_TUNE_SIM_H
+#define _MM_LRU_CAST_TUNE_SIM_H
+
+#include "tune/shape.h"
+
+#define LRU_CAST_TUNE_SIM_NONE	0xffff		/* no slot */
+
+struct lru_cast_tune_sim;
+
+struct lru_cast_tune_sim_stat {
+	int le;
+	unsigned int wq;
+	unsigned long cap, count, wcount;	/* size; pages resident, of them in W */
+};
+
+unsigned int lru_cast_tune_sim_max_slots(void);
+struct lru_cast_tune_sim *lru_cast_tune_sim_alloc(unsigned int nslots);
+void lru_cast_tune_sim_free(struct lru_cast_tune_sim *sim);
+void lru_cast_tune_sim_init(struct lru_cast_tune_sim *sim, unsigned long tick, const int *le);
+
+u16 lru_cast_tune_sim_read(struct lru_cast_tune_sim *sim, u64 id, unsigned long tick, u32 *res);
+void lru_cast_tune_sim_access_all(struct lru_cast_tune_sim *sim, u16 s, u32 res);
+unsigned int lru_cast_tune_sim_rank(struct lru_cast_tune_sim *sim, u16 s);
+unsigned int lru_cast_tune_sim_tracked(struct lru_cast_tune_sim *sim);
+
+int lru_cast_tune_sim_le(struct lru_cast_tune_sim *sim, int m);
+unsigned long lru_cast_tune_sim_count(struct lru_cast_tune_sim *sim, int m);
+void lru_cast_tune_sim_set_cap(struct lru_cast_tune_sim *sim, int m, unsigned long cap);
+void lru_cast_tune_sim_set_wq(struct lru_cast_tune_sim *sim, int m, unsigned int wq);
+void lru_cast_tune_sim_regrid(struct lru_cast_tune_sim *sim, const int *le, const int *src);
+void lru_cast_tune_sim_stat(struct lru_cast_tune_sim *sim, int m,
+			    struct lru_cast_tune_sim_stat *st);
+
+#endif /* _MM_LRU_CAST_TUNE_SIM_H */
diff --git a/mm/lru_cast/tune/tune.c b/mm/lru_cast/tune/tune.c
new file mode 100644
index 0000000000..b426937279
--- /dev/null
+++ b/mm/lru_cast/tune/tune.c
@@ -0,0 +1,475 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the controllers: the decay, W's share, and anon's share
+ * of memory.
+ *
+ * Three numbers of the main cache's operating point (policy/params.c) are
+ * chosen by measuring, not by tuning: per type the half-life its keys decay
+ * with, H = C * 2^(8 - le), and W's share w of its pages; and across the
+ * types anon's share of memory. A sample of the pages (sample.c) runs
+ * through simulated CAST caches at once (sim.c), LRU_CAST_TUNE_SIM of each type
+ * (shape.h): a grid of decays (decay.c) and a pair of W's shares (wshare.c);
+ * and the type's miss-ratio curve, its points worlds held at each split of
+ * memory with the other type (world.c), is read from the rank of each read
+ * in the type's order, file read ahead at each point (readahead.c). What
+ * they show (evidence.c) moves the decay and W of each type, and the split
+ * between them (share.c), its misses weighed by what a refault costs
+ * (cost.c).
+ *
+ * This file runs them: a read of a sampled page is an access to every
+ * cache of its type and to its order, and the decisions are taken every so
+ * many accesses.
+ *
+ * Every read the main cache records of a sampled page reaches here
+ * (hooks.c); a sampled page that is mapped is protected (protect.c), so
+ * that every read of it faults and comes here too. The caches share the
+ * pages' state words with the main cache, and its clock -- the nodes'
+ * ticks, so that le means the same half-life here as there.
+ *
+ * A read is not taken in where it happens: it is queued on its CPU and a
+ * worker takes the queues in, every few milliseconds or sooner, all under
+ * one lock -- a world holds of each type what the other leaves -- that no
+ * reader waits for. With the controllers off
+ * (lru_cast_tune_set_auto()) nothing is sampled: the numbers are set by hand.
+ */
+#include <linux/sysfs.h>
+#include <linux/percpu.h>
+#include "tune/tune.h"
+#include "tune/sim.h"
+#include "tune/world.h"
+#include "tune/sample.h"
+#include "tune/evidence.h"
+#include "tune/decay.h"
+#include "tune/wshare.h"
+#include "tune/share.h"
+#include "tune/cost.h"
+#include "policy/policy.h"
+
+struct lru_cast_tune_type {
+	int type;
+	struct lru_cast_tune_sim *sim;
+	struct lru_cast_tune_ra *ra;		/* file's: it is read ahead */
+	struct lru_cast_tune_evidence ev;
+	struct lru_cast_tune_w w;
+	unsigned long tick;		/* the nodes' clock, at the last read */
+	unsigned long cap;		/* each cache's size: the type's sample */
+	unsigned long events, next_eval, moves;
+};
+
+static struct lru_cast_tune_type *lru_cast_tune_types[ANON_AND_FILE];
+static DEFINE_MUTEX(lru_cast_tune_lock);
+static unsigned int lru_cast_tune_nslots;		/* slots per type */
+/* the curve's evidence: the tick it was last aged at, and the accesses it holds, in 1/256 */
+static unsigned long lru_cast_tune_aged;
+static long lru_cast_tune_held;
+
+unsigned int lru_cast_tune_on __read_mostly = 1;
+
+void lru_cast_tune_set_auto(bool on)
+{
+	WRITE_ONCE(lru_cast_tune_on, on);
+}
+
+/* ------------------------------------------------------------ decisions */
+
+/* the decay grid around @centre, each point from the nearest old one */
+static void lru_cast_tune_move(struct lru_cast_tune_type *t, int centre)
+{
+	int le[LRU_CAST_TUNE_SIM], src[LRU_CAST_TUNE_SIM];
+
+	lru_cast_tune_decay_regrid(t->sim, centre, le, src);
+	lru_cast_tune_sim_regrid(t->sim, le, src);
+	lru_cast_tune_ev_forget_grid(&t->ev);
+	lru_cast_tune_w_forget(&t->w);
+	t->moves++;
+	if (lru_cast_tune_auto())
+		lru_cast_param_set_le(t->type, centre);
+}
+
+/* each cache's size: the type's sample; the worlds', all memory's */
+static void lru_cast_tune_set_caps(struct lru_cast_tune_type *t)
+{
+	unsigned long all = lru_cast_tune_sample_pages(lru_cast_tune_type_pages(0) +
+							lru_cast_tune_type_pages(1));
+	int m;
+
+	lru_cast_tune_world_set_size(clamp(all, 512UL, (unsigned long)lru_cast_tune_nslots / 2));
+	for (m = 0; m < LRU_CAST_TUNE_CURVE; m++)
+		lru_cast_tune_sim_set_cap(t->sim, m, t->cap);
+}
+
+static void lru_cast_tune_evaluate(struct lru_cast_tune_type *t)
+{
+	int best = lru_cast_tune_decay_choose(&t->ev, t->sim);
+
+	lru_cast_tune_share_update(&lru_cast_tune_types[0]->ev, &lru_cast_tune_types[1]->ev);
+	lru_cast_tune_ev_decay(&t->ev);
+	if (best >= 0)
+		lru_cast_tune_move(t, lru_cast_tune_sim_le(t->sim, best));
+
+	t->cap = clamp(lru_cast_tune_sample_pages(lru_cast_tune_type_pages(t->type)), 256UL,
+		       (unsigned long)lru_cast_tune_nslots / LRU_CAST_TUNE_TABLE);
+	lru_cast_tune_set_caps(t);
+	t->next_eval = t->events + max(t->cap / 16, 32UL);
+}
+
+/* ---------------------------------------------------------------- reads */
+
+/*
+ * A read of a sampled page, as the caches take it: queued where it
+ * happened, taken in order of each CPU's queue, a queue at a time.
+ */
+struct lru_cast_tune_rec {
+	u64 id, block;
+	pgoff_t index;
+	unsigned long tick;		/* the nodes' clock when it was read */
+	unsigned int nr;
+	int type;
+};
+
+/*
+ * Each CPU's reads, until the worker takes them in (lru_cast_tune_drain()):
+ * a reader takes only its own CPU's lock, and the worker each one's for as
+ * long as it copies the queue out. Half full, the worker is called at
+ * once; otherwise the first read waits LRU_CAST_TUNE_DRAIN_DELAY at most.
+ * Full -- the worker behind -- a read is dropped: the caches see fewer
+ * reads when they cost more than a CPU.
+ */
+#define LRU_CAST_TUNE_QUEUE		256
+#define LRU_CAST_TUNE_DRAIN_DELAY	max(HZ / 100, 1)
+
+struct lru_cast_tune_queue {
+	spinlock_t lock;
+	unsigned int n;
+	struct lru_cast_tune_rec rec[LRU_CAST_TUNE_QUEUE];
+};
+
+static struct lru_cast_tune_queue __percpu *lru_cast_tune_queues;
+static struct lru_cast_tune_rec lru_cast_tune_taken[LRU_CAST_TUNE_QUEUE];	/* the worker's */
+static atomic_long_t lru_cast_tune_dropped;
+
+static void lru_cast_tune_drain(struct work_struct *work);
+static DECLARE_DELAYED_WORK(lru_cast_tune_drain_work, lru_cast_tune_drain);
+
+/*
+ * Both types' curve evidence aged together, a step a tick since the last,
+ * and while it holds more than it may: one time for both (evidence.c).
+ */
+static void lru_cast_tune_age(unsigned long tick)
+{
+	long ticks = tick - lru_cast_tune_aged;
+	int steps, type;
+
+	if (ticks > 0)
+		lru_cast_tune_aged = tick;
+	steps = clamp(ticks, 0L, (long)BITS_PER_LONG);
+	if (!steps && lru_cast_tune_held > LRU_CAST_TUNE_HELD * 256)
+		steps = 1;
+	while (steps--) {
+		for (type = 0; type < ANON_AND_FILE; type++)
+			lru_cast_tune_ev_age(&lru_cast_tune_types[type]->ev);
+		lru_cast_tune_held -= lru_cast_tune_held >> LRU_CAST_TUNE_AGE_SHIFT;
+	}
+}
+
+/* the read @r, taken in by the caches of its type */
+static void lru_cast_tune_take(struct lru_cast_tune_type *t, const struct lru_cast_tune_rec *r)
+{
+	int type = t->type, m;
+	unsigned int rank, read[ANON_AND_FILE];
+	u16 s, miss = 1, wait;
+	bool full, hit[LRU_CAST_TUNE_N];
+	u32 res;
+
+	/* the queues are taken one by one: a CPU's reads can be behind another's */
+	t->tick = max(t->tick, r->tick);
+	s = lru_cast_tune_sim_read(t->sim, r->id, t->tick, &res);
+	if (s == LRU_CAST_TUNE_SIM_NONE)
+		return;
+	for (m = 0; m < LRU_CAST_TUNE_SIM; m++)
+		hit[m] = res & BIT(m);
+	/*
+	 * The curve's points: a hit where the page ranked within what its type
+	 * holds in the world. Those that miss (bit p: p tenths), and of them
+	 * those that wait.
+	 */
+	rank = lru_cast_tune_sim_rank(t->sim, s);
+	read[0] = lru_cast_tune_sim_tracked(lru_cast_tune_types[0]->sim);
+	read[1] = lru_cast_tune_sim_tracked(lru_cast_tune_types[1]->sim);
+	for (m = LRU_CAST_TUNE_CURVE; m < LRU_CAST_TUNE_N; m++) {
+		int world = lru_cast_tune_world_of(type, m);
+
+		hit[m] = rank && rank <= lru_cast_tune_world_size(type, world, read);
+		if (!hit[m])
+			miss |= BIT(m - LRU_CAST_TUNE_CURVE + 1);
+	}
+	wait = t->ra ? lru_cast_tune_ra_waits(t->ra, r->block, r->index, r->nr, miss) : miss;
+	full = lru_cast_tune_sim_count(t->sim, LRU_CAST_TUNE_CENTER) >= t->cap;
+	lru_cast_tune_age(t->tick);
+	lru_cast_tune_ev_note(&t->ev, hit, wait, full);
+	lru_cast_tune_held += 256;
+	if (full)
+		lru_cast_tune_w_note(&t->w, hit[LRU_CAST_TUNE_WLO], hit[LRU_CAST_TUNE_WHI]);
+
+	lru_cast_tune_sim_access_all(t->sim, s, res);
+
+	if (++t->events >= t->next_eval)
+		lru_cast_tune_evaluate(t);
+	if (t->events >= t->w.next_wtest)
+		lru_cast_tune_w_test(&t->w, t->sim, type, t->events, t->cap);
+}
+
+/* the worker: every CPU's queue taken in, one after another */
+static void lru_cast_tune_drain(struct work_struct *work)
+{
+	int cpu;
+
+	for_each_possible_cpu(cpu) {
+		struct lru_cast_tune_queue *q = per_cpu_ptr(lru_cast_tune_queues, cpu);
+		unsigned int n, i;
+
+		if (!READ_ONCE(q->n))
+			continue;
+		spin_lock_irq(&q->lock);
+		n = q->n;
+		memcpy(lru_cast_tune_taken, q->rec, n * sizeof(q->rec[0]));
+		q->n = 0;
+		spin_unlock_irq(&q->lock);
+
+		mutex_lock(&lru_cast_tune_lock);
+		for (i = 0; i < n; i++) {
+			const struct lru_cast_tune_rec *r = &lru_cast_tune_taken[i];
+			struct lru_cast_tune_type *t = lru_cast_tune_types[r->type];
+
+			if (t)
+				lru_cast_tune_take(t, r);
+		}
+		mutex_unlock(&lru_cast_tune_lock);
+		cond_resched();
+	}
+}
+
+/* a read of @folio, whose block @block is in the sample (lru_cast_tune_read()): queued */
+void lru_cast_tune_event(struct folio *folio, u64 block)
+{
+	int type = folio_is_file_lru(folio);
+	struct lru_cast_tune_queue *q;
+	struct lru_cast_tune_rec r;
+	unsigned long flags;
+	unsigned int n;
+	bool taken;
+
+	if (!READ_ONCE(lru_cast_tune_types[type]))
+		return;
+
+	r = (struct lru_cast_tune_rec) {
+		.id = lru_cast_tune_sample_page(folio),
+		.block = block,
+		.index = folio->index,
+		.tick = lru_cast_ticks_now(),
+		.nr = folio_nr_pages(folio),
+		.type = type,
+	};
+	q = raw_cpu_ptr(lru_cast_tune_queues);
+	spin_lock_irqsave(&q->lock, flags);
+	n = q->n;
+	taken = n < LRU_CAST_TUNE_QUEUE;
+	if (taken) {
+		q->rec[n++] = r;
+		q->n = n;
+	}
+	spin_unlock_irqrestore(&q->lock, flags);
+	if (!taken)
+		atomic_long_inc(&lru_cast_tune_dropped);
+	else if (n == 1)
+		lru_cast_queue_delayed_work(&lru_cast_tune_drain_work, LRU_CAST_TUNE_DRAIN_DELAY);
+	else if (n == LRU_CAST_TUNE_QUEUE / 2)
+		lru_cast_mod_delayed_work(&lru_cast_tune_drain_work, 0);
+
+	/* mapped, its next reads are caught by a protection fault */
+	if (folio_mapped(folio))
+		lru_cast_protect_queue(folio);
+}
+
+/*
+ * do_swap_page(): an anon page swapped in, just mapped. Its refault was a
+ * read the main cache counted (policy/ghost.c), but the page had no
+ * identity then -- an anon folio in the swap cache has no mapping -- and
+ * the sample could not see it: the reads it would miss are exactly those
+ * of the pages the main cache evicted, which would make them look cold to
+ * the controllers and evicted the more. Mapped, the page has its identity,
+ * and the read is passed on now.
+ */
+void lru_cast_swapin(struct folio *folio)
+{
+	if (lru_cast_enabled())
+		lru_cast_tune_read(folio);
+}
+
+/* ------------------------------------------------------------------ setup */
+
+static void lru_cast_tune_free(struct lru_cast_tune_type *t)
+{
+	if (!t)
+		return;
+	lru_cast_tune_sim_free(t->sim);
+	lru_cast_tune_ra_free(t->ra);
+	kvfree(t);
+}
+
+static struct lru_cast_tune_type *lru_cast_tune_alloc_type(int type)
+{
+	struct lru_cast_tune_type *t = kvzalloc(sizeof(*t), LRU_CAST_TUNE_GFP);
+
+	if (!t)
+		return NULL;
+	t->sim = lru_cast_tune_sim_alloc(lru_cast_tune_nslots);
+	t->ra = type ? lru_cast_tune_ra_alloc() : NULL;
+	if (!t->sim || (type && !t->ra)) {
+		lru_cast_tune_free(t);
+		return NULL;
+	}
+	return t;
+}
+
+/* a type's sample, empty, its caches at the decay and W the knobs hold now */
+static void lru_cast_tune_init_type(struct lru_cast_tune_type *t, int type)
+{
+	int le[LRU_CAST_TUNE_SIM], src[LRU_CAST_TUNE_SIM];
+
+	t->type = type;
+	t->tick = lru_cast_ticks_now();
+	t->cap = 256;
+	t->events = t->moves = 0;
+	t->next_eval = 32;
+	lru_cast_tune_decay_grid(lru_cast_param_le(type), le, src);
+	lru_cast_tune_sim_init(t->sim, t->tick, le);
+	if (t->ra)
+		lru_cast_tune_ra_init(t->ra);
+	lru_cast_tune_ev_reset(&t->ev);
+	lru_cast_tune_w_init(&t->w, lru_cast_param_w(type), t->sim);
+}
+
+/*
+ * CAST coming on: the controllers start afresh -- empty samples, the
+ * worlds' clocks at zero, the share unset, the costs at their prior. What
+ * they had learnt before CAST last went off is of another time, its pages
+ * since freed and their state words cleared (lru_cast_clear_states()); kept,
+ * it would weigh as if it were now, the more for the clocks having stood
+ * still meanwhile. Decay and W start where the knobs are.
+ *
+ * The samples are taken out from under lru_cast_tune_lock, set up again where they
+ * are, and put back: nothing reaches them meanwhile (lru_cast_tune_types[] is read under
+ * the lock), the reads queued of before dropped, and no memory is wanted but
+ * the first time. Short of it then, CAST does not come on
+ * (lru_cast_set_enabled()), and tries again the next time it is asked to.
+ */
+int lru_cast_tune_init(void)
+{
+	struct lru_cast_tune_type *t[ANON_AND_FILE];
+	int type, cpu;
+
+	if (!lru_cast_tune_queues) {
+		lru_cast_tune_queues = alloc_percpu_gfp(struct lru_cast_tune_queue, LRU_CAST_TUNE_GFP);
+		if (!lru_cast_tune_queues)
+			return -ENOMEM;
+		for_each_possible_cpu(cpu)
+			spin_lock_init(&per_cpu_ptr(lru_cast_tune_queues, cpu)->lock);
+	}
+	if (!lru_cast_tune_nslots) {
+		lru_cast_tune_sample_init(totalram_pages());
+		lru_cast_tune_nslots = min(LRU_CAST_TUNE_TARGET * LRU_CAST_TUNE_TABLE,
+					   lru_cast_tune_sim_max_slots());
+	}
+
+	mutex_lock(&lru_cast_tune_lock);
+	for (type = 0; type < ANON_AND_FILE; type++) {
+		t[type] = lru_cast_tune_types[type];
+		lru_cast_tune_types[type] = NULL;
+	}
+	lru_cast_tune_world_reset();
+	lru_cast_tune_share_reset();
+	mutex_unlock(&lru_cast_tune_lock);
+	lru_cast_tune_cost_reset();
+
+	cancel_delayed_work_sync(&lru_cast_tune_drain_work);
+	for_each_possible_cpu(cpu) {
+		struct lru_cast_tune_queue *q = per_cpu_ptr(lru_cast_tune_queues, cpu);
+
+		spin_lock_irq(&q->lock);
+		q->n = 0;
+		spin_unlock_irq(&q->lock);
+	}
+
+	for (type = 0; type < ANON_AND_FILE; type++)
+		if (!t[type])
+			t[type] = lru_cast_tune_alloc_type(type);
+	if (!t[0] || !t[1]) {		/* the worlds need both */
+		lru_cast_tune_free(t[0]);
+		lru_cast_tune_free(t[1]);
+		return -ENOMEM;
+	}
+	for (type = 0; type < ANON_AND_FILE; type++)
+		lru_cast_tune_init_type(t[type], type);
+
+	mutex_lock(&lru_cast_tune_lock);
+	for (type = 0; type < ANON_AND_FILE; type++)
+		lru_cast_tune_types[type] = t[type];
+	lru_cast_tune_aged = t[0]->tick;
+	lru_cast_tune_held = 0;
+	mutex_unlock(&lru_cast_tune_lock);
+	return 0;
+}
+
+int lru_cast_tune_show(char *buf)
+{
+	int type, m, len = 0;
+
+	for (type = 0; type < ANON_AND_FILE; type++) {
+		unsigned int read[ANON_AND_FILE];
+		struct lru_cast_tune_sim_stat st;
+		struct lru_cast_tune_type *t;
+
+		mutex_lock(&lru_cast_tune_lock);
+		t = lru_cast_tune_types[type];
+		if (!t) {
+			mutex_unlock(&lru_cast_tune_lock);
+			continue;
+		}
+		len += sysfs_emit_at(buf, len,
+				     "%s le %d w %u/1000 share %u/1000%s cap %lu events %lu moves %lu wmoves %lu tick %lu test %lld/%lld\n",
+				     type ? "file" : "anon",
+				     lru_cast_tune_sim_le(t->sim, LRU_CAST_TUNE_CENTER),
+				     t->w.wq * 1000 / LRU_CAST_TUNE_WUNIT,
+				     type ? 1000 - lru_cast_param_share() : lru_cast_param_share(),
+				     lru_cast_param_share_held() ? "" : " (unset)",
+				     t->cap, t->events, t->moves,
+				     t->w.wmoves, t->tick, t->w.ws, t->w.wn);
+		for (m = 0; m < LRU_CAST_TUNE_SIM; m++) {
+			lru_cast_tune_sim_stat(t->sim, m, &st);
+			len += sysfs_emit_at(buf, len,
+					     "  le %2d w %4u cap %5lu resident %5lu W %5lu miss %lld dis %lld\n",
+					     st.le, st.wq * 1000 / LRU_CAST_TUNE_WUNIT,
+					     st.cap, st.count, st.wcount,
+					     t->ev.miss[m] >> 8, t->ev.dis[m] >> 8);
+		}
+		/* the curve: what the type holds in each world, of what it has read */
+		for (m = 0; m < ANON_AND_FILE; m++)
+			read[m] = lru_cast_tune_types[m] ?
+				  lru_cast_tune_sim_tracked(lru_cast_tune_types[m]->sim) : 0;
+		for (m = LRU_CAST_TUNE_CURVE; m < LRU_CAST_TUNE_N; m++) {
+			int world = lru_cast_tune_world_of(type, m);
+			unsigned long held = lru_cast_tune_world_size(type, world, read);
+
+			len += sysfs_emit_at(buf, len,
+					     "  le %2d w    0 cap %5lu resident %5lu W     0 miss %lld dis %lld\n",
+					     lru_cast_tune_sim_le(t->sim, LRU_CAST_TUNE_CENTER),
+					     held,
+					     min(held, (unsigned long)read[type]),
+					     t->ev.miss[m] >> 8, t->ev.dis[m] >> 8);
+		}
+		mutex_unlock(&lru_cast_tune_lock);
+	}
+	len += sysfs_emit_at(buf, len, "reads dropped %ld\n", atomic_long_read(&lru_cast_tune_dropped));
+	return len;
+}
diff --git a/mm/lru_cast/tune/tune.h b/mm/lru_cast/tune/tune.h
new file mode 100644
index 0000000000..1980704870
--- /dev/null
+++ b/mm/lru_cast/tune/tune.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST -- the controllers: what the main cache's operating point
+ * (policy/params.c) should be, measured on a sample of the pages.
+ *
+ *   tune.c       runs them: each read of a sampled page, the decisions
+ *   sample.c     which pages are sampled
+ *   sim.c        the simulated caches of a type's sample (shape.h: which)
+ *   world.c      the curve's points, memory held at each split
+ *   readahead.c  file's misses readahead covers, at each point
+ *   evidence.c   what the caches showed
+ *   decay.c      the decay, from the grid of decays
+ *   wshare.c     W's share, from the pair of shares
+ *   share.c      anon's share of memory, from the curves
+ *   cost.c       what a refault costs, per type
+ *   protect.c    every read of a sampled mapped page, by a protection fault
+ *
+ * Built on core/ and on policy/'s parameters, which it sets. Inside, each
+ * file has its own header; sim.c's caches and readahead.c's blocks are
+ * reached only through theirs.
+ */
+#ifndef _MM_LRU_CAST_TUNE_H
+#define _MM_LRU_CAST_TUNE_H
+
+#include <linux/hash.h>
+#include "core/core.h"
+
+#define LRU_CAST_TUNE_BLOCK	32	/* pages sampled together: readahead's window */
+
+extern u32 lru_cast_tune_threshold;	/* sample.c: sampled, a block's hash >> 32 below it */
+extern unsigned int lru_cast_tune_on;	/* tune.c: the controllers set the numbers */
+
+/* the controllers set the decay, W's share and anon's share; off, they are set by hand */
+static inline bool lru_cast_tune_auto(void)
+{
+	return READ_ONCE(lru_cast_tune_on);
+}
+
+/* (mapping, @index) mixed to 64 bits (splitmix64's finaliser): 0 for no mapping */
+static inline u64 lru_cast_tune_mix(struct address_space *mapping, pgoff_t index)
+{
+	u64 x = (unsigned long)mapping;
+
+	if (!x)
+		return 0;
+	x ^= index * GOLDEN_RATIO_64;
+	x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+	x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+	return (x ^ (x >> 31)) | 1;
+}
+
+/* the identity of @folio's block (sample.c) */
+static inline u64 lru_cast_tune_block(struct folio *folio)
+{
+	return lru_cast_tune_mix(READ_ONCE(folio->mapping), folio->index / LRU_CAST_TUNE_BLOCK);
+}
+
+static inline bool lru_cast_tune_in(u64 block)
+{
+	return block && (u32)(block >> 32) < READ_ONCE(lru_cast_tune_threshold);
+}
+
+static inline bool lru_cast_tune_sampled(struct folio *folio)
+{
+	return lru_cast_tune_in(lru_cast_tune_block(folio));
+}
+
+/* tune.c */
+int lru_cast_tune_init(void);			/* each time CAST comes on */
+void lru_cast_tune_event(struct folio *folio, u64 block);
+void lru_cast_tune_set_auto(bool on);
+
+/*
+ * A read of @folio, for the controllers if it is in their sample. Every
+ * read the main cache records is asked this, and all but one in some
+ * fifty are not: asked inline, they cost no call.
+ */
+static inline void lru_cast_tune_read(struct folio *folio)
+{
+	u64 block;
+
+	if (!lru_cast_tune_auto())
+		return;
+	block = lru_cast_tune_block(folio);
+	if (lru_cast_tune_in(block))
+		lru_cast_tune_event(folio, block);
+}
+int lru_cast_tune_show(char *buf);
+int lru_cast_tune_estimate_show(char *buf);
+
+/* protect.c */
+bool lru_cast_protect_active(void);
+void lru_cast_protect_queue(struct folio *folio);
+void lru_cast_protect_installed(long nr, unsigned long size);
+int lru_cast_protect_show(char *buf, int len);
+
+#endif /* _MM_LRU_CAST_TUNE_H */
diff --git a/mm/lru_cast/tune/world.c b/mm/lru_cast/tune/world.c
new file mode 100644
index 0000000000..d91733e87b
--- /dev/null
+++ b/mm/lru_cast/tune/world.c
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the curve's worlds.
+ *
+ * A point of the curve is a world: memory held at that split, as the real
+ * cache would be -- anon's cache at k tenths and file's at the rest are one
+ * cache of all memory's sample, and on a miss with it full the type over
+ * its share gives: the split held, which reclaim presses toward. A type short of its share leaves the
+ * rest to the other: a world is what memory would be at its split, not at
+ * one where each type fills its share whatever it needs.
+ *
+ * What each type holds in a world follows from that rule alone. A type at
+ * or under its share gives nothing, so it holds every page it has read, up
+ * to its share; over it, it holds what the other leaves. And what it holds
+ * is the top of its order (sim.c): the curve is read from the ranks, the
+ * worlds kept as numbers, not as caches.
+ */
+#include "tune/world.h"
+
+/* all memory's sample: the worlds' size */
+static unsigned long lru_cast_tune_all = 512;
+
+void lru_cast_tune_world_reset(void)
+{
+	WRITE_ONCE(lru_cast_tune_all, 512);
+}
+
+void lru_cast_tune_world_set_size(unsigned long all)
+{
+	WRITE_ONCE(lru_cast_tune_all, all);
+}
+
+/*
+ * The pages @type holds in world @k -- anon's cache at k tenths, file's at
+ * the rest -- the types having read @read[0] and @read[1] pages: one of
+ * them read no more than its share holds all it read, and the other the
+ * rest; else each holds its share.
+ */
+unsigned long lru_cast_tune_world_size(int type, int k, const unsigned int *read)
+{
+	unsigned long all = READ_ONCE(lru_cast_tune_all), share[ANON_AND_FILE], held[ANON_AND_FILE];
+
+	share[0] = k * all / LRU_CAST_TUNE_SHARES;
+	share[1] = all - share[0];
+	if (read[0] <= share[0]) {
+		held[0] = read[0];
+		held[1] = all - held[0];
+	} else if (read[1] <= share[1]) {
+		held[1] = read[1];
+		held[0] = all - held[1];
+	} else {
+		held[0] = share[0];
+		held[1] = share[1];
+	}
+	return held[type];
+}
