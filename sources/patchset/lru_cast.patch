diff --git a/mm/lru_cast/walk/bloom.c b/mm/lru_cast/walk/bloom.c
new file mode 100644
index 0000000000..a00de1e07b
--- /dev/null
+++ b/mm/lru_cast/walk/bloom.c
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the bloom of PMDs reclaim found young (Marie's).
+ *
+ * Where the walker cannot ask the hardware whether anything under a PMD
+ * was used -- no accessed bit kept in a non-leaf PMD, or an mm with a
+ * secondary MMU (KVM), whose accesses do not walk these page tables --
+ * it asks this instead: the PMDs in which reclaim's look-around
+ * (lookaround.c) found a young folio since the walk before. It is a list
+ * of PMDs reclaim has already reached, so it is the fallback, not the
+ * gate: a region gets in only once reclaim has visited it.
+ *
+ * Two filters, keyed by (mm, PMD), 1 << 15 bits and two hashes each: the
+ * look-around sets bits in one while the walker reads the other, and at
+ * the end of each walk they trade places and the one to fill is cleared.
+ * Lock-free; a bit lost to a swap racing a set costs one PMD a walk.
+ */
+#include <linux/bitmap.h>
+#include <linux/hash.h>
+#include "walk/young.h"
+
+#define LRU_CAST_BLOOM_SHIFT	15
+#define LRU_CAST_BLOOM_BITS		(1U << LRU_CAST_BLOOM_SHIFT)
+
+static DECLARE_BITMAP(lru_cast_bloom_filter[2], LRU_CAST_BLOOM_BITS);
+static int lru_cast_bloom_read;	/* the walker's filter; the other is filled */
+
+static void lru_cast_bloom_keys(struct mm_struct *mm, unsigned long addr, unsigned int *key)
+{
+	u64 h = hash_64((addr >> PMD_SHIFT) ^ ((u64)(unsigned long)mm >> 6) * GOLDEN_RATIO_64,
+			2 * LRU_CAST_BLOOM_SHIFT);
+
+	key[0] = h & (LRU_CAST_BLOOM_BITS - 1);
+	key[1] = (h >> LRU_CAST_BLOOM_SHIFT) & (LRU_CAST_BLOOM_BITS - 1);
+}
+
+void lru_cast_bloom_set(struct mm_struct *mm, unsigned long addr)
+{
+	unsigned long *f = lru_cast_bloom_filter[!READ_ONCE(lru_cast_bloom_read)];
+	unsigned int key[2];
+
+	lru_cast_bloom_keys(mm, addr, key);
+	if (!test_bit(key[0], f))
+		set_bit(key[0], f);
+	if (!test_bit(key[1], f))
+		set_bit(key[1], f);
+}
+
+bool lru_cast_bloom_test(struct mm_struct *mm, unsigned long addr)
+{
+	unsigned long *f = lru_cast_bloom_filter[READ_ONCE(lru_cast_bloom_read)];
+	unsigned int key[2];
+
+	lru_cast_bloom_keys(mm, addr, key);
+	return test_bit(key[0], f) && test_bit(key[1], f);
+}
+
+/* a walk done: it reads next what reclaim found since; the old one fills afresh */
+void lru_cast_bloom_swap(void)
+{
+	int r = !READ_ONCE(lru_cast_bloom_read);
+
+	WRITE_ONCE(lru_cast_bloom_read, r);
+	bitmap_zero(lru_cast_bloom_filter[!r], LRU_CAST_BLOOM_BITS);
+}
diff --git a/mm/lru_cast/walk/lookaround.c b/mm/lru_cast/walk/lookaround.c
new file mode 100644
index 0000000000..1708cb29d1
--- /dev/null
+++ b/mm/lru_cast/walk/lookaround.c
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the look-around (Marie's): reclaim's references check, a
+ * little wider.
+ *
+ * folio_referenced_one() asks whether a mapped folio was used, with the
+ * page table's lock held for its PTE. CAST answers through here: the
+ * folio's own young bit is cleared and returned, as the plain check would;
+ * and when it was young, the PMD goes into the walker's bloom (bloom.c), and
+ * the PTEs around it -- at most LRU_CAST_LOOK_AROUND of them, inside the PMD
+ * and the VMA -- are read under the same lock: what would be one rmap walk
+ * per neighbouring folio comes as one pass. A young neighbour is taken by
+ * the walker's rule (lru_cast_young_take()) and recorded as its read.
+ *
+ * A secondary MMU's accesses are asked of it (lru_cast_ptep_clear_young()).
+ * The neighbours are left alone when the lock is contended -- someone is
+ * waiting for it -- in special mappings, and in program text, whose young
+ * bits reclaim keeps for itself (mm/vmscan.c).
+ */
+#include <linux/mmu_notifier.h>
+#include <linux/rmap.h>
+#include <linux/sysfs.h>
+#include "walk/walk.h"
+#include "walk/young.h"
+
+#define LRU_CAST_LOOK_AROUND	BITS_PER_LONG	/* PTEs read per call */
+
+/* calls whose folio was young, and the neighbours' young bits taken */
+static atomic_long_t kl_young, kl_taken;
+
+int lru_cast_look_around_show(char *buf, int len)
+{
+	return len + sysfs_emit_at(buf, len, "lookaround young %ld taken %ld\n",
+				   atomic_long_read(&kl_young), atomic_long_read(&kl_taken));
+}
+
+bool lru_cast_look_around(struct page_vma_mapped_walk *pvmw)
+{
+	struct vm_area_struct *vma = pvmw->vma;
+	struct folio *target = pfn_folio(pvmw->pfn), *last = target;
+	unsigned long addr = pvmw->address, start, end, a;
+	unsigned int l3 = READ_ONCE(lru_cast_pf_l3), l1 = READ_ONCE(lru_cast_pf_l1), i, n;
+	pte_t *pte;
+
+	lockdep_assert_held(pvmw->ptl);
+
+	if (!lru_cast_ptep_clear_young(vma, addr, pvmw->pte))
+		return false;
+
+	lru_cast_bloom_set(vma->vm_mm, addr);
+	atomic_long_inc(&kl_young);
+
+	if (spin_is_contended(pvmw->ptl) || (vma->vm_flags & VM_SPECIAL) ||
+	    ((vma->vm_flags & VM_EXEC) && vma->vm_file))
+		return true;
+
+	/* centred on @addr, inside the PMD and the VMA */
+	start = max(addr & PMD_MASK, vma->vm_start);
+	end = min(addr | ~PMD_MASK, vma->vm_end - 1) + 1;
+	if (end - start > LRU_CAST_LOOK_AROUND * PAGE_SIZE) {
+		start = max(start, addr - min(addr - start, LRU_CAST_LOOK_AROUND * PAGE_SIZE / 2));
+		start = min(start, end - LRU_CAST_LOOK_AROUND * PAGE_SIZE);
+		end = start + LRU_CAST_LOOK_AROUND * PAGE_SIZE;
+	}
+
+	lru_cast_lazy_mmu_enter();
+	pte = pvmw->pte - ((addr - start) >> PAGE_SHIFT);
+	n = (end - start) >> PAGE_SHIFT;
+	if (mm_has_notifiers(vma->vm_mm))	/* no young bits to tell which */
+		l3 = 0;
+	/* the young frames read next pulled in: l3 of them toward L3, the first l1 on to L1 */
+	for (i = 0; i < min(l3, n); i++)
+		lru_cast_young_ahead(pte + i, i < l1);
+	for (a = start, i = 0; a != end; a += PAGE_SIZE, pte++, i++) {
+		pte_t val = ptep_get(pte);
+		struct folio *folio;
+
+		if (l3 && i + l3 < n)
+			lru_cast_young_ahead(pte + l3, false);
+		if (l3 && i + l1 < n)
+			lru_cast_young_ahead(pte + l1, true);
+
+		if (a == addr || !pte_present(val) || pte_protnone(val))
+			continue;
+		if (!pte_young(val) && !mm_has_notifiers(vma->vm_mm))
+			continue;
+		folio = vm_normal_folio(vma, a, val);
+		/* one read a folio: its other PTEs, and the target's, are passed */
+		if (!folio || folio == last || folio == target || !folio_test_lru(folio))
+			continue;
+		if (!lru_cast_young_take(folio))
+			continue;
+		if (lru_cast_ptep_clear_young(vma, a, pte)) {
+			last = folio;
+			lru_cast_young_record(folio);
+			atomic_long_inc(&kl_taken);
+		}
+	}
+	lru_cast_lazy_mmu_leave();
+	return true;
+}
diff --git a/mm/lru_cast/walk/simd.h b/mm/lru_cast/walk/simd.h
new file mode 100644
index 0000000000..722ac20ada
--- /dev/null
+++ b/mm/lru_cast/walk/simd.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _MM_LRU_CAST_WALK_SIMD_H
+#define _MM_LRU_CAST_WALK_SIMD_H
+
+/*
+ * CAST -- the young bits of one page table, at once.
+ *
+ *	lru_cast_young_pte_mask(table, bitmap);
+ *
+ * sets bit i of @bitmap (LRU_CAST_PTE_LONGS longs, cleared by the caller) for
+ * each PTE of the table at @table with its accessed bit set, whatever else
+ * it holds: the walker looks again at those (present, not PROT_NONE) and
+ * at those only. On x86 a SIMD kernel does it inside kernel_fpu_begin/end
+ * -- the walker is a kthread, which has no FPU state to save -- picked at
+ * boot from AVX-512F, AVX2 and SSE2; lru_cast_simd_enable() (sysfs
+ * walker_simd) turns it off for comparison. Elsewhere it is pte_young() in
+ * a loop. The switch and the name are in walk.h.
+ */
+#include <linux/types.h>
+#include <linux/bits.h>
+#include <linux/pgtable.h>
+
+#define LRU_CAST_PTE_LONGS	BITS_TO_LONGS(PTRS_PER_PTE)
+
+void lru_cast_young_pte_mask(const void *table, unsigned long *bitmap);
+
+#endif /* _MM_LRU_CAST_WALK_SIMD_H */
diff --git a/mm/lru_cast/walk/simd_generic.c b/mm/lru_cast/walk/simd_generic.c
new file mode 100644
index 0000000000..6f729aa9fe
--- /dev/null
+++ b/mm/lru_cast/walk/simd_generic.c
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the young-bit scan where there is no SIMD kernel: the
+ * arch's pte_young(), one PTE at a time.
+ */
+#include <linux/bitmap.h>
+#include <linux/mm.h>
+#include "walk/walk.h"
+#include "walk/simd.h"
+
+void lru_cast_young_pte_mask(const void *table, unsigned long *bitmap)
+{
+	const pte_t *pte = table;
+	int i;
+
+	for (i = 0; i < PTRS_PER_PTE; i++)
+		if (pte_young(ptep_get((pte_t *)&pte[i])))
+			__set_bit(i, bitmap);
+}
+
+bool lru_cast_simd_enabled(void)
+{
+	return false;
+}
+
+int lru_cast_simd_enable(bool on)
+{
+	return on ? -EINVAL : 0;
+}
+
+const char *lru_cast_simd_name(void)
+{
+	return "scalar";
+}
diff --git a/mm/lru_cast/walk/simd_x86.c b/mm/lru_cast/walk/simd_x86.c
new file mode 100644
index 0000000000..2e38ac9154
--- /dev/null
+++ b/mm/lru_cast/walk/simd_x86.c
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the young-bit scan on x86-64: the widest of the three SIMD
+ * kernels the CPU has, called directly (a static call, patched at boot).
+ */
+#include <linux/init.h>
+#include <linux/static_call.h>
+#include <asm/cpufeature.h>
+#include <asm/fpu/api.h>
+#include <asm/pgtable.h>
+#include "walk/walk.h"
+#include "walk/simd.h"
+
+asmlinkage void lru_cast_simd_scan_sse2(const pte_t *table, unsigned long *bitmap);
+asmlinkage void lru_cast_simd_scan_avx2(const pte_t *table, unsigned long *bitmap);
+asmlinkage void lru_cast_simd_scan_avx512(const pte_t *table, unsigned long *bitmap);
+
+DEFINE_STATIC_CALL(lru_cast_simd_scan, lru_cast_simd_scan_sse2);	/* SSE2: x86-64's floor */
+
+static unsigned int lru_cast_simd_on = 1;
+static const char *lru_cast_simd_isa = "sse2";
+
+static void lru_cast_scan_scalar(const pte_t *pte, unsigned long *bitmap)
+{
+	int i;
+
+	for (i = 0; i < 512; i++)
+		if (pte_val(pte[i]) & _PAGE_ACCESSED)
+			__set_bit(i, bitmap);
+}
+
+void lru_cast_young_pte_mask(const void *table, unsigned long *bitmap)
+{
+	if (!READ_ONCE(lru_cast_simd_on)) {
+		lru_cast_scan_scalar(table, bitmap);
+		return;
+	}
+	kernel_fpu_begin();
+	static_call(lru_cast_simd_scan)(table, bitmap);
+	kernel_fpu_end();
+}
+
+bool lru_cast_simd_enabled(void)
+{
+	return READ_ONCE(lru_cast_simd_on);
+}
+
+int lru_cast_simd_enable(bool on)
+{
+	WRITE_ONCE(lru_cast_simd_on, on);
+	return 0;
+}
+
+const char *lru_cast_simd_name(void)
+{
+	return READ_ONCE(lru_cast_simd_on) ? lru_cast_simd_isa : "scalar";
+}
+
+static int __init lru_cast_simd_init(void)
+{
+	if (boot_cpu_has(X86_FEATURE_AVX512F)) {
+		static_call_update(lru_cast_simd_scan, lru_cast_simd_scan_avx512);
+		lru_cast_simd_isa = "avx512";
+	} else if (boot_cpu_has(X86_FEATURE_AVX2)) {
+		static_call_update(lru_cast_simd_scan, lru_cast_simd_scan_avx2);
+		lru_cast_simd_isa = "avx2";
+	}
+	return 0;
+}
+arch_initcall(lru_cast_simd_init);
diff --git a/mm/lru_cast/walk/simd_x86_avx2.S b/mm/lru_cast/walk/simd_x86_avx2.S
new file mode 100644
index 0000000000..3978648a80
--- /dev/null
+++ b/mm/lru_cast/walk/simd_x86_avx2.S
@@ -0,0 +1,170 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * mm/lru_cast/simd_x86_avx2.S -- AVX2 PTE young-bit scan for the CAST walker.
+ *
+ * Processes 512 PTEs (one full PMD page table) per call, producing an
+ * 8-ulong (512-bit) young-bit bitmap.  4 PTEs are handled per SIMD
+ * iteration via a single 256-bit YMM load; 16 iterations fill one
+ * output ulong; 8 ulongs total.
+ *
+ * Variant chosen: counter-based rolled loop (outer=8, inner=16).
+ * Reason: mirrors the SSE2 kernel structure for auditability; 128
+ * fully-unrolled SIMD blocks would exceed 3000 instructions with no
+ * measurable throughput gain on modern out-of-order cores (loop
+ * overhead is < 1% of SIMD work).
+ *
+ * Why AVX2 is cleaner than SSE2 here:
+ *   AVX2 has 64-bit-lane ops (VPSLLQ shifts whole 64-bit PTEs), so the
+ *   young bit (bit 5) can be shifted straight into the sign bit (bit 63)
+ *   and read out -- no SSE2-style PSHUFD/SHUFPS low-dword packing to
+ *   dodge the PFN false positive in the high 32 bits, and no broadcast
+ *   mask constant at all.
+ *
+ *   VPSLLQ $58 moves bit 5 to bit 63; VMOVMSKPD then extracts the sign
+ *   bit of each of the 4 64-bit lanes into eax[3:0] -- one bit per PTE,
+ *   no per-PTE scalar work.  That 4-bit young mask is the GPR-side
+ *   analogue of the AVX-512 kernel's kmovw(k1) and drops straight into
+ *   the accumulator via a single variable shift, replacing both the
+ *   VPAND + VPCMPEQQ compare and the byte-granular VPMOVMSKB + four
+ *   per-PTE test/setnz/shift sequences of earlier revisions.
+ *
+ * Caller (lru_cast_young_pte_mask() in mm/lru_cast/simd_x86.c)
+ * holds kernel_fpu_begin/end around this.
+ * from C without an FPU context bracket.
+ *
+ * ABI (System V AMD64):
+ *   rdi = const pte_t *pte_table  (512 PTEs, 4096 bytes, page-table base;
+ *                                  page-aligned by the kernel page-table
+ *                                  allocator; vmovdqu is used so no stricter
+ *                                  SIMD alignment is required for the input)
+ *   rsi = unsigned long *bitmap   (8 ulongs = 64 bytes, caller pre-cleared)
+ *
+ * Register usage:
+ *   ymm1  = 4-PTE scratch register (no mask-constant register needed)
+ *   rdi   = current PTE pointer (walks forward by 32 bytes per inner iter)
+ *   rsi   = bitmap base (constant)
+ *   rdx   = outer loop counter (8 -> 0)
+ *   rcx   = bit-position counter within current ulong (steps of 4, 0..60);
+ *           cl is directly the shlq shift count, so no register move and no
+ *           push/pop-around-shlq are needed
+ *   rax   = vmovmskpd result (4-bit young mask) / shift scratch
+ *   r8    = per-ulong accumulator
+ *   r10   = inner loop counter (16 -> 0)
+ *   r11   = bitmap write pointer (rsi + outer*8, updated each outer iter)
+ *
+ * AVX2 only (no AVX-512 zmm/kmask/opmask):
+ *   vmovdqu, vpsllq, vmovmskpd, vzeroupper -- all AVX2.
+ *   All VEX-encoded to avoid SSE/AVX transition penalties.
+ *   VZEROUPPER before RET to clear upper YMM halves for subsequent
+ *   legacy SSE code.
+ */
+
+#include <linux/linkage.h>
+#include <linux/cfi_types.h>
+
+	/* -------------------------------------------------------------- */
+	/* Text  (no rodata: the young bit is shifted into the sign bit,  */
+	/*        so there is no broadcast mask constant)                  */
+	/* -------------------------------------------------------------- */
+	.text
+
+/*
+ * void lru_cast_simd_scan_avx2(const pte_t *pte_table, unsigned long *bitmap)
+ *
+ * pte_table: rdi -- 512 PTEs (4096 bytes), page-table base (8-byte aligned)
+ * bitmap:    rsi -- 8 ulongs (64 bytes), caller pre-cleared
+ */
+SYM_TYPED_FUNC_START(lru_cast_simd_scan_avx2)
+
+	movq	%rsi, %r11		/* r11 = current bitmap word ptr    */
+	movl	$8, %edx		/* outer counter: 8 ulongs          */
+
+	/*
+	 * Outer loop: one iteration per output ulong (64 PTEs / 8 words).
+	 */
+.Louter_avx2:
+	xorq	%r8, %r8		/* accumulator A = 0                */
+	xorq	%r9, %r9		/* accumulator B = 0 (split chain)  */
+	xorq	%rcx, %rcx		/* bit-position = 0 (cl = shift cnt)*/
+	movl	$8, %r10d		/* inner counter: 8 x 2 unrolled    */
+
+	/*
+	 * Inner loop: one iteration processes 4 PTEs => 4 result bits.
+	 *
+	 * Each PTE is 8 bytes; 4 PTEs = 32 bytes = one 256-bit YMM load.
+	 * rdi advances by 32 bytes per inner iteration.
+	 */
+.Linner_avx2:
+	/*
+	 * DUAL-LOAD: both 4-PTE loads (ymm1, ymm2) up front for memory-level
+	 * parallelism, then shift+extract both, then merge A->r8 / B->r9.
+	 */
+	vmovdqu	0(%rdi), %ymm1		/* block A: { pte3..pte0 } */
+	vmovdqu	32(%rdi), %ymm2		/* block B: { pte7..pte4 } */
+	addq	$64, %rdi
+
+	/*
+	 * Shift each 64-bit PTE lane left by 58 so the young bit (bit 5 =
+	 * _PAGE_ACCESSED) lands in the sign bit (bit 63).  VMOVMSKPD reads
+	 * only bit 63 of each lane, so this single op replaces VPAND +
+	 * VPCMPEQQ and the broadcast mask entirely.  No PFN false positive
+	 * is possible: only the original bit 5 can reach bit 63 (every other
+	 * bit shifts past it or stays below it).
+	 */
+	vpsllq	$58, %ymm1, %ymm1	/* block A: bit5 -> bit63          */
+	vpsllq	$58, %ymm2, %ymm2	/* block B: bit5 -> bit63          */
+
+	/*
+	 * VMOVMSKPD: extract the sign bit (bit 63) of each of the 4 packed
+	 * doubles (64-bit lanes) into eax[3:0] -- exactly one result bit per
+	 * PTE.  VPCMPEQQ set each young lane to all-ones (sign bit 1) and
+	 * each non-young lane to all-zeros (sign bit 0), so eax[3:0] is the
+	 * 4-bit young bitmap directly (bit i = PTE i young).  Writing eax
+	 * (32-bit form) zero-extends, so rax = 0..0 | 4 bits.
+	 *
+	 * This mirrors the AVX-512 kernel's vptestmq -> kmovw(k1) -> eax: one
+	 * mask extract per SIMD step then a single variable shift.  The old
+	 * byte-granular vpmovmskb forced four per-PTE test/setnz/push-pop/
+	 * shift sequences (512 per call); that scalar tail dominated runtime
+	 * and left this kernel slower than the narrower SSE2 path even though
+	 * its vector compare is cheaper.
+	 */
+	vmovmskpd %ymm1, %eax		/* eax[3:0] = 4 young bits, one/PTE  */
+
+	/*
+	 * Place the 4-bit group at bit-position rcx (0, 4, 8, ..., 60) in the
+	 * 64-bit accumulator.  The bit-position lives in rcx precisely so cl
+	 * is already the shift count: a single shlq %cl with no register move
+	 * and no push/pop-around-shlq (the inner counter lives in r10).  Then
+	 * advance the bit-position by the 4 PTEs consumed this iteration.
+	 */
+	shlq	%cl, %rax		/* rax <<= bit-position              */
+	orq	%rax, %r8		/* block A -> accumulator A           */
+	addq	$4, %rcx		/* advance bit-position by 4 PTEs    */
+
+	/*
+	 * Block B: a second 4-PTE block into a SEPARATE ulong (r9) so its
+	 * shift+OR carry chain is independent of block A's. Block B lands at
+	 * bit-positions 4,12,...,60 (A at 0,8,...,56); disjoint, so r8|r9
+	 * after the loop is the full 64-bit ulong.
+	 */
+	vmovmskpd %ymm2, %eax		/* block B mask (loaded up front)     */
+	shlq	%cl, %rax
+	orq	%rax, %r9		/* block B -> accumulator B           */
+	addq	$4, %rcx
+
+	decl	%r10d
+	jnz	.Linner_avx2
+
+	/* Combine the two split accumulators, then store the ulong. */
+	orq	%r9, %r8
+	movq	%r8, (%r11)
+	addq	$8, %r11		/* advance bitmap write pointer     */
+
+	decl	%edx
+	jnz	.Louter_avx2
+
+	/* Clear upper YMM halves to avoid SSE/AVX transition penalties. */
+	vzeroupper
+	RET
+SYM_FUNC_END(lru_cast_simd_scan_avx2)
diff --git a/mm/lru_cast/walk/simd_x86_avx512.S b/mm/lru_cast/walk/simd_x86_avx512.S
new file mode 100644
index 0000000000..e09a90e1c9
--- /dev/null
+++ b/mm/lru_cast/walk/simd_x86_avx512.S
@@ -0,0 +1,220 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * mm/lru_cast/simd_x86_avx512.S -- AVX-512F PTE young-bit scan for the CAST walker.
+ *
+ * Processes 512 PTEs (one full PMD page table) per call, producing an
+ * 8-ulong (512-bit) young-bit bitmap.  8 PTEs are handled per SIMD
+ * iteration via a single 512-bit ZMM load and VPTESTMQ; 8 iterations
+ * fill one output ulong; 8 ulongs total.
+ *
+ * Variant chosen: counter-based rolled loop (outer=8, inner=8).
+ * Reason: mirrors the SSE2 and AVX2 kernel structure for auditability;
+ * a fully-unrolled variant of 64 SIMD blocks would be ~320 instructions
+ * but harder to review and provides no measurable throughput gain on
+ * modern out-of-order cores (loop overhead is < 1% of SIMD work).
+ *
+ * Why AVX-512F is the most efficient of the three .S kernels:
+ *   VPTESTMQ ANDs two ZMM registers and writes an 8-bit opmask register
+ *   (one bit per 64-bit lane = one bit per PTE), directly encoding eight
+ *   young-bit results in a single instruction.  KMOVW transfers the opmask
+ *   into a general-purpose register.  This eliminates the PMOVMSKB +
+ *   test/setnz dance that SSE2 and AVX2 require.
+ *
+ *   ~5 instructions per 8 PTEs vs ~24 instructions per 4 PTEs (SSE2/AVX2).
+ *   Per-PMD scan is approximately 10 ns of compute on a modern core.
+ *
+ * KMOVW vs KMOVB:
+ *   KMOVW (move 16-bit opmask to/from GPR) is part of AVX-512F.
+ *   KMOVB requires AVX-512BW.  VPTESTMQ on an 8-lane ZMM only sets
+ *   k1[7:0]; the upper 8 bits written by KMOVW are zero, so KMOVW
+ *   gives the correct 8-bit result.  All instructions in this file are
+ *   strictly AVX-512F (Foundation); no BW/DQ/VL/VBMI sub-extensions.
+ *
+ * Caller (lru_cast_young_pte_mask() in mm/lru_cast/simd_x86.c)
+ * holds kernel_fpu_begin/end around this.
+ * from C without an FPU context bracket.
+ *
+ * ABI (System V AMD64):
+ *   rdi = const pte_t *pte_table  (512 PTEs, 4096 bytes, page-table base)
+ *   rsi = unsigned long *bitmap   (8 ulongs = 64 bytes, caller pre-cleared)
+ *
+ * Register usage:
+ *   zmm0  = young-bit mask broadcast (0x20 x8, 64-bit lanes), constant
+ *   zmm1  = 8-PTE scratch register
+ *   k1    = VPTESTMQ result (8-bit opmask, one bit per PTE)
+ *   rdi   = current PTE pointer (walks forward by 64 bytes per inner iter)
+ *   rsi   = bitmap base (constant)
+ *   rdx   = outer loop counter (8 -> 0)
+ *   rcx   = bit-position counter within current ulong (0, 8, 16, ..., 56);
+ *           cl is directly the shlq shift count, so no register move and no
+ *           push/pop-around-shlq are needed
+ *   rax   = kmovw result / shift scratch
+ *   r8    = per-ulong accumulator
+ *   r10   = inner loop counter (8 -> 0)
+ *   r11   = bitmap write pointer (rsi + outer*8, updated each outer iter)
+ *
+ * Opmask register constraints:
+ *   k0 is reserved as the "no mask" predicate (all lanes active); do not
+ *   use k0 as an output register.  k1..k7 are used here (k1 only).
+ *
+ * AVX-512F only (strict Foundation subset):
+ *   vmovdqa64 (mask), vmovdqu64 (PTE data), vptestmq, kmovw, vzeroupper -- all AVX-512F.
+ *   zmm0..zmm7 only; k1 only.
+ *   VZEROUPPER before RET to avoid SSE/AVX transition penalties.
+ */
+
+#include <linux/linkage.h>
+#include <linux/cfi_types.h>
+
+	/* -------------------------------------------------------------- */
+	/* Read-only data: young-bit mask broadcast                        */
+	/* -------------------------------------------------------------- */
+	.section .rodata
+	.align 64
+lru_cast_avx512_young_mask:
+	/* _PAGE_ACCESSED = bit 5 = 0x20, broadcast to 8x 64-bit lanes */
+	.quad 0x0000000000000020
+	.quad 0x0000000000000020
+	.quad 0x0000000000000020
+	.quad 0x0000000000000020
+	.quad 0x0000000000000020
+	.quad 0x0000000000000020
+	.quad 0x0000000000000020
+	.quad 0x0000000000000020
+
+	/* -------------------------------------------------------------- */
+	/* Text                                                            */
+	/* -------------------------------------------------------------- */
+	.text
+
+/*
+ * void lru_cast_simd_scan_avx512(const pte_t *pte_table, unsigned long *bitmap)
+ *
+ * pte_table: rdi -- 512 PTEs (4096 bytes), page-table base; page-aligned by
+ *                   the kernel page-table allocator; vmovdqu64 is used so no
+ *                   stricter SIMD alignment is required for the input
+ * bitmap:    rsi -- 8 ulongs (64 bytes), caller pre-cleared
+ */
+SYM_TYPED_FUNC_START(lru_cast_simd_scan_avx512)
+
+	/* Load young-bit mask once; zmm0 is constant for the whole call. */
+	vmovdqa64	lru_cast_avx512_young_mask(%rip), %zmm0
+
+	movq	%rsi, %r11		/* r11 = current bitmap word ptr    */
+	movl	$8, %edx		/* outer counter: 8 ulongs          */
+
+	/*
+	 * Outer loop: one iteration per output ulong (64 PTEs / 8 words).
+	 *
+	 * Each outer iteration processes 64 PTEs in 8 inner SIMD steps
+	 * (8 PTEs per step) and writes one 64-bit ulong to the bitmap.
+	 */
+.Louter_avx512:
+	xorq	%r8, %r8		/* accumulator A = 0                */
+	xorq	%r9, %r9		/* accumulator B = 0 (split chain)  */
+	xorq	%rcx, %rcx		/* bit-position = 0 (cl = shift cnt)*/
+	movl	$4, %r10d		/* inner counter: 4 x 2 unrolled    */
+
+	/*
+	 * Inner loop: one iteration processes 8 PTEs => 8 result bits.
+	 *
+	 * Each PTE is 8 bytes; 8 PTEs = 64 bytes = one 512-bit ZMM load.
+	 * rdi advances by 64 bytes per inner iteration.
+	 *
+	 * Algorithm per iteration:
+	 *   1. vmovdqu64 loads 8 PTEs into zmm1 (unaligned; page tables are
+	 *      page-aligned but rdi is the base of the 512-PTE array which
+	 *      is always 8-byte aligned, not necessarily 64-byte aligned).
+	 *   2. vptestmq ANDs zmm1 with zmm0 (mask) and sets k1[i] = 1 iff
+	 *      the masked value in lane i is nonzero (i.e. young bit set).
+	 *   3. kmovw extracts the 8-bit opmask from k1 into eax[7:0].
+	 *   4. Zero-extend al -> rax (upper bits already zero from kmovw).
+	 *   5. Shift rax left by r9 (0, 8, 16, ..., 56) to place the 8 bits
+	 *      at the correct position in the 64-bit accumulator.
+	 *   6. OR into r8 accumulator; advance bit-position by 8.
+	 *
+	 * The variable-shift idiom (shlq %cl, rax) requires the shift count
+	 * in cl, so the bit-position is kept in rcx directly and the inner
+	 * loop counter lives in r10 -- no push/pop-around-shlq is needed.
+	 */
+.Linner_avx512:
+	/*
+	 * DUAL-LOAD: issue both 8-PTE loads (zmm1, zmm2) up front so the two
+	 * cache misses are in flight together (memory-level parallelism) --
+	 * then test both, then merge A->r8 / B->r9 (split accumulators).
+	 */
+	vmovdqu64	0(%rdi), %zmm1		/* block A: pte[7]..pte[0]      */
+	vmovdqu64	64(%rdi), %zmm2		/* block B: pte[15]..pte[8]    */
+	addq	$128, %rdi
+
+	/*
+	 * VPTESTMQ: for each 64-bit lane i, compute:
+	 *   k1[i] = (zmm1[i] & zmm0[i]) != 0 ? 1 : 0
+	 *
+	 * zmm0 holds 0x20 in all lanes.  A PTE with _PAGE_ACCESSED set has
+	 * bit 5 = 1, so the AND is nonzero => k1[i] = 1.
+	 * The 8-bit opmask k1 encodes young status for all 8 PTEs directly.
+	 *
+	 * No PSHUFD trick or PCMPEQD needed: the opmask result is exact.
+	 * No false positives from PFN high bits: VPTESTMQ tests for ANY
+	 * nonzero bit after AND with the narrow mask, but since the mask is
+	 * exactly 0x20 (single bit), the result is correct for any PFN.
+	 */
+	vptestmq	%zmm1, %zmm0, %k1	/* block A young mask -> k1     */
+	vptestmq	%zmm2, %zmm0, %k2	/* block B young mask -> k2     */
+
+	/*
+	 * KMOVW: move the 16-bit opmask register k1 to eax.
+	 * VPTESTMQ on an 8-lane ZMM only sets k1[7:0]; k1[15:8] is zero.
+	 * So eax[7:0] = 8-bit young bitmap; eax[31:8] = 0 (zero-extended).
+	 * rax[63:32] is also zero because movl/kmovw zero-extends to 64 bits.
+	 *
+	 * KMOVW is in AVX-512F.  KMOVB requires AVX-512BW -- not used here.
+	 */
+	kmovw	%k1, %eax			/* eax[7:0] = 8-bit young mask  */
+
+	/*
+	 * Shift the 8-bit result to the correct position in the accumulator.
+	 * rcx = 0 for the first inner iter, 8 for the second, ..., 56 for
+	 * the eighth.  After shifting, rax holds the 8 result bits at their
+	 * correct positions within the 64-bit ulong.
+	 *
+	 * The bit-position lives in rcx so cl is already the shift count: a
+	 * single shlq %cl with no register move and no push/pop-around-shlq
+	 * (the inner counter lives in r10).
+	 */
+	shlq	%cl, %rax			/* rax <<= bit-position          */
+	orq	%rax, %r8			/* block A -> accumulator A       */
+	addq	$8, %rcx			/* advance bit-position by 8     */
+
+	/*
+	 * Block B: a second 8-PTE block, accumulated into a SEPARATE ulong
+	 * (r9) so its shift+OR carry chain is independent of block A's -- two
+	 * 4-deep chains in parallel instead of one 8-deep serial chain into
+	 * r8. Block B lands at bit-positions 8,24,40,56 (A at 0,16,32,48);
+	 * disjoint, so r8|r9 after the loop is the full 64-bit ulong.
+	 */
+	kmovw	%k2, %eax			/* block B mask (loaded up front) */
+	shlq	%cl, %rax
+	orq	%rax, %r9			/* block B -> accumulator B       */
+	addq	$8, %rcx
+
+	decl	%r10d
+	jnz	.Linner_avx512
+
+	/* Combine the two split accumulators, then store the ulong. */
+	orq	%r9, %r8
+	movq	%r8, (%r11)
+	addq	$8, %r11		/* advance bitmap write pointer     */
+
+	decl	%edx
+	jnz	.Louter_avx512
+
+	/*
+	 * VZEROUPPER: clear the upper halves of all YMM/ZMM registers to
+	 * avoid SSE/AVX transition penalties in subsequent legacy SSE code.
+	 * Required whenever AVX or AVX-512 code may be followed by SSE code.
+	 */
+	vzeroupper
+	RET
+SYM_FUNC_END(lru_cast_simd_scan_avx512)
diff --git a/mm/lru_cast/walk/simd_x86_sse2.S b/mm/lru_cast/walk/simd_x86_sse2.S
new file mode 100644
index 0000000000..01a84569f4
--- /dev/null
+++ b/mm/lru_cast/walk/simd_x86_sse2.S
@@ -0,0 +1,158 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * mm/lru_cast/simd_x86_sse2.S -- SSE2 PTE young-bit scan for the CAST walker.
+ *
+ * Processes 512 PTEs (one full PMD page table) per call, producing an
+ * 8-ulong (512-bit) young-bit bitmap.  4 PTEs are handled per SIMD
+ * iteration; 16 iterations fill one output ulong; 8 ulongs total.
+ *
+ * Variant chosen: counter-based rolled loop (outer=8, inner=16).
+ * Reason: keeps the file ~130 lines and fully auditable for SSE2
+ * compliance; a fully-unrolled variant would be ~3000 instructions and
+ * harder to review without meaningfully faster throughput on modern OOO
+ * cores (loop overhead is < 1% of SIMD work).
+ *
+ * Caller (lru_cast_young_pte_mask() in mm/lru_cast/simd_x86.c)
+ * holds kernel_fpu_begin/end around this.
+ * from C without an FPU context bracket.
+ *
+ * ABI (System V AMD64):
+ *   rdi = const pte_t *pte_table  (512 PTEs, 4096 bytes, page-table base;
+ *                                  page-aligned by the kernel page-table
+ *                                  allocator; movdqu is used so no stricter
+ *                                  SIMD alignment is required for the input)
+ *   rsi = unsigned long *bitmap   (8 ulongs = 64 bytes, caller pre-cleared)
+ *
+ * Register usage:
+ *   xmm1  = PTE pair 0-1 scratch (no mask-constant register needed)
+ *   xmm2  = PTE pair 2-3 scratch
+ *   rdi   = current PTE pointer (walks forward)
+ *   rsi   = bitmap base (constant)
+ *   rdx   = outer loop counter (8 -> 0)
+ *   rcx   = bit-position counter within current ulong (steps of 4, 0..60);
+ *           cl is directly the shlq shift count, so no register move and no
+ *           push/pop-around-shlq are needed
+ *   rax   = movmskps result (4-bit young mask) / shift scratch
+ *   r8    = per-ulong accumulator
+ *   r10   = inner loop counter (16 -> 0)
+ *   r11   = bitmap write pointer (rsi + outer*8, updated each outer iter)
+ *
+ * SSE2 only (x86-64 ABI baseline since AMD Opteron 2003):
+ *   movdqu, pslld -- all SSE2; shufps and movmskps are SSE1 (also
+ *   x86-64 baseline).  No SSE3, SSSE3, SSE4.x, AVX, BMI1/BMI2
+ *   instructions used.
+ *
+ * SHUFPS low-dword packing: the high 32 bits of an x86-64 PTE carry
+ * PFN bits 32-51, pkey, and NX.  Working the young bit at dword
+ * granularity, SHUFPS with imm8=0x88 gathers only the low dword of all
+ * four 64-bit PTE lanes into one register (a single instruction, vs the
+ * former pshufd x2 + punpcklqdq) so the high-dword PFN bits cannot reach
+ * the young-bit position.  The packing is required because the SSE2 path
+ * shifts at dword granularity (pslld); the AVX2 kernel shifts whole
+ * 64-bit lanes (vpsllq) and needs no packing.
+ */
+
+#include <linux/linkage.h>
+#include <linux/cfi_types.h>
+
+	/* -------------------------------------------------------------- */
+	/* Text  (no rodata: the young bit is shifted into the sign bit,  */
+	/*        so there is no broadcast mask constant)                  */
+	/* -------------------------------------------------------------- */
+	.text
+
+/*
+ * void lru_cast_simd_scan_sse2(const pte_t *pte_table, unsigned long *bitmap)
+ *
+ * pte_table: rdi -- 512 PTEs (4096 bytes), page-table base (8-byte aligned)
+ * bitmap:    rsi -- 8 ulongs (64 bytes), caller pre-cleared
+ */
+SYM_TYPED_FUNC_START(lru_cast_simd_scan_sse2)
+
+	movq	%rsi, %r11		/* r11 = current bitmap word ptr    */
+	movl	$8, %edx		/* outer counter: 8 ulongs          */
+
+	/*
+	 * Outer loop: one iteration per output ulong (64 PTEs / 8 words).
+	 */
+.Louter:
+	xorq	%r8, %r8		/* accumulator = 0                  */
+	xorq	%rcx, %rcx		/* bit-position = 0 (cl = shift cnt)*/
+	movl	$16, %r10d		/* inner counter: 16 SIMD iters     */
+
+	/*
+	 * Inner loop: one iteration processes 4 PTEs => 4 result bits.
+	 *
+	 * Each PTE is 8 bytes; 4 PTEs = 32 bytes = 2 x 16-byte XMM loads.
+	 * rdi advances by 32 bytes per inner iteration.
+	 */
+.Linner:
+	/* Load PTE[0..1] and PTE[2..3] (unaligned; 8-byte align guaranteed). */
+	movdqu	(%rdi), %xmm1		/* xmm1 = { pte1_hi:pte1_lo | pte0_hi:pte0_lo } */
+	movdqu	16(%rdi), %xmm2		/* xmm2 = { pte3_hi:pte3_lo | pte2_hi:pte2_lo } */
+	addq	$32, %rdi
+
+	/*
+	 * Pack the low 32-bit dword of each PTE into one XMM register with a
+	 * single SHUFPS (SSE1).  shufps imm8=0x88 = 0b_10_00_10_00 takes the
+	 * result's low two dwords from the destination (xmm1) and the high
+	 * two from the source (xmm2):
+	 *   dst[0] = xmm1[0] = lo0    (imm[1:0] = 0)
+	 *   dst[1] = xmm1[2] = lo1    (imm[3:2] = 2)
+	 *   dst[2] = xmm2[0] = lo2    (imm[5:4] = 0)
+	 *   dst[3] = xmm2[2] = lo3    (imm[7:6] = 2)
+	 * => xmm1 = { lo3 | lo2 | lo1 | lo0 }
+	 *
+	 * Identical dword layout to the former pshufd x2 + punpcklqdq (3
+	 * instructions), folded into one.
+	 */
+	shufps	$0x88, %xmm2, %xmm1	/* xmm1 = { lo3, lo2, lo1, lo0 }   */
+
+	/*
+	 * Shift each dword left by 26 so the young bit (bit 5) lands in the
+	 * sign bit (bit 31).  MOVMSKPS reads only bit 31 of each dword, so
+	 * this single op replaces PAND + PCMPEQD and the broadcast mask.
+	 * The packed lanes are PTE low dwords, so only the original bit 5
+	 * reaches bit 31.
+	 */
+	pslld	$26, %xmm1		/* bit5 -> bit31 (sign) per dword   */
+
+	/*
+	 * MOVMSKPS: extract the sign bit (bit 31) of each of the 4 packed
+	 * singles (32-bit lanes) into eax[3:0] -- exactly one result bit per
+	 * PTE.  PSLLD put PTE i's young bit in dword i's sign bit, so eax[3:0]
+	 * is the 4-bit young bitmap directly (bit i = PTE i young).  Writing
+	 * eax (32-bit form) zero-extends, so rax = 0..0 | 4 bits.
+	 *
+	 * MOVMSKPS is SSE1 (x86-64 baseline) -- even more basic than the
+	 * SSE2 PMOVMSKB it replaces.  Mirrors the AVX2 kernel's vmovmskpd:
+	 * one mask extract per SIMD step then a single variable shift,
+	 * instead of the byte-granular PMOVMSKB + four per-PTE
+	 * test/setnz/push-pop/shift sequences (512 per call) whose scalar
+	 * tail dominated this kernel's runtime.
+	 */
+	movmskps %xmm1, %eax		/* eax[3:0] = 4 young bits, one/PTE  */
+
+	/*
+	 * Place the 4-bit group at bit-position rcx (0, 4, 8, ..., 60) in the
+	 * 64-bit accumulator.  The bit-position lives in rcx precisely so cl
+	 * is already the shift count: a single shlq %cl with no register move
+	 * and no push/pop-around-shlq (the inner counter lives in r10).  Then
+	 * advance the bit-position by the 4 PTEs consumed this iteration.
+	 */
+	shlq	%cl, %rax		/* rax <<= bit-position (0..60)      */
+	orq	%rax, %r8		/* accumulate into output ulong      */
+	addq	$4, %rcx		/* advance bit-position by 4 PTEs    */
+
+	decl	%r10d
+	jnz	.Linner
+
+	/* Store the completed ulong into bitmap. */
+	movq	%r8, (%r11)
+	addq	$8, %r11		/* advance bitmap write pointer     */
+
+	decl	%edx
+	jnz	.Louter
+
+	RET
+SYM_FUNC_END(lru_cast_simd_scan_sse2)
diff --git a/mm/lru_cast/walk/walk.c b/mm/lru_cast/walk/walk.c
new file mode 100644
index 0000000000..3566d1c9ae
--- /dev/null
+++ b/mm/lru_cast/walk/walk.c
@@ -0,0 +1,307 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CAST -- the walker: reads of mapped pages, from the young bits.
+ *
+ * A read of a mapped page leaves only the PTE's young bit. Reclaim looks at
+ * it when it reaches the page, which for a page in use comes late: by then
+ * the page has had its key from reads long past. So once a tick of the
+ * clock (C/4 pages taken in; at most ten times a second) this walks
+ * the page tables of every process: a young PTE is cleared and counts one
+ * read of its folio -- one per folio per walk, however many times it was
+ * touched in between, which is what a young bit can tell. Once a tick, as
+ * a state word tells reads apart by tick: walked more often, the walker
+ * would add no time, only reads counted by how often it walked.
+ *
+ * A young bit is not free to take: cleared, it costs the task that next
+ * touches the page a few hundred ns while the CPU sets it again. So none is
+ * taken that would add nothing -- of a folio already read this tick
+ * (lru_cast_young_take()) -- and what cannot have been read since the last
+ * walk is not looked at: an mm no CPU has run since (lru_cast_used, set at a
+ * switch to it and at a tick in it), and the PTEs under a PMD nothing under
+ * which was reached. The CPU says so where it keeps an accessed bit in the
+ * PMD (arch_has_hw_nonleaf_pmd_young()), cleared here, under the PMD's lock
+ * and before its PTEs are read, when the walk covers the whole PMD. Where it
+ * does not, and in an mm with a secondary MMU (KVM), whose accesses do not
+ * walk these tables, the walker reads only the PMDs reclaim's look-around
+ * found young (bloom.c, lookaround.c), and asks the secondary MMU of each
+ * PTE (lru_cast_ptep_clear_young()). Otherwise a page table is read for its
+ * young bits at once (simd.h), and only the PTEs found young are looked at
+ * one by one.
+ *
+ * The first young bit after a folio entered the cache may be the fault
+ * that brought it, counted already: as at reclaim, it only clears the mark
+ * (lru_cast_access_seen()). While sampled pages are protected their reads
+ * reach the controllers as faults, so the walker's are the main cache's
+ * only (lru_cast_access_young()); a PTE protected for that is left to its
+ * fault.
+ *
+ * Executable file text is not walked: whether it stays is decided at
+ * reclaim by whether it is in use -- a young pte then -- not by its key
+ * (mm/vmscan.c), and a bit cleared here would be that sign gone.
+ *
+ * A process whose mmap lock is taken is skipped this time. PMD-mapped THPs
+ * are read at the PMD, not split; hugetlb and PFN maps are not walked.
+ */
+#include <linux/pagewalk.h>
+#include <linux/sched/mm.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/stat.h>
+#include <linux/sysfs.h>
+#include <linux/workqueue.h>
+#include <linux/jiffies.h>
+#include <linux/pgtable.h>
+#include <linux/mmu_notifier.h>
+#include "walk/walk.h"
+#include "walk/simd.h"
+#include "walk/young.h"
+
+static unsigned int lru_cast_walk_on = 1;
+static long lru_cast_walk_net, lru_cast_walk_next;		/* the clock, net, as told */
+static unsigned long lru_cast_walk_last;
+static atomic_long_t lru_cast_walk_walks, lru_cast_walk_young, lru_cast_walk_kept;
+static atomic_long_t lru_cast_walk_mms, lru_cast_walk_mms_idle;
+static atomic_long_t lru_cast_walk_tables, lru_cast_walk_tables_idle;
+static atomic64_t lru_cast_walk_ns;		/* time spent walking */
+
+static void lru_cast_walk_workfn(struct work_struct *work);
+static DECLARE_WORK(lru_cast_walk_work, lru_cast_walk_workfn);
+
+/*
+ * The young bit of @folio's PTE @pte, if it is the walker's to take: one
+ * read per folio per walk. @pmd for a PMD-mapped folio, under its lock.
+ */
+static void lru_cast_walk_take(struct vm_area_struct *vma, unsigned long addr, pte_t *pte,
+		    pmd_t *pmd, struct folio *folio, struct folio **last)
+{
+	if (folio == *last || !folio_test_lru(folio))
+		return;
+	if (!lru_cast_young_take(folio)) {
+		atomic_long_inc(&lru_cast_walk_kept);
+		return;
+	}
+	if (pte ? !lru_cast_ptep_clear_young(vma, addr, pte) :
+		  !lru_cast_pmdp_clear_young(vma, addr, pmd))
+		return;
+	*last = folio;
+	if (lru_cast_young_record(folio))
+		atomic_long_inc(&lru_cast_walk_young);
+}
+
+/* the hardware's own record of a PMD's use, where the CPU keeps it and nothing bypasses it */
+static bool lru_cast_walk_pmd_young_usable(struct mm_struct *mm)
+{
+	return arch_has_hw_nonleaf_pmd_young() && !mm_has_notifiers(mm);
+}
+
+static int lru_cast_walk_pmd(pmd_t *pmd, unsigned long addr, unsigned long next,
+		  struct mm_walk *walk)
+{
+	struct vm_area_struct *vma = walk->vma;
+	struct folio **last = walk->private;
+	spinlock_t *ptl;
+	pte_t *start, *pte;
+
+	bool notifiers = mm_has_notifiers(walk->mm);
+
+	walk->action = ACTION_CONTINUE;
+	ptl = pmd_trans_huge_lock(pmd, vma);
+	if (ptl) {
+		pmd_t val = pmdp_get(pmd);
+
+		if (pmd_present(val) && !pmd_protnone(val) && (pmd_young(val) || notifiers))
+			lru_cast_walk_take(vma, addr, NULL, pmd, pmd_folio(val), last);
+		spin_unlock(ptl);
+		return 0;
+	}
+
+	/*
+	 * Nothing under it reached since its accessed bit was cleared: the
+	 * hardware's word, or failing it the bloom's. The bit is cleared
+	 * only when the walk covers the whole PMD -- a PMD may span more
+	 * than one VMA, and the next would find it clear -- under its lock,
+	 * and before the PTEs are read, so that a use racing the walk sets
+	 * it again; a lock not got leaves it set, a table read once more.
+	 */
+	if (lru_cast_walk_pmd_young_usable(walk->mm)) {
+		pmd_t val = pmdp_get_lockless(pmd);
+
+		if (!pmd_present(val) || !pmd_young(val)) {
+			atomic_long_inc(&lru_cast_walk_tables_idle);
+			return 0;
+		}
+		if (next - addr == PMD_SIZE) {
+			ptl = pmd_lockptr(walk->mm, pmd);
+			if (spin_trylock(ptl)) {
+				if (pmd_present(*pmd) && !pmd_leaf(*pmd))
+					pmdp_test_and_clear_young(vma, addr, pmd);
+				spin_unlock(ptl);
+			}
+		}
+	} else if (!lru_cast_bloom_test(walk->mm, addr)) {
+		atomic_long_inc(&lru_cast_walk_tables_idle);
+		return 0;
+	}
+
+	start = pte_offset_map_lock(walk->mm, pmd, addr, &ptl);
+	if (!start)
+		return 0;
+	{
+		unsigned long young[LRU_CAST_PTE_LONGS] = { 0 };
+		unsigned int base = pte_index(addr), i = base;
+		unsigned int end = base + ((next - addr) >> PAGE_SHIFT);
+		unsigned int l3 = READ_ONCE(lru_cast_pf_l3), l1 = READ_ONCE(lru_cast_pf_l1);
+		unsigned int p3 = base, p1 = base, n;
+		pte_t *table = start - base;
+
+		atomic_long_inc(&lru_cast_walk_tables);
+		if (notifiers) {	/* the secondary MMU's uses set no bit here: ask of each */
+			bitmap_set(young, base, end - base);
+			l3 = 0;
+		} else {
+			lru_cast_young_pte_mask(table, young);
+		}
+		/*
+		 * The young frames read next pulled in: cursors l3 and l1 young
+		 * PTEs ahead of the one read, each pulling its frame toward L3
+		 * and L1 as it passes it.
+		 */
+		for (n = 0; n < l3 && (p3 = find_next_bit(young, end, p3)) < end; n++, p3++)
+			lru_cast_young_ahead(table + p3, false);
+		for (n = 0; n < l1 && (p1 = find_next_bit(young, end, p1)) < end; n++, p1++)
+			lru_cast_young_ahead(table + p1, true);
+		for_each_set_bit_from(i, young, end) {
+			unsigned long a = addr + ((unsigned long)(i - base) << PAGE_SHIFT);
+			pte_t val;
+			struct folio *folio;
+
+			if (l3 && (p3 = find_next_bit(young, end, p3)) < end)
+				lru_cast_young_ahead(table + p3++, false);
+			if (l3 && (p1 = find_next_bit(young, end, p1)) < end)
+				lru_cast_young_ahead(table + p1++, true);
+
+			pte = table + i;
+			val = ptep_get(pte);
+			if (!pte_present(val) || pte_protnone(val) || (!pte_young(val) && !notifiers))
+				continue;
+			folio = vm_normal_folio(vma, a, val);
+			if (folio)
+				lru_cast_walk_take(vma, a, pte, NULL, folio, last);
+		}
+	}
+	pte_unmap_unlock(start, ptl);
+	cond_resched();
+	return 0;
+}
+
+static int lru_cast_walk_test(unsigned long start, unsigned long end, struct mm_walk *walk)
+{
+	struct vm_area_struct *vma = walk->vma;
+
+	/* only what the LRU keeps: no hugetlb, no special mappings */
+	if (is_vm_hugetlb_page(vma) || (vma->vm_flags & (VM_PFNMAP | VM_MIXEDMAP | VM_IO)))
+		return 1;
+	/* program text: kept while in use, which its young bits tell reclaim */
+	if ((vma->vm_flags & VM_EXEC) && vma->vm_file)
+		return 1;
+	return 0;
+}
+
+static const struct mm_walk_ops lru_cast_walk_ops = {
+	.pmd_entry = lru_cast_walk_pmd,
+	.test_walk = lru_cast_walk_test,
+	.walk_lock = PGWALK_RDLOCK,
+};
+
+static void lru_cast_walk_mm(struct mm_struct *mm)
+{
+	struct folio *last = NULL;
+
+	atomic_long_inc(&lru_cast_walk_mms);
+	/* no CPU has run it since the last walk: no young bit can be new */
+	if (!xchg(&mm->lru_cast_used, 0)) {
+		atomic_long_inc(&lru_cast_walk_mms_idle);
+		return;
+	}
+	if (!mmap_read_trylock(mm)) {
+		WRITE_ONCE(mm->lru_cast_used, 1);	/* not walked: the next walk does */
+		return;
+	}
+	walk_page_range(mm, 0, TASK_SIZE, &lru_cast_walk_ops, &last);
+	mmap_read_unlock(mm);
+}
+
+static void lru_cast_walk_workfn(struct work_struct *work)
+{
+	struct task_struct *p;
+	struct mm_struct **mms;
+	int n = 0, max = nr_processes() + 64, i;
+	u64 t0 = ktime_get_ns();
+
+	mms = kvmalloc_array(max, sizeof(*mms), GFP_KERNEL);
+	if (!mms)
+		return;
+	rcu_read_lock();
+	for_each_process(p) {
+		struct mm_struct *mm;
+
+		if (n >= max)
+			break;
+		if (p->flags & PF_KTHREAD)
+			continue;
+		mm = get_task_mm(p);
+		if (mm)
+			mms[n++] = mm;
+	}
+	rcu_read_unlock();
+
+	for (i = 0; i < n; i++) {
+		if (lru_cast_enabled())
+			lru_cast_walk_mm(mms[i]);
+		mmput(mms[i]);
+		cond_resched();
+	}
+	kvfree(mms);
+	lru_cast_bloom_swap();
+	atomic_long_inc(&lru_cast_walk_walks);
+	atomic64_add(ktime_get_ns() - t0, &lru_cast_walk_ns);
+}
+
+/* the clock moved by @nr pages taken in, of @size: a tick on, walk */
+void lru_cast_walk_installed(long nr, unsigned long size)
+{
+	if (!READ_ONCE(lru_cast_walk_on))
+		return;
+	data_race(lru_cast_walk_net += nr);
+	if (data_race(lru_cast_walk_net) < data_race(lru_cast_walk_next))
+		return;
+	data_race(lru_cast_walk_next = lru_cast_walk_net + (long)max(size / 4, 1024UL));
+	if (time_before(jiffies, data_race(lru_cast_walk_last) + HZ / 10))
+		return;
+	data_race(lru_cast_walk_last = jiffies);
+	lru_cast_queue_work(&lru_cast_walk_work);
+}
+
+bool lru_cast_walk_enabled(void)
+{
+	return READ_ONCE(lru_cast_walk_on);
+}
+
+void lru_cast_walk_enable(bool on)
+{
+	WRITE_ONCE(lru_cast_walk_on, on);
+}
+
+int lru_cast_walk_show(char *buf, int len)
+{
+	return len + sysfs_emit_at(buf, len,
+				   "walker walks %ld us %llu young %ld kept %ld mms %ld idle %ld tables %ld idle %ld scan %s\n",
+				   atomic_long_read(&lru_cast_walk_walks),
+				   atomic64_read(&lru_cast_walk_ns) / 1000,
+				   atomic_long_read(&lru_cast_walk_young),
+				   atomic_long_read(&lru_cast_walk_kept),
+				   atomic_long_read(&lru_cast_walk_mms),
+				   atomic_long_read(&lru_cast_walk_mms_idle),
+				   atomic_long_read(&lru_cast_walk_tables),
+				   atomic_long_read(&lru_cast_walk_tables_idle),
+				   lru_cast_simd_name());
+}
diff --git a/mm/lru_cast/walk/walk.h b/mm/lru_cast/walk/walk.h
new file mode 100644
index 0000000000..8b3635caac
--- /dev/null
+++ b/mm/lru_cast/walk/walk.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST -- the walker: reads of mapped pages, from their young bits.
+ *
+ *   walk.c        once a tick, the page tables of every process that ran
+ *   lookaround.c  reclaim's references check, and the PTEs around it
+ *   bloom.c       the PMDs the look-around found young, for the walker
+ *   simd*         a page table's young bits at once (simd.h, inside walk/)
+ *
+ * Built on core/ alone: a young bit is recorded as a read of its folio.
+ */
+#ifndef _MM_LRU_CAST_WALK_H
+#define _MM_LRU_CAST_WALK_H
+
+#include "core/core.h"
+
+void lru_cast_walk_installed(long nr, unsigned long size);
+bool lru_cast_walk_enabled(void);
+void lru_cast_walk_enable(bool on);
+int lru_cast_walk_show(char *buf, int len);
+int lru_cast_look_around_show(char *buf, int len);
+
+/* the young-bit scan: SIMD where there is a kernel for the CPU */
+bool lru_cast_simd_enabled(void);
+int lru_cast_simd_enable(bool on);			/* -EINVAL: no SIMD kernel here */
+const char *lru_cast_simd_name(void);
+
+#endif /* _MM_LRU_CAST_WALK_H */
diff --git a/mm/lru_cast/walk/young.h b/mm/lru_cast/walk/young.h
new file mode 100644
index 0000000000..63314ed39b
--- /dev/null
+++ b/mm/lru_cast/walk/young.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CAST -- what the walker and the look-around share, inside walk/:
+ * whether a young bit is theirs to take, how a taken one is recorded, and
+ * the bloom of PMDs reclaim found young (bloom.c).
+ */
+#ifndef _MM_LRU_CAST_WALK_YOUNG_H
+#define _MM_LRU_CAST_WALK_YOUNG_H
+
+#include "core/core.h"
+
+/*
+ * May @folio's young bit be taken -- cleared and recorded? Not when its
+ * last read is stamped with the current tick: a state word tells reads
+ * apart by tick, so recording another now adds nothing, and the bit is
+ * left for reclaim's references check, which needs it. Clearing it would
+ * cost the task its next access to the page, where the CPU sets the bit
+ * again (some hundred ns a page), for nothing.
+ */
+static inline bool lru_cast_young_take(struct folio *folio)
+{
+	u32 w = lru_cast_read(folio);
+
+	return !(w >> 24) ||
+	       lru_cast_age(w, lru_cast_tick(folio_pgdat(folio), folio_is_file_lru(folio)));
+}
+
+/*
+ * A young bit taken from @folio. The first after the folio entered the
+ * cache may be the fault that brought it, counted already: it only clears
+ * the mark (lru_cast_access_seen()). False if nothing was recorded.
+ */
+static inline bool lru_cast_young_record(struct folio *folio)
+{
+	if (folio_test_clear_referenced(folio))
+		return false;
+	lru_cast_access_young(folio);
+	return true;
+}
+
+/*
+ * The frame of the PTE @pte, if it is young, pulled toward L1 (@l1) or L3
+ * (core/prefetch.h): it is one the loop will record a read of soon.
+ */
+static inline void lru_cast_young_ahead(pte_t *pte, bool l1)
+{
+	pte_t val = ptep_get(pte);
+
+	if (pte_present(val) && pte_young(val))
+		lru_cast_prefetch_frame(pte_pfn(val), l1);
+}
+
+/* bloom.c */
+void lru_cast_bloom_set(struct mm_struct *mm, unsigned long addr);
+bool lru_cast_bloom_test(struct mm_struct *mm, unsigned long addr);
+void lru_cast_bloom_swap(void);
+
+#endif /* _MM_LRU_CAST_WALK_YOUNG_H */
diff --git a/mm/memcontrol.c b/mm/memcontrol.c
index 856a7d0758..4fef47475d 100644
--- a/mm/memcontrol.c
+++ b/mm/memcontrol.c
@@ -4083,6 +4083,7 @@ static void free_mem_cgroup_per_node_info(struct mem_cgroup_per_node *pn)
 	if (!pn)
 		return;
 
+	lru_cast_exit_lruvec(&pn->lruvec);
 	free_percpu(pn->lruvec_stats_percpu);
 	kfree(pn->lruvec_stats);
 	kfree(pn);
diff --git a/mm/memory.c b/mm/memory.c
index 8b0c2c735d..e393ca53ed 100644
--- a/mm/memory.c
+++ b/mm/memory.c
@@ -42,6 +42,7 @@
 #include <linux/kernel_stat.h>
 #include <linux/mm.h>
 #include <linux/mm_inline.h>
+#include <linux/lru_cast.h>
 #include <linux/sched/mm.h>
 #include <linux/sched/numa_balancing.h>
 #include <linux/sched/task.h>
@@ -4962,6 +4963,8 @@ vm_fault_t do_swap_page(struct vm_fault *vmf)
 	if (folio)
 		swap_update_readahead(folio, vma, vmf->address);
