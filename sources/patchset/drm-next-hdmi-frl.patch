+				     param->cascaded_id);
+	if (param->aux_fails)
+		dm_mst_test_dsc_aux_fail = port->mgr->aux;
+
+	KUNIT_EXPECT_EQ(test, is_synaptics_cascaded_panamera(link, port), param->cascaded);
+}
