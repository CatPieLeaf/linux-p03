index 000000000000..6bb8bc1b52a9
--- /dev/null
+++ b/drivers/gpu/drm/amd/ras/ras_mgr/amdgpu_ras_mce.c
@@ -0,0 +1,276 @@
+// SPDX-License-Identifier: MIT
+/*
