+	stream->ctx = dc->ctx;
+
+	if (tg) {
+		dc->current_state->res_ctx.pipe_ctx[0].stream = stream;
+		dc->current_state->res_ctx.pipe_ctx[0].stream_res.tg = tg;
+	}
