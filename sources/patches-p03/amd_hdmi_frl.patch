+static const struct hpo_hdmi_stream_encoder_funcs
+	dcn30_hpo_hdmi_stream_enc_funcs = {
+		.enable = dcn30_hpo_hdmi_stream_enc_enable,
+		.disable = dcn30_hpo_hdmi_stream_enc_disable,
