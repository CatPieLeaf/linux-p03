+static void dcn30_hpo_hdmi_stream_enc_hdmi_audio_disable(
+	struct hpo_hdmi_stream_encoder *enc)
+{
+	if (enc->afmt && enc->afmt->funcs->afmt_powerdown)
+		enc->afmt->funcs->afmt_powerdown(enc->afmt);
+}
